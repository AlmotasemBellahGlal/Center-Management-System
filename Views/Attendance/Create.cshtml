@model AttendanceFormVM

@{
    ViewData["Title"] = "تسجيل الحضور - " + Model.GroupName;
    int presentCount = Model.Students.Count(s => s.IsPresent == true);
    int absentCount  = Model.Students.Count(s => s.IsPresent == false);
    int unmarkCount  = Model.Students.Count(s => s.IsPresent == null);
}

@* ── Header ── *@
<div class="att-header">
    <div class="att-header__top">
        <a href="@Url.Action("Groups", "Attendance")" class="btn btn--outline-primary btn--sm">
            <i class="fas fa-arrow-right"></i>
            رجوع
        </a>
        <div class="att-header__breadcrumb">
            <span>@Model.SubjectName</span>
            <i class="fas fa-chevron-left att-bc-sep"></i>
            <span>@Model.AcademicYearName</span>
            <i class="fas fa-chevron-left att-bc-sep"></i>
            <span class="att-bc-current">@Model.GroupName</span>
        </div>
    </div>

    <div class="att-header__main">
        <div class="att-header__icon">
            <i class="fas fa-clipboard-check"></i>
        </div>
        <div class="att-header__info">
            <h1 class="att-header__title">@Model.GroupName</h1>
            <div class="att-header__meta">
                <span><i class="fas fa-calendar-day"></i> @Model.Date.ToString("dd/MM/yyyy")</span>
            </div>
        </div>

        @* Date picker *@
        <form method="get" class="att-header__filters" id="dateForm">
            <input type="hidden" name="groupId" value="@Model.GroupId" />
            <div class="att-filter">
                <label class="att-filter__label"><i class="fas fa-calendar-alt"></i> تاريخ الحصة</label>
                <input type="date" name="date" class="form-input att-filter__input"
                       value="@Model.Date.ToString("yyyy-MM-dd")"
                       onchange="document.getElementById('dateForm').submit()" />
            </div>
        </form>
    </div>
</div>

@if (ViewBag.Message != null)
{
    <div class="card card--bordered" style="border-color: var(--warning-color); margin-bottom: var(--spacing);">
        <div class="card__body" style="display: flex; align-items: center; gap: var(--spacing-sm); color: var(--warning-color);">
            <i class="fas fa-exclamation-triangle"></i>
            <span>@ViewBag.Message</span>
        </div>
    </div>
}
else
{
    @* ── Stats ── *@
    <div class="att-stats">
        <div class="att-stat att-stat--present">
            <div class="att-stat__val" id="statPresent">@presentCount</div>
            <div class="att-stat__lbl"><i class="fas fa-user-check"></i> حضر</div>
        </div>
        <div class="att-stat att-stat--absent">
            <div class="att-stat__val" id="statAbsent">@absentCount</div>
            <div class="att-stat__lbl"><i class="fas fa-user-times"></i> غاب</div>
        </div>
        <div class="att-stat att-stat--unmark">
            <div class="att-stat__val" id="statUnmark">@unmarkCount</div>
            <div class="att-stat__lbl"><i class="fas fa-user-clock"></i> لم يُسجَّل</div>
        </div>
        <div class="att-stat att-stat--total">
            <div class="att-stat__val">@Model.Students.Count</div>
            <div class="att-stat__lbl"><i class="fas fa-users"></i> إجمالي</div>
        </div>
    </div>

    @* ── Toolbar ── *@
    <div class="att-toolbar">
        <div class="att-toolbar__left">
            <button class="btn btn--sm btn--success" onclick="bulkAttendance(true)">
                <i class="fas fa-check-double"></i> حضر الكل
            </button>
            <button class="btn btn--sm btn--danger" onclick="bulkAttendance(false)">
                <i class="fas fa-times"></i> غياب الكل
            </button>
        </div>
        <div class="att-toolbar__right">
            <span class="att-date-badge">
                <i class="fas fa-calendar"></i>
                @Model.Date.ToString("dd/MM/yyyy")
            </span>
        </div>
    </div>

    @* ── Student Grid ── *@
    @if (!Model.Students.Any())
    {
        <div class="card"><div class="card__body">
            <div class="empty-state">
                <div class="empty-state__icon"><i class="fas fa-users-slash fa-3x"></i></div>
                <h3 class="empty-state__title">لا يوجد طلاب نشطون</h3>
                <p class="empty-state__message">لا يوجد طلاب مسجلون بشكل نشط في هذه المجموعة</p>
            </div>
        </div></div>
    }
    else
    {
        <div class="att-grid" id="studentGrid">
            @{ int cardNum = 1; }
            @foreach (var student in Model.Students)
            {
                string attState = student.IsPresent == true ? "present"
                                : student.IsPresent == false ? "absent"
                                : "none";

                <div class="att-card @(attState == "none" ? "att-card--unset" : (attState == "present" ? "att-card--present" : "att-card--absent"))"
                     id="card-@student.StudentId"
                     data-student-id="@student.StudentId"
                     data-name="@student.FullName.ToLower()">

                    <div class="att-card__top">
                        <div class="att-card__num">@cardNum</div>
                        <div class="att-card__avatar att-avatar--@(attState == "present" ? "green" : attState == "absent" ? "red" : "gray")"
                             id="avatar-@student.StudentId">
                            @student.FullName[0]
                        </div>
                        <div class="att-card__info">
                            <div class="att-card__name">@student.FullName</div>
                            <div class="att-card__lbl" id="attLabel-@student.StudentId">
                                @if (attState == "present")
                                {
                                    <span class="att-badge att-badge--present"><i class="fas fa-check"></i> حضر</span>
                                }
                                else if (attState == "absent")
                                {
                                    <span class="att-badge att-badge--absent"><i class="fas fa-times"></i> غاب</span>
                                }
                                else
                                {
                                    <span class="att-badge att-badge--none"><i class="fas fa-minus"></i> لم يُسجَّل</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="att-card__btns">
                        <button class="att-btn att-btn--present @(attState == "present" ? "active" : "")"
                                id="btnPresent-@student.StudentId"
                                onclick="setAttendance(@student.StudentId, true)"
                                title="حضر">
                            <i class="fas fa-user-check"></i>
                            <span>حضر</span>
                        </button>
                        <button class="att-btn att-btn--absent @(attState == "absent" ? "active" : "")"
                                id="btnAbsent-@student.StudentId"
                                onclick="setAttendance(@student.StudentId, false)"
                                title="غاب">
                            <i class="fas fa-user-times"></i>
                            <span>غاب</span>
                        </button>
                    </div>

                    <div class="att-card__overlay" id="overlay-@student.StudentId" style="display:none">
                        <i class="fas fa-spinner fa-spin"></i>
                    </div>
                </div>

                cardNum++;
            }
        </div>

        @* Search *@
        <div class="att-search-wrap">
            <i class="fas fa-search"></i>
            <input type="text" class="att-search-input" placeholder="ابحث عن طالب..."
                   oninput="filterCards(this.value)" />
        </div>
    }
}

<div id="attToastContainer" class="att-toast-container"></div>

@section Scripts {
<style>
/* ═══════════════════════════════════════════════════════
   Attendance Create — Scoped Styles
   ═══════════════════════════════════════════════════════ */
.att-header { margin-bottom: var(--spacing-lg); }
.att-header__top {
    display: flex; align-items: center; gap: var(--spacing-sm);
    margin-bottom: var(--spacing);
    flex-wrap: wrap;
}
.att-header__breadcrumb {
    display: flex; align-items: center; gap: 6px;
    font-size: var(--text-sm); color: var(--text-secondary);
}
.att-bc-sep { font-size: .6rem; color: var(--text-muted); }
.att-bc-current { color: var(--primary-color); font-weight: var(--font-semibold); }

.att-header__main {
    display: flex; align-items: flex-start; gap: var(--spacing);
    padding: var(--spacing-md);
    background: var(--success-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    color: #fff;
    flex-wrap: wrap;
}
.att-header__icon {
    width: 56px; height: 56px; flex-shrink: 0;
    border-radius: var(--radius-md);
    background: rgba(255,255,255,.18);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem;
}
.att-header__info { flex: 1; min-width: 160px; }
.att-header__title { font-size: var(--text-2xl); font-weight: var(--font-bold); margin: 0 0 4px; }
.att-header__meta { font-size: var(--text-sm); opacity: .9; }
.att-header__filters { display: flex; gap: var(--spacing); align-items: flex-end; margin-inline-start: auto; }
.att-filter { display: flex; flex-direction: column; gap: 4px; }
.att-filter__label { font-size: var(--text-xs); opacity: .85; }
.att-filter__input {
    background: rgba(255,255,255,.15); color: #fff; border: 1px solid rgba(255,255,255,.3);
    border-radius: var(--radius); padding: 6px 10px; font-size: var(--text-sm); min-width: 150px;
}
/* Stats */
.att-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing);
}
@@media (max-width: 600px) { .att-stats { grid-template-columns: repeat(2, 1fr); } }
.att-stat {
    border-radius: var(--radius-md); padding: var(--spacing-sm) var(--spacing);
    text-align: center; box-shadow: var(--shadow-sm); border: 2px solid transparent;
    transition: var(--transition);
}
.att-stat:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
.att-stat__val { font-size: var(--text-3xl); font-weight: var(--font-bold); line-height: 1; }
.att-stat__lbl { font-size: var(--text-xs); margin-top: 4px; opacity: .85; }
.att-stat--present { background: var(--success-light); color: var(--success-color); border-color: var(--success-color); }
.att-stat--absent  { background: var(--danger-light); color: var(--danger-color); border-color: var(--danger-color); }
.att-stat--unmark  { background: var(--gray-100); color: var(--text-secondary); border-color: var(--gray-300); }
.att-stat--total   { background: var(--primary-light); color: var(--primary-color); border-color: var(--primary-color); }
/* Toolbar */
.att-toolbar {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing);
    background: var(--bg-primary); border: 1px solid var(--border-color);
    border-radius: var(--radius-md); margin-bottom: var(--spacing);
    box-shadow: var(--shadow-sm);
}
.att-toolbar__left { display: flex; gap: var(--spacing-xs); flex-wrap: wrap; }
.att-date-badge {
    background: var(--primary-light); color: var(--primary-dark);
    padding: 4px 12px; border-radius: var(--radius-full);
    font-size: var(--text-sm); font-weight: var(--font-semibold);
    display: flex; align-items: center; gap: 6px;
}
/* Search */
.att-search-wrap {
    display: flex; align-items: center; gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing);
    background: var(--bg-primary); border: 1px solid var(--border-color);
    border-radius: var(--radius-md); margin-top: var(--spacing);
    box-shadow: var(--shadow-sm); color: var(--text-muted);
}
.att-search-input {
    flex: 1; border: none; outline: none; font-size: var(--text-base);
    background: transparent; color: var(--text-primary);
}
/* Grid */
.att-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--spacing);
}
@@media (max-width: 480px) { .att-grid { grid-template-columns: 1fr; } }
/* Card */
.att-card {
    position: relative;
    background: var(--bg-primary);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--spacing);
    box-shadow: var(--shadow-md);
    transition: all .2s ease;
    overflow: hidden;
}
.att-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); }
.att-card--present { border-color: var(--success-color); background: var(--success-light); }
.att-card--absent  { border-color: var(--danger-color); background: var(--danger-light); }
.att-card--unset   { border-color: var(--border-color); }
.att-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}
.att-card--present::before { background: var(--success-color); }
.att-card--absent::before  { background: var(--danger-color); }
.att-card--unset::before   { background: var(--gray-300); }
/* Card top */
.att-card__top { display: flex; align-items: center; gap: var(--spacing-sm); margin-bottom: var(--spacing-sm); }
.att-card__num {
    width: 24px; height: 24px; border-radius: var(--radius-full);
    background: var(--gray-100); color: var(--text-muted);
    font-size: var(--text-xs); font-weight: var(--font-bold);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.att-card__avatar {
    width: 42px; height: 42px; border-radius: var(--radius-full);
    display: flex; align-items: center; justify-content: center;
    font-size: var(--text-lg); font-weight: var(--font-bold); color: #fff; flex-shrink: 0;
    transition: var(--transition-fast); box-shadow: var(--shadow-sm);
}
.att-avatar--green { background: var(--success-color); }
.att-avatar--red   { background: var(--danger-color); }
.att-avatar--gray  { background: var(--gray-400); }
.att-card__info { flex: 1; min-width: 0; }
.att-card__name { font-weight: var(--font-semibold); font-size: var(--text-base); color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* Badges */
.att-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 2px 8px; border-radius: var(--radius-full);
    font-size: var(--text-xs); font-weight: var(--font-bold);
}
.att-badge--present { background: var(--success-light); color: var(--success-color); }
.att-badge--absent  { background: var(--danger-light); color: var(--danger-color); }
.att-badge--none    { background: var(--gray-100); color: var(--text-secondary); }
/* Attendance buttons */
.att-card__btns { display: flex; gap: var(--spacing-xs); margin-top: var(--spacing-sm); }
.att-btn {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px;
    padding: var(--spacing-sm); border-radius: var(--radius);
    border: 2px solid; cursor: pointer; font-size: var(--text-sm);
    font-weight: var(--font-semibold); transition: all .15s ease;
    background: transparent;
}
.att-btn--present { color: var(--success-color); border-color: var(--success-color); }
.att-btn--present:hover, .att-btn--present.active {
    background: var(--success-color); color: #fff; border-color: var(--success-color);
    box-shadow: var(--shadow-sm);
}
.att-btn--absent { color: var(--danger-color); border-color: var(--danger-color); }
.att-btn--absent:hover, .att-btn--absent.active {
    background: var(--danger-color); color: #fff; border-color: var(--danger-color);
    box-shadow: var(--shadow-sm);
}
/* Loading overlay */
.att-card__overlay {
    position: absolute; inset: 0; background: rgba(255,255,255,.7);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; color: var(--primary-color);
    border-radius: var(--radius-lg); backdrop-filter: blur(2px);
}
/* Toast */
.att-toast-container {
    position: fixed; bottom: var(--spacing); inset-inline-end: var(--spacing);
    z-index: var(--z-tooltip); display: flex; flex-direction: column; gap: var(--spacing-xs);
    pointer-events: none;
}
.att-toast {
    display: flex; align-items: center; gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing); border-radius: var(--radius);
    font-size: var(--text-sm); font-weight: var(--font-medium);
    box-shadow: var(--shadow-lg); pointer-events: auto;
    animation: attSlideUp .25s ease; min-width: 220px; color: #fff;
}
@@keyframes attSlideUp {
    from { opacity:0; transform: translateY(16px); }
    to   { opacity:1; transform: translateY(0); }
}
.att-toast--success { background: var(--success-color); }
.att-toast--error   { background: var(--danger-color); }
.att-toast--info    { background: var(--info-color); }
</style>

<script>
const GROUP_ID   = @Model.GroupId;
const ATT_DATE   = '@Model.Date.ToString("yyyy-MM-dd")';

// State: studentId → bool|null
const state = {};
@foreach (var s in Model.Students)
{
    string present = s.IsPresent == null ? "null" : s.IsPresent.Value.ToString().ToLower();
    @:state[@s.StudentId] = @present;
}

async function apiPost(url, data) {
    const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    });
    return res.json();
}

function showOverlay(studentId, show) {
    const el = document.getElementById('overlay-' + studentId);
    if (el) el.style.display = show ? 'flex' : 'none';
}

function updateCardUI(studentId) {
    const isPresent = state[studentId];
    const card   = document.getElementById('card-'       + studentId);
    const avatar = document.getElementById('avatar-'     + studentId);
    const attLbl = document.getElementById('attLabel-'   + studentId);
    const btnP   = document.getElementById('btnPresent-' + studentId);
    const btnA   = document.getElementById('btnAbsent-'  + studentId);

    card.classList.remove('att-card--present','att-card--absent','att-card--unset');
    if (isPresent === true)       card.classList.add('att-card--present');
    else if (isPresent === false) card.classList.add('att-card--absent');
    else                          card.classList.add('att-card--unset');

    avatar.classList.remove('att-avatar--green','att-avatar--red','att-avatar--gray');
    if (isPresent === true)       avatar.classList.add('att-avatar--green');
    else if (isPresent === false) avatar.classList.add('att-avatar--red');
    else                          avatar.classList.add('att-avatar--gray');

    if (isPresent === true)
        attLbl.innerHTML = '<span class="att-badge att-badge--present"><i class="fas fa-check"></i> حضر</span>';
    else if (isPresent === false)
        attLbl.innerHTML = '<span class="att-badge att-badge--absent"><i class="fas fa-times"></i> غاب</span>';
    else
        attLbl.innerHTML = '<span class="att-badge att-badge--none"><i class="fas fa-minus"></i> لم يُسجَّل</span>';

    btnP.classList.toggle('active', isPresent === true);
    btnA.classList.toggle('active', isPresent === false);

    updateStats();
}

function updateStats() {
    const vals = Object.values(state);
    document.getElementById('statPresent').textContent = vals.filter(v => v === true).length;
    document.getElementById('statAbsent' ).textContent = vals.filter(v => v === false).length;
    document.getElementById('statUnmark' ).textContent = vals.filter(v => v === null).length;
}

async function setAttendance(studentId, isPresent) {
    const prev = state[studentId];
    state[studentId] = isPresent;
    updateCardUI(studentId);
    showOverlay(studentId, true);

    try {
        const res = await apiPost('/Attendance/ToggleAttendance', {
            studentId, groupId: GROUP_ID, date: ATT_DATE, isPresent
        });
        if (!res.success) {
            state[studentId] = prev;
            updateCardUI(studentId);
            showToast(res.message || 'حدث خطأ', 'error');
        } else {
            showToast(isPresent ? '✓ تم تسجيل الحضور' : '✗ تم تسجيل الغياب',
                      isPresent ? 'success' : 'error', 2000);
        }
    } catch {
        state[studentId] = prev;
        updateCardUI(studentId);
        showToast('خطأ في الاتصال', 'error');
    } finally {
        showOverlay(studentId, false);
    }
}

async function bulkAttendance(isPresent) {
    const ids = Object.keys(state).map(Number);
    const prev = { ...state };
    ids.forEach(id => { state[id] = isPresent; updateCardUI(id); });

    try {
        const res = await apiPost('/Attendance/BulkAttendance', {
            groupId: GROUP_ID, date: ATT_DATE, isPresent
        });
        if (!res.success) {
            ids.forEach(id => { state[id] = prev[id]; updateCardUI(id); });
            showToast(res.message || 'حدث خطأ', 'error');
        } else {
            showToast(isPresent ? '✓ تم تسجيل حضور الكل' : '✗ تم تسجيل غياب الكل',
                      isPresent ? 'success' : 'error', 2500);
        }
    } catch {
        ids.forEach(id => { state[id] = prev[id]; updateCardUI(id); });
        showToast('خطأ في الاتصال', 'error');
    }
}

function filterCards(query) {
    const q = query.trim().toLowerCase();
    document.querySelectorAll('.att-card').forEach(card => {
        const name = card.dataset.name || '';
        card.style.display = (!q || name.includes(q)) ? '' : 'none';
    });
}

function showToast(msg, type = 'info', duration = 3000) {
    const container = document.getElementById('attToastContainer');
    const toast = document.createElement('div');
    toast.className = `att-toast att-toast--${type}`;
    toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-times-circle' : 'fa-info-circle'}"></i><span>${msg}</span>`;
    container.appendChild(toast);
    setTimeout(() => { toast.style.opacity='0'; toast.style.transition='opacity .3s'; setTimeout(()=>toast.remove(),300); }, duration);
}
</script>
}
