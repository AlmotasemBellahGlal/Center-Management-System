@model CreateStudentVM
@{
    ViewData["Title"] = "تعديل بيانات الطالب";
}

<div class="student-page-heading student-page-heading--form">
    <div>
        <span class="student-page-heading__eyebrow">تحديث ملف الطالب</span>
        <h1 class="student-page-heading__title">تعديل بيانات الطالب</h1>
        <p class="student-page-heading__subtitle">حدّث بيانات التواصل أو انقل الطالب إلى مجموعة دراسية أخرى.</p>
    </div>
    <a asp-action="Index" class="btn btn-neutral">
        <i class="fas fa-arrow-right" aria-hidden="true"></i> العودة إلى الطلاب
    </a>
</div>

<form asp-action="Edit" class="student-form">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="student-form-errors" role="alert"></div>

    <section class="card student-form-section" aria-labelledby="studentPersonalInfoTitle">
        <div class="card-header student-form-section__header">
            <span class="card-header-icon"><i class="fas fa-id-card" aria-hidden="true"></i></span>
            <div>
                <h2 class="card-title" id="studentPersonalInfoTitle">المعلومات الشخصية</h2>
                <p class="student-card-subtitle">راجع الاسم وبيانات التواصل المسجلة للطالب.</p>
            </div>
            <span class="student-form-step">01</span>
        </div>
        <div class="card-body student-form-section__body">
            <div class="student-form-grid">
                <div class="form-group student-form-field--wide">
                    <label asp-for="FullName" class="form-label">الاسم الكامل <span class="form-required" aria-hidden="true">*</span></label>
                    <div class="student-input-shell">
                        <i class="fas fa-user" aria-hidden="true"></i>
                        <input asp-for="FullName"
                               class="form-control"
                               autocomplete="name"
                               placeholder="الاسم الكامل للطالب"
                               aria-describedby="FullNameHint FullNameError" />
                    </div>
                    <p class="form-hint" id="FullNameHint">سيظهر هذا الاسم في سجلات الحضور والتقارير.</p>
                    <span asp-validation-for="FullName" class="field-error" id="FullNameError"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber" class="form-label">رقم هاتف الطالب <span class="form-required" aria-hidden="true">*</span></label>
                    <div class="student-input-shell student-input-shell--ltr">
                        <i class="fas fa-phone" aria-hidden="true"></i>
                        <input asp-for="PhoneNumber"
                               class="form-control"
                               placeholder="01XXXXXXXXX"
                               dir="ltr"
                               inputmode="tel"
                               autocomplete="tel"
                               aria-describedby="PhoneNumberHint PhoneNumberError" />
                    </div>
                    <p class="form-hint" id="PhoneNumberHint">رقم مصري مكوّن من 11 رقمًا.</p>
                    <span asp-validation-for="PhoneNumber" class="field-error" id="PhoneNumberError"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ParentPhoneNumber" class="form-label">هاتف ولي الأمر <span class="form-required" aria-hidden="true">*</span></label>
                    <div class="student-input-shell student-input-shell--ltr">
                        <i class="fas fa-user-shield" aria-hidden="true"></i>
                        <input asp-for="ParentPhoneNumber"
                               class="form-control"
                               placeholder="01XXXXXXXXX"
                               dir="ltr"
                               inputmode="tel"
                               aria-describedby="ParentPhoneNumberHint ParentPhoneNumberError" />
                    </div>
                    <p class="form-hint" id="ParentPhoneNumberHint">يُستخدم للتواصل والمتابعة عند الحاجة.</p>
                    <span asp-validation-for="ParentPhoneNumber" class="field-error" id="ParentPhoneNumberError"></span>
                </div>
            </div>
        </div>
    </section>

    <section class="card student-form-section" aria-labelledby="studentGroupTitle">
        <div class="card-header student-form-section__header">
            <span class="card-header-icon"><i class="fas fa-user-group" aria-hidden="true"></i></span>
            <div>
                <h2 class="card-title" id="studentGroupTitle">المجموعة الدراسية</h2>
                <p class="student-card-subtitle">المجموعة المحددة حاليًا ظاهرة بعلامة الاختيار؛ اختر غيرها عند الحاجة.</p>
            </div>
            <span class="student-form-step">02</span>
        </div>
        <div class="student-form-group-validation">
            <span asp-validation-for="SelectedGroupId" class="field-error" id="SelectedGroupIdError"></span>
        </div>

        @if (Model.AcademicYears.Any())
        {
            <div class="student-academic-year-list">
                @foreach (var year in Model.AcademicYears)
                {
                    <fieldset class="student-academic-year">
                        <legend>
                            <span class="student-academic-year__icon"><i class="fas fa-graduation-cap" aria-hidden="true"></i></span>
                            <span>
                                <strong>@year.AcademicYearName</strong>
                                <small>@year.Groups.Count مجموعة متاحة</small>
                            </span>
                        </legend>

                        @if (year.Groups.Any())
                        {
                            <div class="student-group-choice-grid">
                                @foreach (var group in year.Groups)
                                {
                                    <div class="student-group-choice">
                                        <input type="radio"
                                               asp-for="SelectedGroupId"
                                               value="@group.GroupId"
                                               id="grp_@group.GroupId"
                                               class="student-group-choice__input"
                                               aria-describedby="SelectedGroupIdError" />
                                        <label for="grp_@group.GroupId" class="student-group-choice__label">
                                            <span class="student-group-choice__icon"><i class="fas fa-users" aria-hidden="true"></i></span>
                                            <span class="student-group-choice__content">
                                                <strong>@group.GroupName</strong>
                                                <small>اختيار هذه المجموعة</small>
                                            </span>
                                            <span class="student-group-choice__check"><i class="fas fa-circle-check" aria-hidden="true"></i></span>
                                        </label>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="student-form-empty-inline">
                                <i class="fas fa-folder-open" aria-hidden="true"></i>
                                لا توجد مجموعات لهذه السنة
                            </div>
                        }
                    </fieldset>
                }
            </div>
        }
        else
        {
            <div class="student-section-empty student-section-empty--form">
                <i class="fas fa-calendar-xmark" aria-hidden="true"></i>
                <strong>لا توجد سنوات دراسية أو مجموعات متاحة</strong>
                <span>أضف سنة ومجموعة دراسية أولًا قبل تحديث مجموعة الطالب.</span>
            </div>
        }
    </section>

    <div class="card student-form-actions">
        <div class="student-form-actions__hint">
            <i class="fas fa-circle-info" aria-hidden="true"></i>
            سيُحفظ الملف بنفس رقم الطالب الحالي.
        </div>
        <div>
            <a asp-action="Index" class="btn btn-neutral"><i class="fas fa-xmark" aria-hidden="true"></i> إلغاء</a>
            <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-floppy-disk" aria-hidden="true"></i> حفظ التعديلات</button>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
