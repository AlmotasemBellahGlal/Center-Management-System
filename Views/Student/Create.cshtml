@model CreateStudentVM

@{
    ViewData["Title"] = "Create Student";
}

<h2>Create Student</h2>

<form asp-action="Create">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">

        <label asp-for="FullName"></label>

        <input asp-for="FullName" class="form-control" />

        <span asp-validation-for="FullName"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="PhoneNumber"></label>

        <input asp-for="PhoneNumber"
               class="form-control" />

        <span asp-validation-for="PhoneNumber"
              class="text-danger"></span>

    </div>

    <div class="mb-3">

        <label asp-for="ParentPhoneNumber"></label>

        <input asp-for="ParentPhoneNumber"
               class="form-control" />

        <span asp-validation-for="ParentPhoneNumber"
              class="text-danger"></span>

    </div>

    <hr />

    <h4>Groups</h4>

    @for (int i = 0; i < Model.AcademicYears.Count; i++)
    {
        <div class="card mb-3">

            <div class="card-header">

                <strong>
                    @Model.AcademicYears[i].AcademicYearName
                </strong>

                -

                @Model.AcademicYears[i].SubjectName

            </div>

            <div class="card-body">

                @for (int j = 0; j < Model.AcademicYears[i].Groups.Count; j++)
                {
                    <div class="form-check">

                        <input class="form-check-input"
                               type="radio"
                               asp-for="AcademicYears[i].SelectedGroupId"
                               value="@Model.AcademicYears[i].Groups[j].GroupId" />

                        <label class="form-check-label">

                            @Model.AcademicYears[i].Groups[j].GroupName

                        </label>

                    </div>
                }

            </div>

        </div>
    }

    <button class="btn btn-primary">

        Save

    </button>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}