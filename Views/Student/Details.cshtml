@model Center_Management.Models.Student
@{
    ViewData["Title"] = "ملف الطالب";

    var attendanceRecords = Model.Attendences?.ToList() ?? new List<Attendence>();
    var paymentRecords = Model.Payments?.ToList() ?? new List<Payment>();
    var groupRecords = Model.StudentGroups?.ToList() ?? new List<StudentGroup>();
    var activeGroup = groupRecords.FirstOrDefault(sg => sg.IsActive);
    var presentCount = attendanceRecords.Count(a => a.IsPresent);
    var absentCount = attendanceRecords.Count(a => !a.IsPresent);
    var attendanceRate = attendanceRecords.Count == 0
        ? 0
        : (int)Math.Round((double)presentCount / attendanceRecords.Count * 100);
    var paidCount = paymentRecords.Count(p => p.IsPaid);
    var unpaidCount = paymentRecords.Count(p => !p.IsPaid);
    var paidAmount = paymentRecords.Where(p => p.IsPaid).Sum(p => p.Amount);
    var studentInitial = string.IsNullOrWhiteSpace(Model.FullName) ? "؟" : Model.FullName.Trim()[0].ToString();
}

<section class="card student-profile-hero" aria-labelledby="studentProfileTitle">
    <div class="student-profile-hero__identity">
        <span class="student-profile-avatar" aria-hidden="true">@studentInitial</span>
        <div>
            <div class="student-profile-hero__status-row">
                @if (activeGroup != null)
                {
                    <span class="badge badge-success"><i class="fas fa-circle-check" aria-hidden="true"></i> طالب نشط</span>
                }
                else
                {
                    <span class="badge badge-warning"><i class="fas fa-circle-exclamation" aria-hidden="true"></i> بدون مجموعة نشطة</span>
                }
                <span class="student-profile-hero__id">ملف رقم @Model.Id</span>
            </div>
            <h1 id="studentProfileTitle">@Model.FullName</h1>
            <p>
                @if (activeGroup != null)
                {
                    <span>@activeGroup.Group.Name · @activeGroup.Group.AcademicYear!.Name</span>
                }
                else
                {
                    <span>ملف الطالب التفصيلي</span>
                }
            </p>
        </div>
    </div>
    <div class="student-profile-hero__actions">
        <a href="@Url.Action("Index","StudentReport",new{id=Model.Id})" class="btn btn-outline-primary">
            <i class="fas fa-chart-line" aria-hidden="true"></i> التقرير الشامل
        </a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="fas fa-pen" aria-hidden="true"></i> تعديل البيانات
        </a>
        <button type="button"
                class="btn btn-outline-danger"
                onclick="openDeleteModal('@Model.Id','@Html.Raw(Html.Encode(Model.FullName))')">
            <i class="fas fa-trash-can" aria-hidden="true"></i> حذف
        </button>
        <a asp-action="Index" class="btn btn-neutral">
            <i class="fas fa-arrow-right" aria-hidden="true"></i> رجوع
        </a>
    </div>
</section>

<div class="student-profile-overview">
    <section class="card student-profile-card" aria-labelledby="personalInfoTitle">
        <div class="card-header">
            <span class="card-header-icon"><i class="fas fa-id-card" aria-hidden="true"></i></span>
            <div>
                <h2 class="card-title" id="personalInfoTitle">المعلومات الشخصية</h2>
                <p class="student-card-subtitle">بيانات التواصل الأساسية للطالب وولي الأمر</p>
            </div>
        </div>
        <div class="student-profile-info-grid">
            <div class="student-profile-info-item student-profile-info-item--wide">
                <span class="student-profile-info-item__icon"><i class="fas fa-user" aria-hidden="true"></i></span>
                <div>
                    <span class="student-profile-info-item__label">الاسم الكامل</span>
                    <strong>@Model.FullName</strong>
                </div>
            </div>
            <div class="student-profile-info-item">
                <span class="student-profile-info-item__icon"><i class="fas fa-phone" aria-hidden="true"></i></span>
                <div>
                    <span class="student-profile-info-item__label">رقم هاتف الطالب</span>
                    <strong><bdi dir="ltr">@Model.PhoneNumber</bdi></strong>
                </div>
            </div>
            <div class="student-profile-info-item">
                <span class="student-profile-info-item__icon"><i class="fas fa-user-shield" aria-hidden="true"></i></span>
                <div>
                    <span class="student-profile-info-item__label">هاتف ولي الأمر</span>
                    @if (string.IsNullOrWhiteSpace(Model.ParentPhoneNumber))
                    {
                        <strong class="student-profile-info-item__empty">غير مسجل</strong>
                    }
                    else
                    {
                        <strong><bdi dir="ltr">@Model.ParentPhoneNumber</bdi></strong>
                    }
                </div>
            </div>
        </div>
    </section>

    <section class="card student-profile-card" aria-labelledby="enrollmentInfoTitle">
        <div class="card-header">
            <span class="card-header-icon"><i class="fas fa-layer-group" aria-hidden="true"></i></span>
            <div>
                <h2 class="card-title" id="enrollmentInfoTitle">المجموعات والتسجيل</h2>
                <p class="student-card-subtitle">السجل الحالي والسابق لالتحاق الطالب</p>
            </div>
            @if (Model.StudentGroups != null && Model.StudentGroups.Any())
            {
                <span class="badge badge-primary student-card-count">@Model.StudentGroups.Count() مجموعة</span>
            }
        </div>
        <div class="student-enrollment-list">
            @if (Model.StudentGroups != null && Model.StudentGroups.Any())
            {
                @foreach (var sg in Model.StudentGroups)
                {
                    <article class="student-enrollment-item @(sg.IsActive ? "student-enrollment-item--active" : "student-enrollment-item--inactive")">
                        <span class="student-enrollment-item__icon"><i class="fas fa-user-group" aria-hidden="true"></i></span>
                        <div class="student-enrollment-item__content">
                            <div class="student-enrollment-item__heading">
                                <h3>@sg.Group.Name</h3>
                                <span class="badge @(sg.IsActive ? "badge-success" : "badge-neutral")">
                                    <i class="fas @(sg.IsActive ? "fa-circle-check" : "fa-clock-rotate-left")" aria-hidden="true"></i>
                                    @(sg.IsActive ? "نشط" : "غير نشط")
                                </span>
                            </div>
                            <p><i class="fas fa-graduation-cap" aria-hidden="true"></i> @sg.Group.AcademicYear!.Name</p>
                            <p><i class="fas fa-calendar-plus" aria-hidden="true"></i> تاريخ التسجيل: <time dir="ltr">@sg.EnrollmentDate.ToString("dd/MM/yyyy")</time></p>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="student-section-empty">
                    <i class="fas fa-layer-group" aria-hidden="true"></i>
                    <strong>لم يُسجَّل في أي مجموعة</strong>
                    <span>يمكن تعيين مجموعة من صفحة تعديل الطالب.</span>
                </div>
            }
        </div>
    </section>
</div>

<section class="card student-record-section" aria-labelledby="attendanceTitle">
    <div class="student-record-section__header">
        <div class="student-record-section__title">
            <span class="student-record-section__icon student-record-section__icon--success"><i class="fas fa-clipboard-check" aria-hidden="true"></i></span>
            <div>
                <h2 id="attendanceTitle">ملخص الحضور</h2>
                <p>نظرة سريعة على انتظام الطالب وآخر سجلاته.</p>
            </div>
        </div>
        @if (Model.Attendences != null && Model.Attendences.Any())
        {
            <span class="badge badge-neutral">@Model.Attendences.Count() سجل</span>
        }
    </div>

    <div class="student-summary-grid">
        <div class="student-summary-metric">
            <span>إجمالي السجلات</span>
            <strong>@attendanceRecords.Count</strong>
        </div>
        <div class="student-summary-metric student-summary-metric--success">
            <span>حضور</span>
            <strong>@presentCount</strong>
        </div>
        <div class="student-summary-metric student-summary-metric--danger">
            <span>غياب</span>
            <strong>@absentCount</strong>
        </div>
        <div class="student-summary-metric student-summary-metric--primary">
            <span>نسبة الحضور</span>
            <strong>@attendanceRate%</strong>
        </div>
    </div>

    @if (Model.Attendences != null && Model.Attendences.Any())
    {
        <div class="table-wrap student-record-table">
            <table class="data-table">
                <caption class="student-visually-hidden">آخر سجلات حضور الطالب</caption>
                <thead>
                    <tr><th>التاريخ</th><th>المجموعة</th><th>الحالة</th></tr>
                </thead>
                <tbody>
                    @foreach (var att in Model.Attendences.OrderByDescending(a => a.Date).Take(10))
                    {
                        <tr>
                            <td><time dir="ltr">@att.Date.ToString("dd/MM/yyyy")</time></td>
                            <td>@(att.Group?.Name ?? "—")</td>
                            <td>
                                @if (att.IsPresent)
                                {
                                    <span class="badge badge-success"><i class="fas fa-check" aria-hidden="true"></i> حاضر</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><i class="fas fa-xmark" aria-hidden="true"></i> غائب</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Attendences.Count() > 10)
        {
            <p class="student-record-section__note">
                <i class="fas fa-circle-info" aria-hidden="true"></i>
                عرض آخر 10 سجلات — اضغط "التقرير الشامل" لكل السجلات
            </p>
        }
    }
    else
    {
        <div class="student-section-empty student-section-empty--record">
            <i class="fas fa-clipboard-list" aria-hidden="true"></i>
            <strong>لا يوجد سجل حضور</strong>
            <span>ستظهر سجلات الحضور هنا بعد تسجيل أول جلسة.</span>
        </div>
    }
</section>

<section class="card student-record-section" aria-labelledby="paymentsTitle">
    <div class="student-record-section__header">
        <div class="student-record-section__title">
            <span class="student-record-section__icon student-record-section__icon--warning"><i class="fas fa-wallet" aria-hidden="true"></i></span>
            <div>
                <h2 id="paymentsTitle">ملخص المدفوعات</h2>
                <p>حالة السداد وآخر الدفعات المسجلة للطالب.</p>
            </div>
        </div>
        @if (Model.Payments != null && Model.Payments.Any())
        {
            <span class="badge badge-neutral">@Model.Payments.Count() سجل</span>
        }
    </div>

    <div class="student-summary-grid">
        <div class="student-summary-metric">
            <span>إجمالي السجلات</span>
            <strong>@paymentRecords.Count</strong>
        </div>
        <div class="student-summary-metric student-summary-metric--success">
            <span>مدفوع</span>
            <strong>@paidCount</strong>
        </div>
        <div class="student-summary-metric student-summary-metric--danger">
            <span>غير مدفوع</span>
            <strong>@unpaidCount</strong>
        </div>
        <div class="student-summary-metric student-summary-metric--primary">
            <span>إجمالي المدفوع</span>
            <strong>@paidAmount.ToString("N0") <small>ج.م</small></strong>
        </div>
    </div>

    @if (Model.Payments != null && Model.Payments.Any())
    {
        <div class="table-wrap student-record-table">
            <table class="data-table">
                <caption class="student-visually-hidden">آخر مدفوعات الطالب</caption>
                <thead>
                    <tr><th>التاريخ</th><th>المجموعة</th><th>الشهر / السنة</th><th>المبلغ</th><th>الحالة</th></tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Payments.OrderByDescending(p => p.PaymentDate).Take(10))
                    {
                        <tr>
                            <td><time dir="ltr">@p.PaymentDate.ToString("dd/MM/yyyy")</time></td>
                            <td>@(p.Group?.Name ?? "—")</td>
                            <td>@(new System.Globalization.CultureInfo("ar-SA").DateTimeFormat.GetMonthName(p.Month)) @p.Year</td>
                            <td><strong class="student-payment-amount">@p.Amount.ToString("N0") ج.م</strong></td>
                            <td>
                                @if (p.IsPaid)
                                {
                                    <span class="badge badge-success"><i class="fas fa-check" aria-hidden="true"></i> مدفوع</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger"><i class="fas fa-clock" aria-hidden="true"></i> غير مدفوع</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="student-section-empty student-section-empty--record">
            <i class="fas fa-receipt" aria-hidden="true"></i>
            <strong>لا يوجد سجل مدفوعات</strong>
            <span>ستظهر الدفعات هنا عند تسجيل أول عملية سداد.</span>
        </div>
    }
</section>

<div class="modal" id="deleteStudentModal" role="dialog" aria-modal="true" aria-labelledby="deleteStudentTitle">
    <div class="modal__backdrop" onclick="closeModal('deleteStudentModal')"></div>
    <div class="modal__content">
        <div class="modal__header">
            <span class="student-delete-modal__icon"><i class="fas fa-user-minus" aria-hidden="true"></i></span>
            <h2 class="modal__title" id="deleteStudentTitle">تأكيد حذف الطالب</h2>
            <button type="button" class="modal__close" onclick="closeModal('deleteStudentModal')" aria-label="إغلاق نافذة الحذف">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
        <div class="modal__body student-delete-modal__body">
            <p>أنت على وشك حذف ملف الطالب:</p>
            <strong id="deleteStudentName"></strong>
            <p class="student-delete-modal__warning"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> لا يمكن التراجع عن هذا الإجراء.</p>
        </div>
        <div class="modal__footer">
            <button type="button" class="btn btn-neutral" onclick="closeModal('deleteStudentModal')">إلغاء</button>
            <a id="deleteConfirmLink" href="#" class="btn btn-danger"><i class="fas fa-trash-can" aria-hidden="true"></i> حذف الطالب</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openDeleteModal(sid, name) {
    document.getElementById('deleteStudentName').textContent = name;
    document.getElementById('deleteConfirmLink').href = '/Student/Delete/' + sid;
    openModal('deleteStudentModal');
}
</script>
}
