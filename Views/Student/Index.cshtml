@{
    ViewData["Title"] = "الطلاب";
    var groupedStudents = ViewData["GroupedStudents"] as IEnumerable<dynamic>;
    var studentsWithoutGroup = ViewData["StudentsWithoutActiveGroup"] as IEnumerable<Center_Management.Models.Student>;

    int totalActive = 0, totalGroups = 0;
    if (groupedStudents != null)
        foreach (var y in groupedStudents)
            foreach (var g in y.Groups) { totalGroups++; foreach (var s in g.Students) totalActive++; }

    int totalInactive = studentsWithoutGroup?.Count() ?? 0;
    int totalAll = totalActive + totalInactive;
    var yearList = groupedStudents?.Cast<dynamic>().ToList() ?? new List<dynamic>();
}

<div class="student-page-heading">
    <div>
        <span class="student-page-heading__eyebrow">دليل الطلاب</span>
        <h1 class="student-page-heading__title">إدارة الطلاب</h1>
        <p class="student-page-heading__subtitle">استعرض الطلاب حسب السنة الدراسية والمجموعة، أو ابحث عن طالب مباشرة.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">
        <i class="fas fa-user-plus" aria-hidden="true"></i>
        إضافة طالب
    </a>
</div>

<div class="stat-grid student-stat-grid" aria-label="ملخص الطلاب">
    <div class="stat-card stat-card--primary">
        <div class="stat-card__icon"><i class="fas fa-users" aria-hidden="true"></i></div>
        <div class="stat-card__body">
            <div class="stat-card__value">@totalAll</div>
            <div class="stat-card__label">إجمالي الطلاب</div>
            <div class="stat-card__trend">كل الطلاب المسجلين بالنظام</div>
        </div>
    </div>
    <div class="stat-card stat-card--success">
        <div class="stat-card__icon"><i class="fas fa-user-check" aria-hidden="true"></i></div>
        <div class="stat-card__body">
            <div class="stat-card__value">@totalActive</div>
            <div class="stat-card__label">في مجموعات نشطة</div>
            <div class="stat-card__trend"><i class="fas fa-circle-check" aria-hidden="true"></i> جاهزون للمتابعة</div>
        </div>
    </div>
    <div class="stat-card stat-card--warning">
        <div class="stat-card__icon"><i class="fas fa-user-clock" aria-hidden="true"></i></div>
        <div class="stat-card__body">
            <div class="stat-card__value">@totalInactive</div>
            <div class="stat-card__label">بدون مجموعة نشطة</div>
            <div class="stat-card__trend">يحتاجون إلى تعيين مجموعة</div>
        </div>
    </div>
    <div class="stat-card stat-card--accent">
        <div class="stat-card__icon"><i class="fas fa-layer-group" aria-hidden="true"></i></div>
        <div class="stat-card__body">
            <div class="stat-card__value">@totalGroups</div>
            <div class="stat-card__label">المجموعات</div>
            <div class="stat-card__trend">ضمن السنوات الدراسية الحالية</div>
        </div>
    </div>
</div>

<section class="card student-directory-toolbar" aria-label="البحث في دليل الطلاب">
    <div class="student-search-box">
        <label for="studentSearch" class="student-search-box__label">البحث السريع</label>
        <div class="student-search-box__control">
            <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
            <input id="studentSearch"
                   type="search"
                   autocomplete="off"
                   placeholder="ابحث بالاسم أو رقم هاتف الطالب أو ولي الأمر..."
                   oninput="filterStudents(this.value)"
                   aria-describedby="studentSearchHint searchMeta" />
            <button type="button" onclick="clearSearch()" aria-label="مسح البحث" title="مسح البحث">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
        <p id="studentSearchHint" class="student-search-box__hint">تظهر النتائج فور الكتابة داخل كل سنة ومجموعة.</p>
    </div>
    <div class="student-directory-toolbar__summary">
        <span class="badge badge-primary"><i class="fas fa-address-book" aria-hidden="true"></i> @totalAll طالب</span>
        <span id="searchMeta" class="student-search-meta d-none" role="status" aria-live="polite"></span>
    </div>
</section>

@if (yearList.Any())
{
    <div class="student-section-heading">
        <div>
            <span class="student-section-heading__icon"><i class="fas fa-graduation-cap" aria-hidden="true"></i></span>
            <div>
                <h2>الطلاب في مجموعات نشطة</h2>
                <p>افتح السنة ثم المجموعة للوصول إلى ملفات الطلاب.</p>
            </div>
        </div>
        <span class="badge badge-success">@totalActive طالب</span>
    </div>
}

<div class="student-directory" id="studentDirectory">
    @for (int yi = 0; yi < yearList.Count; yi++)
    {
        var yearGroup = yearList[yi];
        string yid = "y" + yi;
        int cnt = 0;
        foreach (var g in yearGroup.Groups) foreach (var s in g.Students) cnt++;
        var groupList = ((IEnumerable<dynamic>)yearGroup.Groups).ToList();

        <section class="card student-directory-year" id="@yid" data-directory-year>
            <button type="button"
                    class="student-directory-year__toggle"
                    onclick="toggleAcc('@yid')"
                    data-accordion-toggle
                    aria-expanded="true"
                    aria-controls="body-@yid">
                <span class="student-directory-year__identity">
                    <span class="student-directory-year__icon"><i class="fas fa-calendar-days" aria-hidden="true"></i></span>
                    <span>
                        <strong>@yearGroup.AcademicYearName</strong>
                        <small>@groupList.Count مجموعة · @cnt طالب</small>
                    </span>
                </span>
                <span class="student-directory-year__meta">
                    <span class="badge badge-primary">@cnt طالب</span>
                    <i class="fas fa-chevron-down student-accordion-chevron" id="chev-@yid" aria-hidden="true"></i>
                </span>
            </button>

            <div class="student-accordion-body student-directory-year__body" id="body-@yid">
                @for (int gi = 0; gi < groupList.Count; gi++)
                {
                    var groupItem = groupList[gi];
                    string gid = "g" + yi + "_" + gi;
                    int gc = 0;
                    foreach (var s2 in groupItem.Students) gc++;
                    var studentList = ((IEnumerable<dynamic>)groupItem.Students).ToList();

                    <article class="student-group-panel" data-directory-group>
                        <div class="student-group-panel__header">
                            <button type="button"
                                    class="student-group-panel__toggle"
                                    onclick="toggleAcc('@gid')"
                                    data-accordion-toggle
                                    aria-expanded="true"
                                    aria-controls="body-@gid">
                                <span class="student-group-panel__identity">
                                    <span class="student-group-panel__icon"><i class="fas fa-user-group" aria-hidden="true"></i></span>
                                    <span>
                                        <strong>@groupItem.GroupName</strong>
                                        <small>@gc طالب مسجل</small>
                                    </span>
                                </span>
                                <i class="fas fa-chevron-down student-accordion-chevron" id="chev-@gid" aria-hidden="true"></i>
                            </button>
                            <a href="/Session/Index?groupId=@groupItem.GroupId" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-clipboard-check" aria-hidden="true"></i>
                                فتح الجلسة
                            </a>
                        </div>

                        <div class="student-accordion-body student-group-panel__body" id="body-@gid">
                            <div class="student-directory-grid">
                                @for (int si = 0; si < studentList.Count; si++)
                                {
                                    var student = studentList[si];
                                    string studentName = student.FullName;
                                    string studentInitial = string.IsNullOrWhiteSpace(studentName) ? "؟" : studentName.Trim()[0].ToString();

                                    <article class="student-directory-card v-student-row"
                                             data-name="@((studentName ?? string.Empty).ToLowerInvariant())"
                                             data-phone="@student.PhoneNumber"
                                             data-parent-phone="@student.ParentPhoneNumber">
                                        <div class="student-directory-card__top">
                                            <div class="student-directory-card__identity">
                                                <span class="student-avatar" aria-hidden="true">@studentInitial</span>
                                                <div>
                                                    <h3>@student.FullName</h3>
                                                    <span class="student-directory-card__number">طالب رقم @(si + 1) في المجموعة</span>
                                                </div>
                                            </div>
                                            <span class="badge badge-success"><i class="fas fa-circle-check" aria-hidden="true"></i> نشط</span>
                                        </div>
                                        <dl class="student-directory-card__contacts">
                                            <div>
                                                <dt><i class="fas fa-phone" aria-hidden="true"></i> رقم الطالب</dt>
                                                <dd><bdi dir="ltr">@student.PhoneNumber</bdi></dd>
                                            </div>
                                            <div>
                                                <dt><i class="fas fa-user-shield" aria-hidden="true"></i> ولي الأمر</dt>
                                                <dd><bdi dir="ltr">@student.ParentPhoneNumber</bdi></dd>
                                            </div>
                                        </dl>
                                        <div class="student-directory-card__actions">
                                            <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-primary btn-sm">
                                                <i class="fas fa-address-card" aria-hidden="true"></i> الملف
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-neutral btn-sm">
                                                <i class="fas fa-pen" aria-hidden="true"></i> تعديل
                                            </a>
                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm btn-icon"
                                                    aria-label="حذف الطالب @student.FullName"
                                                    title="حذف الطالب"
                                                    onclick="openDeleteModal('@student.Id','@Html.Raw(Html.Encode(student.FullName))')">
                                                <i class="fas fa-trash-can" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        </section>
    }
</div>

@if (studentsWithoutGroup != null && studentsWithoutGroup.Any())
{
    var inactiveList = studentsWithoutGroup.OrderBy(s => s.FullName).ToList();
    <section class="student-unassigned-section" data-unassigned-section>
        <div class="student-section-heading student-section-heading--warning">
            <div>
                <span class="student-section-heading__icon"><i class="fas fa-user-clock" aria-hidden="true"></i></span>
                <div>
                    <h2>بدون مجموعة نشطة</h2>
                    <p>يمكن تعديل ملف الطالب وتعيينه إلى مجموعة مناسبة.</p>
                </div>
            </div>
            <span class="badge badge-warning">@totalInactive طالب</span>
        </div>

        <div class="student-directory-grid student-directory-grid--unassigned">
            @for (int ii = 0; ii < inactiveList.Count; ii++)
            {
                var student = inactiveList[ii];
                string studentInitial = string.IsNullOrWhiteSpace(student.FullName) ? "؟" : student.FullName.Trim()[0].ToString();

                <article class="student-directory-card student-directory-card--unassigned v-student-row"
                         data-name="@((student.FullName ?? string.Empty).ToLowerInvariant())"
                         data-phone="@student.PhoneNumber"
                         data-parent-phone="@student.ParentPhoneNumber">
                    <div class="student-directory-card__top">
                        <div class="student-directory-card__identity">
                            <span class="student-avatar student-avatar--muted" aria-hidden="true">@studentInitial</span>
                            <div>
                                <h3>@student.FullName</h3>
                                <span class="student-directory-card__number">طالب رقم @(ii + 1) في القائمة</span>
                            </div>
                        </div>
                        <span class="badge badge-warning"><i class="fas fa-circle-exclamation" aria-hidden="true"></i> بدون مجموعة</span>
                    </div>
                    <dl class="student-directory-card__contacts">
                        <div>
                            <dt><i class="fas fa-phone" aria-hidden="true"></i> رقم الطالب</dt>
                            <dd><bdi dir="ltr">@student.PhoneNumber</bdi></dd>
                        </div>
                        <div>
                            <dt><i class="fas fa-user-shield" aria-hidden="true"></i> ولي الأمر</dt>
                            <dd><bdi dir="ltr">@student.ParentPhoneNumber</bdi></dd>
                        </div>
                    </dl>
                    <div class="student-directory-card__actions">
                        <a asp-action="Details" asp-route-id="@student.Id" class="btn btn-primary btn-sm">
                            <i class="fas fa-address-card" aria-hidden="true"></i> الملف
                        </a>
                        <a asp-action="Edit" asp-route-id="@student.Id" class="btn btn-neutral btn-sm">
                            <i class="fas fa-pen" aria-hidden="true"></i> تعيين مجموعة
                        </a>
                        <button type="button"
                                class="btn btn-outline-danger btn-sm btn-icon"
                                aria-label="حذف الطالب @student.FullName"
                                title="حذف الطالب"
                                onclick="openDeleteModal('@student.Id','@Html.Raw(Html.Encode(student.FullName))')">
                            <i class="fas fa-trash-can" aria-hidden="true"></i>
                        </button>
                    </div>
                </article>
            }
        </div>
    </section>
}

@if (!yearList.Any() && (studentsWithoutGroup == null || !studentsWithoutGroup.Any()))
{
    <div class="card empty-state student-empty-state">
        <div class="empty-state__icon"><i class="fas fa-user-graduate" aria-hidden="true"></i></div>
        <h2 class="empty-state__title">لا يوجد طلاب بعد</h2>
        <p class="empty-state__message">أضف أول طالب، ثم سيظهر هنا داخل سنته ومجموعته الدراسية.</p>
        <a asp-action="Create" class="btn btn-primary btn-lg empty-state__action">
            <i class="fas fa-user-plus" aria-hidden="true"></i> إضافة أول طالب
        </a>
    </div>
}

<div id="noSearchResult" class="card empty-state student-empty-state student-empty-state--search d-none" role="status">
    <div class="empty-state__icon"><i class="fas fa-magnifying-glass" aria-hidden="true"></i></div>
    <h2 class="empty-state__title">لا توجد نتيجة مطابقة</h2>
    <p class="empty-state__message">جرّب كتابة جزء من الاسم أو راجع رقم الهاتف، ثم أعد البحث.</p>
    <button type="button" class="btn btn-neutral" onclick="clearSearch()">مسح البحث</button>
</div>

<div class="modal" id="deleteStudentModal" role="dialog" aria-modal="true" aria-labelledby="deleteStudentTitle">
    <div class="modal__backdrop" onclick="closeModal('deleteStudentModal')"></div>
    <div class="modal__content">
        <div class="modal__header">
            <span class="student-delete-modal__icon"><i class="fas fa-user-minus" aria-hidden="true"></i></span>
            <h2 class="modal__title" id="deleteStudentTitle">تأكيد حذف الطالب</h2>
            <button type="button" class="modal__close" onclick="closeModal('deleteStudentModal')" aria-label="إغلاق نافذة الحذف">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
        <div class="modal__body student-delete-modal__body">
            <p>أنت على وشك حذف ملف الطالب:</p>
            <strong id="deleteStudentName"></strong>
            <p class="student-delete-modal__warning"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> لا يمكن التراجع عن هذا الإجراء.</p>
        </div>
        <div class="modal__footer">
            <button type="button" class="btn btn-neutral" onclick="closeModal('deleteStudentModal')">إلغاء</button>
            <a id="deleteConfirmLink" href="#" class="btn btn-danger"><i class="fas fa-trash-can" aria-hidden="true"></i> حذف الطالب</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
function toggleAcc(id) {
    const body = document.getElementById('body-' + id);
    const chevron = document.getElementById('chev-' + id);
    if (!body) return;

    const collapsed = body.classList.toggle('collapsed');
    if (chevron) chevron.classList.toggle('rotated', collapsed);

    const trigger = document.querySelector('[aria-controls="body-' + id + '"]');
    if (trigger) trigger.setAttribute('aria-expanded', String(!collapsed));
}

function openDeleteModal(sid, name) {
    document.getElementById('deleteStudentName').textContent = name;
    document.getElementById('deleteConfirmLink').href = '/Student/Delete/' + sid;
    openModal('deleteStudentModal');
}

function filterStudents(q) {
    q = (q || '').trim().toLowerCase();
    const cards = document.querySelectorAll('.v-student-row');
    const noResult = document.getElementById('noSearchResult');
    const meta = document.getElementById('searchMeta');
    let found = 0;

    if (q) {
        document.querySelectorAll('.student-accordion-body').forEach(function (body) {
            body.classList.remove('collapsed');
        });
        document.querySelectorAll('[data-accordion-toggle]').forEach(function (trigger) {
            trigger.setAttribute('aria-expanded', 'true');
        });
        document.querySelectorAll('.student-accordion-chevron').forEach(function (chevron) {
            chevron.classList.remove('rotated');
        });
    }

    cards.forEach(function (card) {
        const searchable = [card.dataset.name, card.dataset.phone, card.dataset.parentPhone].join(' ').toLowerCase();
        const matches = !q || searchable.includes(q);
        card.classList.toggle('student-search-hidden', !matches);
        if (matches) found++;
    });

    document.querySelectorAll('[data-directory-group]').forEach(function (group) {
        const hasVisibleStudent = Array.from(group.querySelectorAll('.v-student-row')).some(function (card) {
            return !card.classList.contains('student-search-hidden');
        });
        group.classList.toggle('student-search-hidden', Boolean(q) && !hasVisibleStudent);
    });

    document.querySelectorAll('[data-directory-year]').forEach(function (year) {
        const hasVisibleGroup = Array.from(year.querySelectorAll('[data-directory-group]')).some(function (group) {
            return !group.classList.contains('student-search-hidden');
        });
        year.classList.toggle('student-search-hidden', Boolean(q) && !hasVisibleGroup);
    });

    const unassignedSection = document.querySelector('[data-unassigned-section]');
    if (unassignedSection) {
        const hasVisibleUnassigned = Array.from(unassignedSection.querySelectorAll('.v-student-row')).some(function (card) {
            return !card.classList.contains('student-search-hidden');
        });
        unassignedSection.classList.toggle('student-search-hidden', Boolean(q) && !hasVisibleUnassigned);
    }

    noResult.classList.toggle('d-none', found > 0 || !q);
    meta.classList.toggle('d-none', !q);
    if (q) meta.textContent = 'تم العثور على ' + found + ' طالب';
}

function clearSearch() {
    const input = document.getElementById('studentSearch');
    input.value = '';
    filterStudents('');
    input.focus();
}

document.getElementById('studentSearch')?.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && this.value) clearSearch();
});
</script>
}
