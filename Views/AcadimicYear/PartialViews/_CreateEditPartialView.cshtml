@model AcademicYear
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="form-group">
    <label asp-for="Name" class="control-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="MonthlyPrice" class="control-label"></label>
    <input asp-for="MonthlyPrice" class="form-control" />
    <span asp-validation-for="MonthlyPrice" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="SubjectId" class="control-label">Subject</label>
    <select asp-for="SubjectId" class="form-control" asp-items="ViewBag.SubjectList"></select>
</div>
<div class="form-group">
    <input type="submit" value="Create" class="btn btn-primary" />
</div>