@model LoginVM
@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل الدخول — إدارة المركز</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body {
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            background: var(--bg-app);
            padding: var(--sp-4);
            font-family: var(--font);
        }
        .auth-wrap {
            display: flex; width: 100%; max-width: 900px;
            min-height: 520px;
            border-radius: var(--r-xl);
            box-shadow: var(--shadow-xl);
            overflow: hidden;
        }
        .auth-side {
            flex: 1;
            background: var(--primary);
            padding: var(--sp-10) var(--sp-8);
            display: flex; flex-direction: column; justify-content: center;
            color: #fff;
            position: relative; overflow: hidden;
        }
        .auth-side::before {
            content:''; position: absolute; inset-inline-end: -60px; top: -60px;
            width: 260px; height: 260px; border-radius: 50%;
            background: rgba(255,255,255,0.04);
        }
        .auth-side::after {
            content:''; position: absolute; inset-inline-end: 40px; bottom: -80px;
            width: 180px; height: 180px; border-radius: 50%;
            background: rgba(255,255,255,0.05);
        }
        .auth-side__icon {
            width: 64px; height: 64px;
            background: rgba(255,255,255,0.15);
            border-radius: var(--r-lg);
            display: flex; align-items: center; justify-content: center;
            font-size: 1.8rem; margin-bottom: var(--sp-6);
            position: relative; z-index: 1;
        }
        .auth-side__title { font-size: var(--fs-2xl); font-weight: var(--fw-bold); margin: 0 0 var(--sp-3); position: relative; z-index: 1; }
        .auth-side__text  { font-size: var(--fs-sm); opacity: 0.75; line-height: 1.7; margin: 0; position: relative; z-index: 1; }
        .auth-features { margin-top: var(--sp-8); display: flex; flex-direction: column; gap: var(--sp-3); position: relative; z-index: 1; }
        .auth-feature { display: flex; align-items: center; gap: var(--sp-3); font-size: var(--fs-sm); opacity: 0.85; }
        .auth-feature i { opacity: 0.7; }
        .auth-panel {
            width: 380px; flex-shrink: 0;
            background: var(--bg-card);
            padding: var(--sp-10) var(--sp-8);
            display: flex; flex-direction: column; justify-content: center;
        }
        .auth-logo { display: flex; align-items: center; gap: var(--sp-3); margin-bottom: var(--sp-6); }
        .auth-logo-icon { width: 44px; height: 44px; background: var(--primary-50); color: var(--primary); border-radius: var(--r-md); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; }
        .auth-logo-name { font-size: var(--fs-lg); font-weight: var(--fw-bold); color: var(--text-primary); }
        .auth-heading { font-size: var(--fs-xl); font-weight: var(--fw-bold); color: var(--text-primary); margin: 0 0 var(--sp-1); }
        .auth-sub     { font-size: var(--fs-sm); color: var(--text-muted); margin: 0 0 var(--sp-6); }
        .auth-form-group { margin-bottom: var(--sp-4); }
        .auth-label { display: block; font-size: var(--fs-sm); font-weight: var(--fw-semibold); color: var(--text-secondary); margin-bottom: var(--sp-2); }
        .auth-input {
            display: block; width: 100%;
            padding: 0.6rem var(--sp-4);
            font-size: var(--fs-sm); font-family: var(--font);
            background: var(--bg-card); color: var(--text-primary);
            border: 1.5px solid var(--border); border-radius: var(--r-md);
            transition: border-color 0.14s, box-shadow 0.14s;
        }
        .auth-input:focus { outline: none; border-color: var(--primary); box-shadow: 0 0 0 3px var(--primary-100); }
        .auth-input::placeholder { color: var(--text-disabled); }
        .text-danger { font-size: var(--fs-xs); color: var(--danger); margin-top: var(--sp-1); }
        .auth-remember { display: flex; align-items: center; gap: var(--sp-2); font-size: var(--fs-sm); color: var(--text-secondary); margin-bottom: var(--sp-5); }
        .auth-remember input { accent-color: var(--primary); }
        .auth-btn {
            display: block; width: 100%;
            padding: 0.65rem;
            background: var(--primary); color: #fff;
            border: none; border-radius: var(--r-md);
            font-size: var(--fs-base); font-weight: var(--fw-bold);
            font-family: var(--font); cursor: pointer;
            transition: background 0.14s, transform 0.1s, box-shadow 0.14s;
        }
        .auth-btn:hover { background: var(--primary-hover); transform: translateY(-1px); box-shadow: 0 4px 12px rgba(45,95,138,0.30); }
        .auth-divider { border: none; border-top: 1px solid var(--border-light); margin: var(--sp-5) 0; }
        .auth-link-row { text-align: center; font-size: var(--fs-sm); color: var(--text-muted); }
        .auth-link-row a { color: var(--primary); font-weight: var(--fw-semibold); text-decoration: none; }
        .auth-link-row a:hover { text-decoration: underline; }
        @@media (max-width: 700px) {
            .auth-side { display: none; }
            .auth-panel { width: 100%; max-width: 420px; border-radius: var(--r-xl); }
            .auth-wrap  { max-width: 420px; border-radius: var(--r-xl); }
        }
    </style>
</head>
<body>
    <div class="auth-wrap">
        <div class="auth-side">
            <div class="auth-side__icon"><i class="fas fa-graduation-cap"></i></div>
            <h1 class="auth-side__title">نظام إدارة المركز التعليمي</h1>
            <p class="auth-side__text">منصة متكاملة لإدارة الطلاب، الحضور، المدفوعات، والاختبارات بشكل احترافي وسهل.</p>
            <div class="auth-features">
                <div class="auth-feature"><i class="fas fa-users"></i> إدارة الطلاب والمجموعات</div>
                <div class="auth-feature"><i class="fas fa-clipboard-check"></i> تسجيل الحضور اليومي</div>
                <div class="auth-feature"><i class="fas fa-money-bill-wave"></i> متابعة المدفوعات</div>
                <div class="auth-feature"><i class="fas fa-file-alt"></i> نظام الاختبارات الإلكترونية</div>
            </div>
        </div>
        <div class="auth-panel">
            <div class="auth-logo">
                <div class="auth-logo-icon"><i class="fas fa-graduation-cap"></i></div>
                <span class="auth-logo-name">إدارة المركز</span>
            </div>
            <h2 class="auth-heading">تسجيل الدخول</h2>
            <p class="auth-sub">أدخل بياناتك للوصول إلى لوحة التحكم</p>

            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger" style="margin-bottom:var(--sp-4);font-size:var(--fs-sm);"></div>

                <div class="auth-form-group">
                    <label asp-for="PhoneNumber" class="auth-label">
                        رقم الهاتف أو البريد الإلكتروني
                    </label>
                    <input asp-for="PhoneNumber" type="text" class="auth-input"
                           placeholder="01012345678 أو email@example.com" dir="ltr" autocomplete="username" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="auth-form-group">
                    <label asp-for="Password" class="auth-label">كلمة المرور</label>
                    <input asp-for="Password" type="password" class="auth-input"
                           placeholder="••••••••" dir="ltr" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="auth-remember">
                    <input asp-for="RememberMe" type="checkbox" id="rememberMe" />
                    <label for="rememberMe">تذكرني</label>
                </div>

                <button type="submit" class="auth-btn">
                    <i class="fas fa-sign-in-alt"></i> دخول
                </button>
            </form>

            <hr class="auth-divider" />
            <p class="auth-link-row">
                طالب جديد؟
                <a asp-controller="Account" asp-action="StudentRegister">سجل باستخدام رقم هاتفك</a>
            </p>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
