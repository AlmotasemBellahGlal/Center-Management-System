@model StudentRegisterVM
@{
    ViewData["Title"] = "تسجيل طالب جديد";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>تسجيل طالب — إدارة المركز</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body {
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            background: var(--bg-app); padding: var(--sp-4); font-family: var(--font);
        }
        .auth-card {
            background: var(--bg-card); border-radius: var(--r-xl);
            box-shadow: var(--shadow-xl); padding: 2.5rem 2rem;
            width: 100%; max-width: 420px;
            animation: authUp .35s ease;
        }
        @@keyframes authUp { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
        .auth-logo { text-align:center; margin-bottom:1.75rem; }
        .auth-logo-icon {
            width:56px;height:56px;border-radius:var(--r-lg);
            background:var(--gold);color:#fff;
            display:inline-flex;align-items:center;justify-content:center;
            font-size:1.4rem;margin-bottom:.75rem;
        }
        .auth-logo-title { font-size:1.3rem;font-weight:700;color:var(--text-primary);margin:0; }
        .auth-logo-sub { font-size:.8rem;color:var(--text-muted);margin:.25rem 0 0;display:block; }
        .auth-notice {
            background:var(--gold-50);border:1.5px solid var(--gold-100);
            border-radius:var(--r-md);padding:.875rem 1rem;margin-bottom:1.25rem;
            display:flex;align-items:flex-start;gap:.6rem;font-size:.8rem;color:var(--gold);
        }
        .auth-notice i { flex-shrink:0;margin-top:1px; }
        .auth-fg { margin-bottom:1rem; }
        .auth-label { display:block;font-size:.8rem;font-weight:600;color:var(--text-secondary);margin-bottom:.35rem; }
        .auth-input {
            display:block;width:100%;padding:.55rem .85rem;font-size:.875rem;font-family:var(--font);
            color:var(--text-primary);background:var(--bg-card);
            border:1.5px solid var(--border);border-radius:var(--r-md);
            transition:border-color .14s,box-shadow .14s;
        }
        .auth-input:focus { outline:none;border-color:var(--gold);box-shadow:0 0 0 3px var(--gold-50); }
        .auth-input::placeholder { color:var(--text-disabled); }
        .text-danger { font-size:.75rem;color:var(--danger);display:block;margin-top:.25rem; }
        .auth-hint { font-size:.75rem;color:var(--text-muted);margin-top:.25rem;display:block; }
        .auth-btn {
            display:block;width:100%;padding:.65rem;
            background:var(--gold);color:#fff;border:none;border-radius:var(--r-md);
            font-size:.9375rem;font-weight:700;font-family:var(--font);
            cursor:pointer;transition:background .14s,transform .1s,box-shadow .14s;margin-top:.25rem;
        }
        .auth-btn:hover { background:var(--gold-hover);transform:translateY(-1px);box-shadow:0 4px 12px rgba(176,128,64,.3); }
        .auth-divider { border:none;border-top:1px solid var(--border-light);margin:1.25rem 0; }
        .auth-footer { text-align:center;font-size:.8125rem;color:var(--text-muted); }
        .auth-footer a { color:var(--primary);font-weight:600;text-decoration:none; }
        .auth-footer a:hover { text-decoration:underline; }
        .auth-footer + .auth-footer { margin-top:.5rem; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-logo">
            <div class="auth-logo-icon"><i class="fas fa-user-graduate"></i></div>
            <h1 class="auth-logo-title">تسجيل طالب جديد</h1>
            <span class="auth-logo-sub">سجّل حسابك كطالب في المركز</span>
        </div>

        <div class="auth-notice">
            <i class="fas fa-info-circle"></i>
            <span>أدخل رقم هاتفك المسجل في المركز. لن يُقبل التسجيل إلا إذا كان رقمك موجوداً في سجلات المركز.</span>
        </div>

        <form asp-action="StudentRegister" method="post">
            <div asp-validation-summary="All" class="text-danger" style="margin-bottom:.875rem;font-size:.8rem"></div>

            <div class="auth-fg">
                <label asp-for="PhoneNumber" class="auth-label">رقم الهاتف</label>
                <input asp-for="PhoneNumber" type="tel" class="auth-input"
                       placeholder="01012345678" dir="ltr" maxlength="11" autocomplete="tel" />
                <span class="auth-hint"><i class="fas fa-lightbulb"></i> الرقم المسجل به في المركز</span>
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="auth-fg">
                <label asp-for="Password" class="auth-label">كلمة المرور</label>
                <input asp-for="Password" type="password" class="auth-input"
                       placeholder="••••••••" dir="ltr" autocomplete="new-password" />
                <span class="auth-hint">6 أحرف على الأقل</span>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="auth-fg">
                <label asp-for="ConfirmPassword" class="auth-label">تأكيد كلمة المرور</label>
                <input asp-for="ConfirmPassword" type="password" class="auth-input"
                       placeholder="••••••••" dir="ltr" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="auth-btn">
                <i class="fas fa-user-plus"></i> إنشاء الحساب
            </button>
        </form>

        <hr class="auth-divider" />
        <p class="auth-footer">لديك حساب؟ <a asp-controller="Account" asp-action="Login">تسجيل الدخول</a></p>
        <p class="auth-footer">تسجيل كمعلم؟ <a asp-controller="Account" asp-action="Register">تسجيل معلم</a></p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
