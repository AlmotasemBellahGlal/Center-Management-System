@model Center_Management.Models.Exam
@{
    ViewData["Title"] = "تفاصيل الاختبار — " + Model.Title;
    int totalPoints = Model.Questions?.Sum(q => q.Points) ?? 0;
    int qCount = Model.Questions?.Count ?? 0;
    int aCount = Model.Attempts?.Count ?? 0;
    bool isActive = Model.StartDate <= DateTime.Now && Model.EndDate >= DateTime.Now;
    bool isPast = Model.EndDate < DateTime.Now;
}

<form id="tokenForm" class="exam-token-form">@Html.AntiForgeryToken()</form>

<div class="exam-page-shell exam-details-page">
    <header class="exam-page-heading">
        <div class="exam-page-heading__content">
            <span class="exam-page-heading__eyebrow">تفاصيل الاختبار</span>
            <div class="exam-page-heading__title-row">
                <span class="exam-page-heading__icon"><i class="fas fa-file-alt"></i></span>
                <div>
                    <div class="exam-details-title-line">
                        <h1 class="exam-page-heading__title">@Model.Title</h1>
                        @if (isActive)
                        { <span class="badge badge-success"><i class="fas fa-circle exam-live-dot"></i> نشط</span> }
                        else if (isPast)
                        { <span class="badge badge-neutral"><i class="fas fa-check"></i> منتهي</span> }
                        else
                        { <span class="badge badge-info"><i class="far fa-clock"></i> قادم</span> }
                    </div>
                    <p class="exam-page-heading__subtitle">@Model.Group?.Name · @Model.Group?.AcademicYear?.Name</p>
                </div>
            </div>
        </div>
        <div class="exam-page-heading__actions">
            <a href="@Url.Action("Index",new{groupId=Model.GroupId})" class="btn btn-neutral"><i class="fas fa-arrow-right"></i> رجوع</a>
            <a href="@Url.Action("Edit",new{id=Model.Id})" class="btn btn-ghost"><i class="fas fa-pen"></i> تعديل</a>
            <a href="@Url.Action("AddMultipleQuestions",new{examId=Model.Id})" class="btn btn-outline-primary"><i class="fas fa-layer-group"></i> عدة أسئلة</a>
            <a href="@Url.Action("AddQuestion",new{examId=Model.Id})" class="btn btn-primary"><i class="fas fa-plus"></i> سؤال واحد</a>
        </div>
    </header>

    <section class="exam-details-hero card">
        <div class="exam-details-hero__main">
            <span class="badge @(Model.Type == Center_Management.Models.ExamType.MCQ ? "badge-primary" : "badge-info")">
                <i class="fas @(Model.Type == Center_Management.Models.ExamType.MCQ ? "fa-list-check" : "fa-pen")"></i>
                @(Model.Type == Center_Management.Models.ExamType.MCQ ? "اختيار من متعدد" : "اختبار مقالي")
            </span>
            <h2>نافذة الاختبار</h2>
            <div class="exam-details-window">
                <div><small>تاريخ البدء</small><strong>@Model.StartDate.ToString("dd/MM/yyyy")</strong><span>@Model.StartDate.ToString("HH:mm")</span></div>
                <i class="fas fa-arrow-left"></i>
                <div><small>تاريخ الانتهاء</small><strong>@Model.EndDate.ToString("dd/MM/yyyy")</strong><span>@Model.EndDate.ToString("HH:mm")</span></div>
            </div>
        </div>
        <div class="exam-details-hero__stats">
            <div><span><i class="fas fa-circle-question"></i></span><strong>@qCount</strong><small>سؤال</small></div>
            <div><span><i class="fas fa-star"></i></span><strong>@totalPoints</strong><small>درجة كلية</small></div>
            <div><span><i class="fas fa-users"></i></span><strong>@aCount</strong><small>محاولة</small></div>
            @if (Model.DurationMinutes.HasValue)
            {
                <div><span><i class="fas fa-stopwatch"></i></span><strong>@Model.DurationMinutes</strong><small>دقيقة</small></div>
            }
        </div>
    </section>

    @if (!string.IsNullOrEmpty(Model.Description))
    {
        <section class="card exam-description-card">
            <span><i class="fas fa-align-right"></i></span>
            <div><strong>وصف وتعليمات الاختبار</strong><p>@Model.Description</p></div>
        </section>
    }

    <section class="card exam-content-section">
        <header class="card-header exam-content-section__header">
            <span class="card-header-icon"><i class="fas fa-list-ol"></i></span>
            <div><h2 class="card-title">أسئلة الاختبار</h2><p>المحتوى والإجابات المعتمدة بالترتيب.</p></div>
            <span class="badge badge-primary">@qCount سؤال</span>
        </header>

        @if (Model.Questions?.Any() != true)
        {
            <div class="empty-state exam-details-empty">
                <div class="empty-state__icon"><i class="fas fa-circle-question"></i></div>
                <h3 class="empty-state__title">الاختبار بلا أسئلة حتى الآن</h3>
                <p class="empty-state__text">أضف السؤال الأول ليصبح محتوى الاختبار جاهزاً للمراجعة.</p>
                <a href="@Url.Action("AddQuestion",new{examId=Model.Id})" class="btn btn-primary"><i class="fas fa-plus"></i> إضافة السؤال الأول</a>
            </div>
        }
        else
        {
            <div class="exam-teacher-question-list">
                @foreach (var q in Model.Questions.OrderBy(x => x.Order))
                {
                    <article class="exam-teacher-question">
                        <header class="exam-teacher-question__header">
                            <span class="exam-teacher-question__number">@q.Order</span>
                            <div><small>السؤال @q.Order</small><strong>@q.QuestionText</strong></div>
                            <span class="badge badge-gold">@q.Points نقطة</span>
                        </header>

                        @if (!string.IsNullOrEmpty(q.ImagePath))
                        {
                            <div class="exam-teacher-question__image"><img src="@q.ImagePath" alt="صورة السؤال @q.Order" /></div>
                        }

                        @if (Model.Type == Center_Management.Models.ExamType.MCQ)
                        {
                            <div class="exam-teacher-options">
                                @foreach (var (letter, text) in new[]{("A",q.OptionA),("B",q.OptionB),("C",q.OptionC),("D",q.OptionD)})
                                {
                                    <div class="exam-teacher-option @(q.CorrectAnswer == letter ? "exam-teacher-option--correct" : "")">
                                        <span>@letter</span>
                                        <p>@text</p>
                                        @if (q.CorrectAnswer == letter)
                                        { <strong><i class="fas fa-check"></i> الإجابة الصحيحة</strong> }
                                    </div>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

    @if (Model.Attempts?.Any() == true)
    {
        <section class="card exam-content-section exam-attempts-section">
            <header class="card-header exam-content-section__header">
                <span class="card-header-icon"><i class="fas fa-users"></i></span>
                <div><h2 class="card-title">محاولات الطلاب</h2><p>حالة التسليم والنتائج المسجلة لهذا الاختبار.</p></div>
                <span class="badge badge-success">@aCount محاولة</span>
                <button type="button" class="btn btn-outline-danger btn-sm" onclick="confirmResetAll(@Model.Id)"><i class="fas fa-rotate-left"></i> إعادة تعيين الكل</button>
            </header>
            <div class="exam-table-wrap">
                <table class="data-table exam-attempts-table">
                    <thead>
                        <tr><th>الطالب</th><th>بدأ</th><th>سلّم</th><th>الحالة</th><th>الدرجة</th><th>الإجراء</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var att in Model.Attempts.OrderByDescending(a => a.StartedAt))
                        {
                            <tr>
                                <td><div class="exam-student-cell"><span><i class="fas fa-user"></i></span><strong>@att.Student?.FullName</strong></div></td>
                                <td><span class="exam-table-date">@att.StartedAt.ToString("dd/MM HH:mm")</span></td>
                                <td><span class="exam-table-date">@(att.SubmittedAt?.ToString("dd/MM HH:mm") ?? "—")</span></td>
                                <td>
                                    @if (att.IsSubmitted)
                                    { <span class="badge badge-success"><i class="fas fa-check"></i> تم التسليم</span> }
                                    else
                                    { <span class="badge badge-warning"><i class="far fa-clock"></i> جاري</span> }
                                </td>
                                <td>
                                    @if (att.Score.HasValue)
                                    { <strong class="exam-table-score">@att.Score / @totalPoints</strong> }
                                    else if (Model.Type == Center_Management.Models.ExamType.Written && att.IsSubmitted)
                                    { <span class="exam-table-muted">يتطلب تصحيح</span> }
                                    else
                                    { <span class="exam-table-muted">—</span> }
                                </td>
                                <td>
                                    <button type="button" class="btn btn-ghost btn-sm exam-reset-button" onclick="confirmResetStudent(@Model.Id, @att.StudentId, '@att.Student?.FullName')"><i class="fas fa-rotate-left"></i> إعادة</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

@section Scripts {
<script>
function confirmResetStudent(examId, studentId, studentName) {
    if (confirm(`إعادة تعيين الاختبار للطالب: ${studentName}؟\nسيتم حذف محاولته.`)) {
        const form = document.createElement('form');
        form.method = 'POST'; form.action = '@Url.Action("ResetStudent")';
        form.innerHTML = `<input type="hidden" name="examId" value="${examId}"><input type="hidden" name="studentId" value="${studentId}"><input type="hidden" name="__RequestVerificationToken" value="${document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''}">`;
        document.body.appendChild(form); form.submit();
    }
}
function confirmResetAll(examId) {
    if (confirm('تحذير: سيتم حذف جميع محاولات الطلاب لهذا الاختبار.\nهل أنت متأكد؟')) {
        const form = document.createElement('form');
        form.method = 'POST'; form.action = '@Url.Action("ResetAll")';
        form.innerHTML = `<input type="hidden" name="examId" value="${examId}"><input type="hidden" name="__RequestVerificationToken" value="${document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''}">`;
        document.body.appendChild(form); form.submit();
    }
}
</script>
}
