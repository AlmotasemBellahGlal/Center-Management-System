@model Center_Management.Models.Exam
@{
    ViewData["Title"] = "تعديل الاختبار";
}

<div class="exam-page-shell exam-form-page">
    <header class="exam-page-heading exam-page-heading--compact">
        <div class="exam-page-heading__content">
            <span class="exam-page-heading__eyebrow">تحديث الإعدادات</span>
            <div class="exam-page-heading__title-row">
                <span class="exam-page-heading__icon"><i class="fas fa-pen-to-square"></i></span>
                <div>
                    <h1 class="exam-page-heading__title">تعديل الاختبار</h1>
                    <p class="exam-page-heading__subtitle">@Model.Group?.Name · @Model.Group?.AcademicYear?.Name</p>
                </div>
            </div>
        </div>
        <a href="@Url.Action("Details",new{id=Model.Id})" class="btn btn-neutral"><i class="fas fa-arrow-right"></i> رجوع للتفاصيل</a>
    </header>

    <form asp-action="Edit" method="post" class="exam-editor-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="GroupId" />
        <div asp-validation-summary="ModelOnly" class="exam-validation-summary" role="alert"></div>

        <div class="exam-form-layout">
            <main class="exam-form-layout__main">
                <section class="card exam-form-section">
                    <header class="card-header">
                        <span class="card-header-icon"><i class="fas fa-align-right"></i></span>
                        <div><h2 class="card-title">المعلومات الأساسية</h2><p>حدّث اسم الاختبار ووصفه وطريقة الإجابة.</p></div>
                    </header>
                    <div class="card-body exam-form-fields">
                        <div class="exam-field exam-field--wide">
                            <label asp-for="Title" class="exam-field__label">عنوان الاختبار <span>*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="عنوان الاختبار" />
                            <span asp-validation-for="Title" class="exam-field__error"></span>
                        </div>
                        <div class="exam-field exam-field--wide">
                            <label asp-for="Description" class="exam-field__label">الوصف <small>اختياري</small></label>
                            <textarea asp-for="Description" class="form-control exam-textarea" rows="4" placeholder="وصف الاختبار..."></textarea>
                            <span asp-validation-for="Description" class="exam-field__error"></span>
                        </div>
                        <div class="exam-field">
                            <label asp-for="Type" class="exam-field__label">نوع الاختبار <span>*</span></label>
                            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<Center_Management.Models.ExamType>()">
                                <option value="">— اختر —</option>
                            </select>
                            <span asp-validation-for="Type" class="exam-field__error"></span>
                        </div>
                        <div class="exam-field">
                            <label asp-for="DurationMinutes" class="exam-field__label">المدة بالدقائق <small>اختياري</small></label>
                            <div class="exam-input-with-icon"><i class="far fa-clock"></i><input asp-for="DurationMinutes" type="number" class="form-control" min="1" placeholder="اتركه فارغاً للوقت الكامل" /></div>
                            <span asp-validation-for="DurationMinutes" class="exam-field__error"></span>
                        </div>
                    </div>
                </section>

                <section class="card exam-form-section">
                    <header class="card-header">
                        <span class="card-header-icon"><i class="far fa-calendar"></i></span>
                        <div><h2 class="card-title">نافذة الإتاحة</h2><p>عدّل توقيت فتح الاختبار وإغلاقه للطلاب.</p></div>
                    </header>
                    <div class="card-body exam-form-fields">
                        <div class="exam-field">
                            <label asp-for="StartDate" class="exam-field__label">تاريخ البدء <span>*</span></label>
                            <input asp-for="StartDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="StartDate" class="exam-field__error"></span>
                        </div>
                        <div class="exam-field">
                            <label asp-for="EndDate" class="exam-field__label">تاريخ الانتهاء <span>*</span></label>
                            <input asp-for="EndDate" type="datetime-local" class="form-control" />
                            <span asp-validation-for="EndDate" class="exam-field__error"></span>
                        </div>
                    </div>
                </section>
            </main>

            <aside class="exam-form-layout__aside">
                <section class="card exam-context-card">
                    <span class="exam-context-card__icon"><i class="fas fa-file-alt"></i></span>
                    <small>الاختبار الحالي</small>
                    <strong>@Model.Title</strong>
                    <span>@Model.Group?.Name</span>
                </section>
                <section class="card exam-tip-card exam-tip-card--warning">
                    <i class="fas fa-circle-info"></i>
                    <div><strong>مراجعة التوقيت</strong><p>تأكد من أن تاريخ الانتهاء يأتي بعد تاريخ البدء وأن المدة مناسبة للطلاب.</p></div>
                </section>
            </aside>
        </div>

        <footer class="exam-form-actions">
            <span><i class="fas fa-rotate"></i> ستُطبق التعديلات على هذا الاختبار.</span>
            <div>
                <a href="@Url.Action("Details",new{id=Model.Id})" class="btn btn-neutral"><i class="fas fa-times"></i> إلغاء</a>
                <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-save"></i> حفظ التعديلات</button>
            </div>
        </footer>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
