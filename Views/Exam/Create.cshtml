@model Center_Management.Models.Exam
@{
    ViewData["Title"] = "إنشاء اختبار جديد";
    var group = ViewBag.Group as Center_Management.Models.Group;
}

<div class="exam-page-shell exam-form-page">
    <header class="exam-page-heading exam-page-heading--compact">
        <div class="exam-page-heading__content">
            <span class="exam-page-heading__eyebrow">إعداد اختبار</span>
            <div class="exam-page-heading__title-row">
                <span class="exam-page-heading__icon"><i class="fas fa-file-circle-plus"></i></span>
                <div>
                    <h1 class="exam-page-heading__title">إنشاء اختبار جديد</h1>
                    <p class="exam-page-heading__subtitle">@group?.Name · @group?.AcademicYear?.Name</p>
                </div>
            </div>
        </div>
        <a href="@Url.Action("Index",new{groupId=group?.Id})" class="btn btn-neutral"><i class="fas fa-arrow-right"></i> رجوع للاختبارات</a>
    </header>

    <form method="post" asp-action="Create" asp-route-groupId="@group?.Id" class="exam-editor-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="exam-validation-summary" role="alert"></div>

        <div class="exam-form-layout">
            <main class="exam-form-layout__main">
                <section class="card exam-form-section">
                    <header class="card-header">
                        <span class="card-header-icon"><i class="fas fa-align-right"></i></span>
                        <div><h2 class="card-title">المعلومات الأساسية</h2><p>عرّف الاختبار للطلاب بصورة واضحة ومختصرة.</p></div>
                    </header>
                    <div class="card-body exam-form-fields">
                        <div class="exam-field exam-field--wide">
                            <label asp-for="Title" class="exam-field__label">عنوان الاختبار <span>*</span></label>
                            <input type="text" class="form-control" asp-for="Title" placeholder="مثال: اختبار نصف الفصل الأول" required />
                            <span asp-validation-for="Title" class="exam-field__error"></span>
                        </div>
                        <div class="exam-field exam-field--wide">
                            <label asp-for="Description" class="exam-field__label">الوصف <small>اختياري</small></label>
                            <textarea class="form-control exam-textarea" asp-for="Description" rows="4" placeholder="أضف وصفاً مختصراً أو تعليمات تساعد الطلاب قبل البدء"></textarea>
                            <span asp-validation-for="Description" class="exam-field__error"></span>
                        </div>
                        <div class="exam-field">
                            <label asp-for="Type" class="exam-field__label">نوع الاختبار <span>*</span></label>
                            <select class="form-select" asp-for="Type" required>
                                <option value="">— اختر النوع —</option>
                                <option value="@Center_Management.Models.ExamType.MCQ">اختيار من متعدد (MCQ)</option>
                                <option value="@Center_Management.Models.ExamType.Written">أسئلة مقالية</option>
                            </select>
                            <span asp-validation-for="Type" class="exam-field__error"></span>
                        </div>
                        <div class="exam-field">
                            <label asp-for="DurationMinutes" class="exam-field__label">المدة بالدقائق <small>اختياري</small></label>
                            <div class="exam-input-with-icon"><i class="far fa-clock"></i><input type="number" class="form-control" name="DurationMinutes" id="DurationMinutes" value="@Model?.DurationMinutes" min="1" max="600" placeholder="مثال: 60" /></div>
                            <small class="exam-field__hint">اتركها فارغة للسماح بالحل حتى موعد الإغلاق.</small>
                            <span asp-validation-for="DurationMinutes" class="exam-field__error"></span>
                        </div>
                    </div>
                </section>

                <section class="card exam-form-section">
                    <header class="card-header">
                        <span class="card-header-icon"><i class="far fa-calendar"></i></span>
                        <div><h2 class="card-title">نافذة الإتاحة</h2><p>حدد متى يظهر الاختبار للطلاب ومتى يُغلق.</p></div>
                    </header>
                    <div class="card-body exam-form-fields">
                        <div class="exam-field">
                            <label asp-for="StartDate" class="exam-field__label">تاريخ البدء <span>*</span></label>
                            <input type="datetime-local" class="form-control" name="StartDate" id="StartDate" value="@(Model?.StartDate.ToString("yyyy-MM-ddTHH:mm"))" required />
                            <span asp-validation-for="StartDate" class="exam-field__error"></span>
                        </div>
                        <div class="exam-field">
                            <label asp-for="EndDate" class="exam-field__label">تاريخ الانتهاء <span>*</span></label>
                            <input type="datetime-local" class="form-control" name="EndDate" id="EndDate" value="@(Model?.EndDate.ToString("yyyy-MM-ddTHH:mm"))" required />
                            <span asp-validation-for="EndDate" class="exam-field__error"></span>
                        </div>
                    </div>
                </section>
            </main>

            <aside class="exam-form-layout__aside">
                <section class="card exam-context-card">
                    <span class="exam-context-card__icon"><i class="fas fa-users"></i></span>
                    <small>المجموعة المستهدفة</small>
                    <strong>@group?.Name</strong>
                    <span>@group?.AcademicYear?.Name</span>
                </section>
                <section class="card exam-tip-card">
                    <i class="fas fa-lightbulb"></i>
                    <div><strong>بعد الإنشاء</strong><p>ستنتقل إلى صفحة التفاصيل لتضيف سؤالاً واحداً أو عدة أسئلة دفعة واحدة.</p></div>
                </section>
            </aside>
        </div>

        <footer class="exam-form-actions">
            <span><i class="fas fa-shield-alt"></i> لن يصبح الاختبار جاهزاً قبل إضافة الأسئلة.</span>
            <div>
                <a href="@Url.Action("Index",new{groupId=group?.Id})" class="btn btn-neutral"><i class="fas fa-times"></i> إلغاء</a>
                <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-arrow-left"></i> إنشاء والمتابعة</button>
            </div>
        </footer>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
