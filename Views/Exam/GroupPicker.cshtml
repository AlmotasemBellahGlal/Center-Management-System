@model IEnumerable<Center_Management.Models.Group>
@{
    ViewData["Title"] = "الاختبارات — اختر مجموعة";
    var groupsByYear = Model.GroupBy(g => g.AcademicYear).OrderBy(g => g.Key?.Name);
}

<div class="exam-page-shell">
    <header class="exam-page-heading exam-page-heading--feature">
        <div class="exam-page-heading__content">
            <span class="exam-page-heading__eyebrow">مساحة التقييمات</span>
            <div class="exam-page-heading__title-row">
                <span class="exam-page-heading__icon"><i class="fas fa-file-circle-check"></i></span>
                <div>
                    <h1 class="exam-page-heading__title">إدارة الاختبارات</h1>
                    <p class="exam-page-heading__subtitle">اختر المجموعة التي تريد إنشاء اختبارات لها أو مراجعة محاولات طلابها.</p>
                </div>
            </div>
        </div>
        <span class="exam-count-chip"><strong>@Model.Count()</strong> مجموعة</span>
    </header>

    <div class="exam-picker-toolbar">
        <label class="exam-search-field" for="groupSearch">
            <i class="fas fa-search"></i>
            <input type="search" id="groupSearch" placeholder="ابحث باسم المجموعة..." onkeyup="filterGroups()" autocomplete="off" />
            <span class="exam-search-field__hint">بحث فوري</span>
        </label>
    </div>

    @if (!Model.Any())
    {
        <div class="card exam-empty-card">
            <div class="empty-state">
                <div class="empty-state__icon"><i class="fas fa-layer-group"></i></div>
                <h2 class="empty-state__title">لا توجد مجموعات</h2>
                <p class="empty-state__text">أنشئ سنة دراسية ومجموعة أولاً، ثم عد لإدارة الاختبارات.</p>
            </div>
        </div>
    }
    else
    {
        <div id="groupPickerDirectory">
            @foreach (var yearGroup in groupsByYear)
            {
                <section class="exam-year-section">
                    <header class="exam-year-section__header">
                        <span class="exam-year-section__icon"><i class="fas fa-graduation-cap"></i></span>
                        <div>
                            <h2>@yearGroup.Key?.Name</h2>
                            <p>المجموعات المرتبطة بهذه السنة الدراسية</p>
                        </div>
                        <span class="badge badge-primary">@yearGroup.Count() مجموعة</span>
                    </header>

                    <div class="exam-group-picker-grid">
                        @foreach (var group in yearGroup)
                        {
                            int studentCount = group.StudentGroups?.Count(sg => sg.IsActive) ?? 0;
                            string schedText = string.Join(" · ", group.Schedules?.Select(s => $"{s.Day} {s.StartTime:HH:mm}") ?? new List<string>());
                            <a href="@Url.Action("Index","Exam",new{groupId=group.Id})"
                               class="card exam-group-picker-card"
                               data-name="@group.Name.ToLower()">
                                <span class="exam-group-picker-card__icon"><i class="fas fa-users"></i></span>
                                <div class="exam-group-picker-card__content">
                                    <h3>@group.Name</h3>
                                    <div class="exam-group-picker-card__meta">
                                        @if (!string.IsNullOrEmpty(schedText))
                                        {
                                            <span><i class="far fa-clock"></i> @schedText</span>
                                        }
                                        <span><i class="fas fa-user-graduate"></i> @studentCount طالب</span>
                                    </div>
                                </div>
                                <span class="exam-group-picker-card__action">عرض الاختبارات <i class="fas fa-arrow-left"></i></span>
                            </a>
                        }
                    </div>
                </section>
            }
        </div>
        <div class="card exam-no-search-results" id="groupSearchEmpty" hidden>
            <div class="empty-state">
                <div class="empty-state__icon"><i class="fas fa-search"></i></div>
                <h2 class="empty-state__title">لا توجد مجموعة مطابقة</h2>
                <p class="empty-state__text">جرّب كتابة جزء مختلف من اسم المجموعة.</p>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
function filterGroups() {
    const q = document.getElementById('groupSearch').value.toLowerCase().trim();
    const cards = Array.from(document.querySelectorAll('.exam-group-picker-card'));
    let visibleCount = 0;

    cards.forEach(card => {
        const matches = !q || (card.dataset.name || '').includes(q);
        card.hidden = !matches;
        if (matches) visibleCount++;
    });

    document.querySelectorAll('.exam-year-section').forEach(section => {
        section.hidden = !Array.from(section.querySelectorAll('.exam-group-picker-card')).some(card => !card.hidden);
    });

    const empty = document.getElementById('groupSearchEmpty');
    if (empty) empty.hidden = visibleCount !== 0;
}
</script>
}
