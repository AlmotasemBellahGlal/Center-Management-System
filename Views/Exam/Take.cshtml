@model Center_Management.Models.Exam
@{
    ViewData["Title"] = Model.Title;
    var attempt = ViewBag.Attempt as Center_Management.Models.StudentExamAttempt;
    var deadlineTime = (DateTime)ViewBag.DeadlineTime;
    var durationMinutes = ViewBag.DurationMinutes as int?;
    var orderedQuestions = (Model.Questions ?? new List<Center_Management.Models.ExamQuestion>()).OrderBy(q => q.Order).ToList();
    var totalPoints = orderedQuestions.Sum(q => q.Points);
    var questionCount = orderedQuestions.Count;
}

<div class="exam-take-page">
    <header class="exam-take-header">
        <div class="exam-take-header__identity">
            <span class="exam-take-header__icon"><i class="fas fa-pen-to-square"></i></span>
            <div>
                <span class="exam-take-header__eyebrow">اختبار جارٍ</span>
                <h1>@Model.Title</h1>
                <p>@Model.Group?.Name</p>
            </div>
        </div>
        <div class="exam-take-timer" id="timer" aria-live="polite">
            <span><i class="far fa-clock"></i></span>
            <div><small>الوقت المتبقي</small><strong id="timeLeft">—</strong></div>
        </div>
    </header>

    <section class="exam-take-overview" aria-label="معلومات الاختبار">
        <div><i class="fas fa-circle-question"></i><span><strong>@questionCount</strong> سؤال</span></div>
        <div><i class="fas fa-star"></i><span><strong>@totalPoints</strong> نقطة</span></div>
        @if (durationMinutes.HasValue)
        {
            <div><i class="fas fa-stopwatch"></i><span>مدة الحل <strong>@durationMinutes دقيقة</strong></span></div>
        }
        <div><i class="fas fa-shield-alt"></i><span><strong>محاولة واحدة</strong> فقط</span></div>
    </section>

    <form method="post" asp-action="Submit" asp-route-attemptId="@attempt?.Id" id="examForm" class="exam-take-form">
        @Html.AntiForgeryToken()

        <div class="exam-take-layout">
            <main class="exam-take-questions">
                @{ int questionNumber = 1; }
                @foreach (var question in orderedQuestions)
                {
                    <article class="card exam-take-question @(!string.IsNullOrEmpty(question.ImagePath) ? "exam-take-question--with-image" : "")" id="question-@question.Id" data-question-id="@question.Id">
                        <header class="exam-take-question__header">
                            <span class="exam-take-question__number">@questionNumber</span>
                            <div>
                                <small>السؤال @questionNumber من @questionCount</small>
                                <strong>@(Model.Type == Center_Management.Models.ExamType.MCQ ? "اختر الإجابة الأنسب" : "اكتب إجابتك بوضوح")</strong>
                            </div>
                            <span class="badge badge-gold">@question.Points نقطة</span>
                        </header>

                        <div class="exam-take-question__body">
                            <div class="exam-take-question__content">
                                <h2>@question.QuestionText</h2>

                                @if (Model.Type == Center_Management.Models.ExamType.MCQ)
                                {
                                    <div class="exam-answer-options">
                                        <label class="exam-answer-option">
                                            <input type="radio" name="answers[@question.Id]" value="A" required />
                                            <span class="exam-answer-option__indicator"><i class="fas fa-check"></i></span>
                                            <span class="exam-answer-option__letter">A</span>
                                            <span class="exam-answer-option__text">@question.OptionA</span>
                                        </label>
                                        <label class="exam-answer-option">
                                            <input type="radio" name="answers[@question.Id]" value="B" required />
                                            <span class="exam-answer-option__indicator"><i class="fas fa-check"></i></span>
                                            <span class="exam-answer-option__letter">B</span>
                                            <span class="exam-answer-option__text">@question.OptionB</span>
                                        </label>
                                        <label class="exam-answer-option">
                                            <input type="radio" name="answers[@question.Id]" value="C" required />
                                            <span class="exam-answer-option__indicator"><i class="fas fa-check"></i></span>
                                            <span class="exam-answer-option__letter">C</span>
                                            <span class="exam-answer-option__text">@question.OptionC</span>
                                        </label>
                                        <label class="exam-answer-option">
                                            <input type="radio" name="answers[@question.Id]" value="D" required />
                                            <span class="exam-answer-option__indicator"><i class="fas fa-check"></i></span>
                                            <span class="exam-answer-option__letter">D</span>
                                            <span class="exam-answer-option__text">@question.OptionD</span>
                                        </label>
                                    </div>
                                }
                                else
                                {
                                    <label class="exam-written-answer">
                                        <span>إجابتك</span>
                                        <textarea name="answers[@question.Id]" class="form-control exam-textarea" rows="7" placeholder="اكتب إجابتك هنا..." required></textarea>
                                        <small>اكتب إجابة واضحة ومنظمة، ويمكنك مراجعتها قبل التسليم.</small>
                                    </label>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(question.ImagePath))
                            {
                                <figure class="exam-take-question__image">
                                    <img src="@question.ImagePath" alt="صورة السؤال @questionNumber" />
                                </figure>
                            }
                        </div>
                    </article>

                    questionNumber++;
                }
            </main>

            <aside class="exam-take-sidebar">
                <section class="card exam-take-progress">
                    <header><span><i class="fas fa-list-check"></i></span><div><strong>تقدمك</strong><small id="answeredLabel" aria-live="polite">0 من @questionCount تمت إجابتها</small></div></header>
                    <div class="exam-take-progress__track" role="progressbar" aria-valuemin="0" aria-valuemax="@questionCount" aria-valuenow="0" id="examProgressTrack"><span id="examProgressBar"></span></div>
                    <div class="exam-take-progress__numbers">
                        @{ int navigatorNumber = 1; }
                        @foreach (var question in orderedQuestions)
                        {
                            <a href="#question-@question.Id" data-nav-question="@question.Id" aria-label="الانتقال إلى السؤال @navigatorNumber">@navigatorNumber</a>
                            navigatorNumber++;
                        }
                    </div>
                    <div class="exam-take-progress__legend"><span><i></i> لم تتم الإجابة</span><span><i></i> تمت الإجابة</span></div>
                </section>

                <section class="card exam-take-reminder">
                    <i class="fas fa-circle-info"></i>
                    <div><strong>تذكير هادئ</strong><p>راجع الأسئلة غير المكتملة، ثم سلّم عندما تكون جاهزاً. لن تتمكن من العودة بعد التسليم.</p></div>
                </section>
            </aside>
        </div>

        <footer class="exam-submit-dock">
            <div class="exam-submit-dock__status">
                <span><i class="fas fa-shield-alt"></i></span>
                <div><strong>جاهز للتسليم؟</strong><small>تأكد من إجابة جميع الأسئلة قبل الإرسال النهائي.</small></div>
            </div>
            <button type="submit" class="btn btn-success btn-lg" id="submitExamButton" onclick="return confirmSubmit()"><i class="fas fa-paper-plane"></i><span>تسليم الاختبار</span></button>
        </footer>
    </form>
</div>

@section Scripts {
<script>
// الموعد النهائي للطالب (محسوب من السيرفر)
const deadlineTime = new Date('@deadlineTime.ToString("yyyy-MM-ddTHH:mm:ss")');
let autoSubmitted = false;

function updateTimer() {
    const now = new Date();
    const diff = deadlineTime - now;

    if (diff <= 0) {
        document.getElementById('timeLeft').textContent = 'انتهى الوقت';
        if (!autoSubmitted) {
            autoSubmitted = true;
            alert('انتهى الوقت! سيتم تسليم الاختبار تلقائياً.');
            document.getElementById('examForm').submit();
        }
        return;
    }

    const hours = Math.floor(diff / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
    const seconds = Math.floor((diff % (1000 * 60)) / 1000);

    let timeText = '';
    if (hours > 0) timeText += hours + ' ساعة ';
    if (minutes > 0 || hours > 0) timeText += minutes + ' دقيقة ';
    timeText += seconds + ' ثانية';
    document.getElementById('timeLeft').textContent = timeText;

    if (diff < 5 * 60 * 1000) {
        document.getElementById('timer').classList.add('exam-take-timer--urgent');
    }
}

updateTimer();
const timerInterval = setInterval(updateTimer, 1000);

// Confirm before submit (manual)
function confirmSubmit() {
    return confirm('هل أنت متأكد من تسليم الاختبار؟ لن تتمكن من العودة بعد التسليم.');
}

// Auto-submit when leaving page (back button, close tab, etc.)
let isSubmitting = false;
let hasAutoSubmitted = false;

document.getElementById('examForm').addEventListener('submit', function() {
    isSubmitting = true;
    const button = document.getElementById('submitExamButton');
    button.disabled = true;
    button.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>جاري التسليم...</span>';
});

function updateExamProgress() {
    const questions = Array.from(document.querySelectorAll('[data-question-id]'));
    let answered = 0;

    questions.forEach(question => {
        const questionId = question.dataset.questionId;
        const radio = question.querySelector('input[type="radio"]:checked');
        const textarea = question.querySelector('textarea');
        const isAnswered = Boolean(radio || (textarea && textarea.value.trim()));
        const navItem = document.querySelector(`[data-nav-question="${questionId}"]`);
        question.classList.toggle('is-answered', isAnswered);
        if (navItem) navItem.classList.toggle('is-answered', isAnswered);
        if (isAnswered) answered++;
    });

    const total = questions.length;
    const percentage = total ? (answered / total) * 100 : 0;
    document.getElementById('answeredLabel').textContent = `${answered} من ${total} تمت إجابتها`;
    document.getElementById('examProgressBar').style.width = `${percentage}%`;
    document.getElementById('examProgressTrack').setAttribute('aria-valuenow', answered);
}

document.querySelectorAll('.exam-take-question input, .exam-take-question textarea').forEach(field => {
    field.addEventListener('input', updateExamProgress);
    field.addEventListener('change', updateExamProgress);
});
updateExamProgress();

// Function to auto-submit exam
function autoSubmitExam() {
    if (hasAutoSubmitted || isSubmitting) {
        return;
    }

    hasAutoSubmitted = true;
    const formData = new FormData(document.getElementById('examForm'));
    const params = new URLSearchParams();

    for (let [key, value] of formData.entries()) {
        if (key.startsWith('answers[')) {
            params.append(key, value);
        }
    }

    const success = navigator.sendBeacon(
        '@Url.Action("AutoSubmit", "Exam")?attemptId=@attempt?.Id',
        params
    );

    console.log('Auto-submit beacon sent:', success);
}

window.addEventListener('beforeunload', function (e) {
    if (!isSubmitting && !hasAutoSubmitted) {
        autoSubmitExam();
    }
});

document.addEventListener('visibilitychange', function() {
    if (document.hidden && !autoSubmitted && !hasAutoSubmitted && !isSubmitting) {
        autoSubmitExam();
    }
});

window.addEventListener('pagehide', function() {
    if (!isSubmitting && !hasAutoSubmitted) {
        autoSubmitExam();
    }
});
</script>
}
