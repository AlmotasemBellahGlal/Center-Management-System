@model IEnumerable<Center_Management.Models.Exam>
@{
    ViewData["Title"] = "اختباراتي";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="exam-page-shell exam-student-directory">
    <header class="exam-page-heading exam-page-heading--quiet">
        <div class="exam-page-heading__content">
            <span class="exam-page-heading__eyebrow">مساحة الطالب</span>
            <div class="exam-page-heading__title-row">
                <span class="exam-page-heading__icon"><i class="fas fa-book-open"></i></span>
                <div>
                    <h1 class="exam-page-heading__title">اختباراتي</h1>
                    <p class="exam-page-heading__subtitle">راجع مواعيد اختباراتك وحالتها، وابدأ عندما تكون مستعداً.</p>
                </div>
            </div>
        </div>
        <span class="exam-count-chip"><strong>@Model.Count()</strong> اختبار</span>
    </header>

    @if (ViewBag.Error != null)
    {
        <div class="exam-alert exam-alert--danger" role="alert"><i class="fas fa-circle-exclamation"></i><span>@ViewBag.Error</span></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="exam-alert exam-alert--danger" role="alert"><i class="fas fa-circle-exclamation"></i><span>@TempData["Error"]</span></div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="exam-alert exam-alert--success" role="status"><i class="fas fa-circle-check"></i><span>@TempData["Success"]</span></div>
    }

    @if (!Model.Any())
    {
        <div class="card exam-empty-card">
            <div class="empty-state">
                <div class="empty-state__icon"><i class="fas fa-calendar-check"></i></div>
                <h2 class="empty-state__title">لا توجد اختبارات متاحة</h2>
                <p class="empty-state__text">ستظهر هنا الاختبارات المتاحة لمجموعاتك عندما يحين موعدها.</p>
            </div>
        </div>
    }
    else
    {
        <div class="exam-student-grid">
            @foreach (var exam in Model)
            {
                int qCount = exam.Questions?.Count ?? 0;
                int totalPts = exam.Questions?.Sum(q => q.Points) ?? 0;
                var attempt = exam.Attempts?.FirstOrDefault();
                bool hasCompleted = attempt != null && attempt.IsSubmitted;
                var now = DateTime.Now;
                bool canTake = !hasCompleted && now >= exam.StartDate && now <= exam.EndDate;
                var timeLeft = exam.EndDate - now;

                string statusClass = hasCompleted ? "badge-success" : canTake ? "badge-primary" : now < exam.StartDate ? "badge-info" : "badge-neutral";
                string statusText = hasCompleted ? "مكتمل" : canTake ? "متاح الآن" : now < exam.StartDate ? "قريباً" : "انتهى";
                string statusIcon = hasCompleted ? "fa-circle-check" : canTake ? "fa-circle-play" : now < exam.StartDate ? "fa-hourglass-start" : "fa-circle-xmark";

                <article class="card exam-student-card @(hasCompleted ? "exam-student-card--complete" : "")">
                    <header class="exam-student-card__header">
                        <span class="exam-student-card__subject-icon"><i class="fas @(exam.Type == Center_Management.Models.ExamType.MCQ ? "fa-list-check" : "fa-pen-to-square")"></i></span>
                        <div>
                            <span class="exam-student-card__group">@exam.Group?.Name</span>
                            <span class="badge @statusClass"><i class="fas @statusIcon"></i> @statusText</span>
                        </div>
                    </header>

                    <div class="exam-student-card__body">
                        <h2 class="exam-student-card__title">@exam.Title</h2>
                        @if (!string.IsNullOrEmpty(exam.Description))
                        {
                            <p class="exam-student-card__description">@exam.Description</p>
                        }

                        <div class="exam-student-card__facts">
                            <span><i class="fas fa-circle-question"></i><strong>@qCount</strong> سؤال</span>
                            <span><i class="fas fa-star"></i><strong>@totalPts</strong> نقطة</span>
                            <span><i class="far fa-calendar-check"></i> ينتهي @exam.EndDate.ToString("dd/MM/yyyy")</span>
                            @if (canTake && timeLeft.TotalHours < 24)
                            {
                                <span class="exam-student-card__urgent"><i class="fas fa-clock"></i> متبقي @((int)timeLeft.TotalHours) ساعة</span>
                            }
                        </div>

                        @if (hasCompleted && attempt != null)
                        {
                            @if (attempt.Score.HasValue)
                            {
                                double pct = totalPts > 0 ? attempt.Score.Value * 100.0 / totalPts : 0;
                                bool pass = pct >= 50;
                                <div class="exam-student-score @(pass ? "exam-student-score--pass" : "exam-student-score--review")">
                                    <span><small>النتيجة</small><strong>@attempt.Score / @totalPts</strong></span>
                                    <span class="exam-student-score__percent">@pct.ToString("F0")%</span>
                                </div>
                            }
                            else if (exam.Type == Center_Management.Models.ExamType.Written)
                            {
                                <div class="exam-pending-note"><i class="fas fa-hourglass-half"></i> في انتظار التصحيح</div>
                            }
                        }
                    </div>

                    <footer class="exam-student-card__footer">
                        @if (hasCompleted)
                        {
                            <a href="@Url.Action("Result",new{id=exam.Id})" class="btn btn-primary"><i class="fas fa-chart-simple"></i> عرض النتيجة والمراجعة</a>
                        }
                        else if (canTake)
                        {
                            <a href="@Url.Action("Take",new{id=exam.Id})" class="btn btn-success"><i class="fas fa-play"></i> ابدأ الاختبار</a>
                        }
                        else if (now < exam.StartDate)
                        {
                            <button type="button" class="btn btn-neutral" disabled><i class="fas fa-lock"></i> يبدأ @exam.StartDate.ToString("dd/MM/yyyy")</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-neutral" disabled><i class="fas fa-circle-xmark"></i> انتهى الاختبار</button>
                        }
                    </footer>
                </article>
            }
        </div>
    }
</div>
