@model Center_Management.Models.StudentExamAttempt
@{
    ViewData["Title"] = "نتيجة الاختبار";
    var totalPoints = Model.Exam?.Questions?.Sum(q => q.Points) ?? 0;
    var percentage = totalPoints > 0 && Model.Score.HasValue ? (Model.Score.Value * 100.0 / totalPoints) : 0;
    var isPassed = percentage >= 50;
    var questionCount = Model.Exam?.Questions?.Count ?? 0;
    var correctCount = Model.Answers?.Count(answer => answer.IsCorrect == true) ?? 0;
    var incorrectCount = questionCount - correctCount;
}

<div class="exam-page-shell exam-result-page">
    <header class="exam-page-heading exam-page-heading--quiet">
        <div class="exam-page-heading__content">
            <span class="exam-page-heading__eyebrow">ملخص المحاولة</span>
            <div class="exam-page-heading__title-row">
                <span class="exam-page-heading__icon"><i class="fas fa-chart-simple"></i></span>
                <div>
                    <h1 class="exam-page-heading__title">نتيجة الاختبار</h1>
                    <p class="exam-page-heading__subtitle">@Model.Exam?.Title</p>
                </div>
            </div>
        </div>
        <a href="@Url.Action("MyExams")" class="btn btn-neutral"><i class="fas fa-arrow-right"></i> رجوع لاختباراتي</a>
    </header>

    @if (Model.Score.HasValue)
    {
        <section class="card exam-result-hero @(isPassed ? "exam-result-hero--pass" : "exam-result-hero--review")">
            <div class="exam-result-hero__score">
                <span class="exam-result-hero__icon"><i class="fas @(isPassed ? "fa-circle-check" : "fa-chart-line")"></i></span>
                <small>درجتك النهائية</small>
                <div><strong>@Model.Score</strong><span>/ @totalPoints</span></div>
                <p>@percentage.ToString("F1")%</p>
                <span class="badge @(isPassed ? "badge-success" : "badge-warning")">
                    <i class="fas @(isPassed ? "fa-check" : "fa-circle-info")"></i>
                    @(isPassed ? "اجتزت الاختبار" : "تحتاج إلى مراجعة")
                </span>
            </div>

            <div class="exam-result-hero__details">
                <div class="exam-result-message">
                    <span><i class="fas fa-lightbulb"></i></span>
                    <div>
                        <h2>@(isPassed ? "أحسنت، أكملت الاختبار بنجاح" : "المحاولة مكتملة، راجع إجاباتك بهدوء")</h2>
                        <p>يعرض الملخص أدناه نتيجتك ووقت الحل، ثم يمكنك مراجعة كل إجابة ومعرفة الاختيار الصحيح.</p>
                    </div>
                </div>
                <div class="exam-result-stats">
                    <div><span><i class="fas fa-star"></i></span><strong>@totalPoints</strong><small>إجمالي النقاط</small></div>
                    <div><span><i class="fas fa-check"></i></span><strong>@correctCount</strong><small>إجابة صحيحة</small></div>
                    <div><span><i class="fas fa-xmark"></i></span><strong>@incorrectCount</strong><small>غير صحيحة</small></div>
                    <div>
                        <span><i class="far fa-clock"></i></span>
                        <strong>
                            @if (Model.SubmittedAt.HasValue)
                            {
                                var duration = Model.SubmittedAt.Value - Model.StartedAt;
                                @($"{(int)duration.TotalMinutes} دقيقة")
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </strong>
                        <small>مدة الحل</small>
                    </div>
                </div>
            </div>
        </section>
    }
    else
    {
        <section class="card exam-result-pending">
            <span class="exam-result-pending__icon"><i class="fas fa-hourglass-half"></i></span>
            <div>
                <span class="exam-page-heading__eyebrow">تم استلام إجاباتك</span>
                <h2>في انتظار التصحيح</h2>
                <p>لقد أكملت الاختبار بنجاح. سيقوم المعلم بتصحيح إجاباتك وستظهر النتيجة قريباً.</p>
                <span class="exam-result-pending__date"><i class="far fa-calendar-check"></i> تم التسليم في: @Model.SubmittedAt?.ToString("dd/MM/yyyy hh:mm tt")</span>
            </div>
        </section>
    }

    @if (Model.Exam?.Type == Center_Management.Models.ExamType.MCQ && Model.Score.HasValue)
    {
        <section class="card exam-review-section">
            <header class="card-header exam-content-section__header">
                <span class="card-header-icon"><i class="fas fa-list-check"></i></span>
                <div><h2 class="card-title">مراجعة الإجابات</h2><p>اختيارك مقارنة بالإجابة الصحيحة لكل سؤال.</p></div>
                <div class="exam-review-legend"><span><i></i> صحيحة</span><span><i></i> تحتاج مراجعة</span></div>
            </header>

            <div class="exam-review-list">
                @{ int questionNumber = 1; }
                @foreach (var question in Model.Exam.Questions.OrderBy(q => q.Order))
                {
                    var studentAnswer = Model.Answers?.FirstOrDefault(a => a.QuestionId == question.Id);
                    var isCorrect = studentAnswer?.IsCorrect ?? false;

                    <article class="exam-review-question @(isCorrect ? "exam-review-question--correct" : "exam-review-question--incorrect")">
                        <header class="exam-review-question__header">
                            <span class="exam-review-question__number">@questionNumber</span>
                            <div><small>السؤال @questionNumber</small><h3>@question.QuestionText</h3></div>
                            <span class="badge @(isCorrect ? "badge-success" : "badge-danger")">
                                <i class="fas @(isCorrect ? "fa-check" : "fa-xmark")"></i>
                                @(isCorrect ? "إجابة صحيحة" : "إجابة خاطئة")
                            </span>
                            <span class="badge badge-gold">@question.Points نقطة</span>
                        </header>

                        <div class="exam-review-options">
                            <div class="exam-review-option @(question.CorrectAnswer == "A" ? "exam-review-option--correct" : "") @(studentAnswer?.AnswerText == "A" && !isCorrect ? "exam-review-option--selected-wrong" : "")">
                                <span class="exam-review-option__letter">A</span><span class="exam-review-option__text">@question.OptionA</span>
                                <span class="exam-review-option__marks">
                                    @if (question.CorrectAnswer == "A") { <small><i class="fas fa-check"></i> الإجابة الصحيحة</small> }
                                    @if (studentAnswer?.AnswerText == "A") { <small><i class="fas fa-hand-pointer"></i> اختيارك</small> }
                                </span>
                            </div>
                            <div class="exam-review-option @(question.CorrectAnswer == "B" ? "exam-review-option--correct" : "") @(studentAnswer?.AnswerText == "B" && !isCorrect ? "exam-review-option--selected-wrong" : "")">
                                <span class="exam-review-option__letter">B</span><span class="exam-review-option__text">@question.OptionB</span>
                                <span class="exam-review-option__marks">
                                    @if (question.CorrectAnswer == "B") { <small><i class="fas fa-check"></i> الإجابة الصحيحة</small> }
                                    @if (studentAnswer?.AnswerText == "B") { <small><i class="fas fa-hand-pointer"></i> اختيارك</small> }
                                </span>
                            </div>
                            <div class="exam-review-option @(question.CorrectAnswer == "C" ? "exam-review-option--correct" : "") @(studentAnswer?.AnswerText == "C" && !isCorrect ? "exam-review-option--selected-wrong" : "")">
                                <span class="exam-review-option__letter">C</span><span class="exam-review-option__text">@question.OptionC</span>
                                <span class="exam-review-option__marks">
                                    @if (question.CorrectAnswer == "C") { <small><i class="fas fa-check"></i> الإجابة الصحيحة</small> }
                                    @if (studentAnswer?.AnswerText == "C") { <small><i class="fas fa-hand-pointer"></i> اختيارك</small> }
                                </span>
                            </div>
                            <div class="exam-review-option @(question.CorrectAnswer == "D" ? "exam-review-option--correct" : "") @(studentAnswer?.AnswerText == "D" && !isCorrect ? "exam-review-option--selected-wrong" : "")">
                                <span class="exam-review-option__letter">D</span><span class="exam-review-option__text">@question.OptionD</span>
                                <span class="exam-review-option__marks">
                                    @if (question.CorrectAnswer == "D") { <small><i class="fas fa-check"></i> الإجابة الصحيحة</small> }
                                    @if (studentAnswer?.AnswerText == "D") { <small><i class="fas fa-hand-pointer"></i> اختيارك</small> }
                                </span>
                            </div>
                        </div>
                    </article>

                    questionNumber++;
                }
            </div>
        </section>
    }
</div>
