@model Center_Management.Models.StudentExamAttempt
@{
    ViewData["Title"] = "نتيجة الاختبار";
    var totalPoints = Model.Exam?.Questions?.Sum(q => q.Points) ?? 0;
    var percentage = totalPoints > 0 && Model.Score.HasValue ? (Model.Score.Value * 100.0 / totalPoints) : 0;
    var isPassed = percentage >= 50;
}

@* ── Page Header ── *@
<div class="page-header page-header--@(isPassed ? "success" : "warning")">
    <div class="page-header__actions">
        <a href="@Url.Action("MyExams")" class="btn btn--outline-white btn--sm">
            <i class="fas fa-arrow-right"></i>
            رجوع للاختبارات
        </a>
    </div>
    <div class="page-header__icon">
        <i class="fas fa-chart-bar"></i>
    </div>
    <div class="page-header__content">
        <h1 class="page-header__title">نتيجة الاختبار</h1>
        <p class="page-header__subtitle">@Model.Exam?.Title</p>
    </div>
</div>

@* ── Score Summary ── *@
<div class="score-summary">
    @if (Model.Score.HasValue)
    {
        <div class="score-circle @(isPassed ? "score-circle--pass" : "score-circle--fail")">
            <div class="score-circle__inner">
                <div class="score-circle__score">@Model.Score/@totalPoints</div>
                <div class="score-circle__percent">@percentage.ToString("F1")%</div>
                <div class="score-circle__status">
                    @if (isPassed)
                    {
                        <i class="fas fa-check-circle"></i>
                        <span>نجحت</span>
                    }
                    else
                    {
                        <i class="fas fa-times-circle"></i>
                        <span>لم تنجح</span>
                    }
                </div>
            </div>
        </div>

        <div class="score-stats">
            <div class="stat-item stat-item--total">
                <div class="stat-item__icon"><i class="fas fa-star"></i></div>
                <div class="stat-item__content">
                    <div class="stat-item__value">@totalPoints</div>
                    <div class="stat-item__label">إجمالي النقاط</div>
                </div>
            </div>

            <div class="stat-item stat-item--score">
                <div class="stat-item__icon"><i class="fas fa-trophy"></i></div>
                <div class="stat-item__content">
                    <div class="stat-item__value">@Model.Score</div>
                    <div class="stat-item__label">درجتك</div>
                </div>
            </div>

            <div class="stat-item stat-item--percent">
                <div class="stat-item__icon"><i class="fas fa-percentage"></i></div>
                <div class="stat-item__content">
                    <div class="stat-item__value">@percentage.ToString("F1")%</div>
                    <div class="stat-item__label">النسبة المئوية</div>
                </div>
            </div>

            <div class="stat-item stat-item--time">
                <div class="stat-item__icon"><i class="fas fa-clock"></i></div>
                <div class="stat-item__content">
                    <div class="stat-item__value">
                        @if (Model.SubmittedAt.HasValue)
                        {
                            var duration = Model.SubmittedAt.Value - Model.StartedAt;
                            @($"{(int)duration.TotalMinutes} دقيقة")
                        }
                        else
                        {
                            <span>-</span>
                        }
                    </div>
                    <div class="stat-item__label">مدة الحل</div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="pending-review">
            <div class="pending-review__icon">
                <i class="fas fa-hourglass-half"></i>
            </div>
            <h2 class="pending-review__title">في انتظار التصحيح</h2>
            <p class="pending-review__text">
                لقد أكملت الاختبار بنجاح. سيقوم المعلم بتصحيح إجاباتك وستظهر النتيجة قريباً.
            </p>
            <div class="pending-review__date">
                تم التسليم في: @Model.SubmittedAt?.ToString("dd/MM/yyyy hh:mm tt")
            </div>
        </div>
    }
</div>

@* ── Answers Review (MCQ Only) ── *@
@if (Model.Exam?.Type == Center_Management.Models.ExamType.MCQ && Model.Score.HasValue)
{
    <div class="card">
        <div class="card__header card__header--primary">
            <h3 class="card__title">
                <i class="fas fa-list-check"></i>
                مراجعة الإجابات
            </h3>
        </div>
        <div class="card__body">
            <div class="answers-review">
                @{ int questionNumber = 1; }
                @foreach (var question in Model.Exam.Questions.OrderBy(q => q.Order))
                {
                    var studentAnswer = Model.Answers?.FirstOrDefault(a => a.QuestionId == question.Id);
                    var isCorrect = studentAnswer?.IsCorrect ?? false;

                    <div class="answer-item @(isCorrect ? "answer-item--correct" : "answer-item--wrong")">
                        <div class="answer-item__header">
                            <span class="answer-item__number">السؤال @questionNumber</span>
                            <span class="answer-item__result">
                                @if (isCorrect)
                                {
                                    <i class="fas fa-check-circle"></i>
                                    <span>إجابة صحيحة</span>
                                }
                                else
                                {
                                    <i class="fas fa-times-circle"></i>
                                    <span>إجابة خاطئة</span>
                                }
                            </span>
                            <span class="answer-item__points">@question.Points نقطة</span>
                        </div>

                        <div class="answer-item__question">@question.QuestionText</div>

                        <div class="answer-item__options">
                            <div class="review-option @(question.CorrectAnswer == "A" ? "review-option--correct" : "") @(studentAnswer?.AnswerText == "A" && !isCorrect ? "review-option--wrong" : "")">
                                <span class="review-option__letter">A</span>
                                <span class="review-option__text">@question.OptionA</span>
                                @if (question.CorrectAnswer == "A")
                                {
                                    <span class="review-option__mark"><i class="fas fa-check"></i> صحيحة</span>
                                }
                                @if (studentAnswer?.AnswerText == "A")
                                {
                                    <span class="review-option__mark"><i class="fas fa-hand-pointer"></i> اخترت هذه</span>
                                }
                            </div>

                            <div class="review-option @(question.CorrectAnswer == "B" ? "review-option--correct" : "") @(studentAnswer?.AnswerText == "B" && !isCorrect ? "review-option--wrong" : "")">
                                <span class="review-option__letter">B</span>
                                <span class="review-option__text">@question.OptionB</span>
                                @if (question.CorrectAnswer == "B")
                                {
                                    <span class="review-option__mark"><i class="fas fa-check"></i> صحيحة</span>
                                }
                                @if (studentAnswer?.AnswerText == "B")
                                {
                                    <span class="review-option__mark"><i class="fas fa-hand-pointer"></i> اخترت هذه</span>
                                }
                            </div>

                            <div class="review-option @(question.CorrectAnswer == "C" ? "review-option--correct" : "") @(studentAnswer?.AnswerText == "C" && !isCorrect ? "review-option--wrong" : "")">
                                <span class="review-option__letter">C</span>
                                <span class="review-option__text">@question.OptionC</span>
                                @if (question.CorrectAnswer == "C")
                                {
                                    <span class="review-option__mark"><i class="fas fa-check"></i> صحيحة</span>
                                }
                                @if (studentAnswer?.AnswerText == "C")
                                {
                                    <span class="review-option__mark"><i class="fas fa-hand-pointer"></i> اخترت هذه</span>
                                }
                            </div>

                            <div class="review-option @(question.CorrectAnswer == "D" ? "review-option--correct" : "") @(studentAnswer?.AnswerText == "D" && !isCorrect ? "review-option--wrong" : "")">
                                <span class="review-option__letter">D</span>
                                <span class="review-option__text">@question.OptionD</span>
                                @if (question.CorrectAnswer == "D")
                                {
                                    <span class="review-option__mark"><i class="fas fa-check"></i> صحيحة</span>
                                }
                                @if (studentAnswer?.AnswerText == "D")
                                {
                                    <span class="review-option__mark"><i class="fas fa-hand-pointer"></i> اخترت هذه</span>
                                }
                            </div>
                        </div>
                    </div>

                    questionNumber++;
                }
            </div>
        </div>
    </div>
}

@section Scripts {
<style>
/* ═══════════════════════════════════════════════════════
   Exam Result - Scoped Styles
   ═══════════════════════════════════════════════════════ */

.page-header--success {
    background: var(--success-color);
}

.page-header--warning {
    background: var(--warning-color);
}

.btn--outline-white {
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.3);
}

.btn--outline-white:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #fff;
}

/* Score Summary */
.score-summary {
    display: flex;
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-xl);
    flex-wrap: wrap;
}

@@media (max-width: 768px) {
    .score-summary {
        flex-direction: column;
    }
}

/* Score Circle */
.score-circle {
    flex-shrink: 0;
    width: 280px;
    height: 280px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-lg);
    position: relative;
}

.score-circle--pass {
    background: var(--success-color);
}

.score-circle--fail {
    background: var(--warning-color);
}

.score-circle__inner {
    width: 240px;
    height: 240px;
    background: var(--bg-primary);
    border-radius: var(--radius-full);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
}

.score-circle__score {
    font-size: 3rem;
    font-weight: var(--font-bold);
    color: var(--text-primary);
}

.score-circle__percent {
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    color: var(--text-secondary);
}

.score-circle__status {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    margin-top: var(--spacing-sm);
    padding: var(--spacing-xs) var(--spacing);
    border-radius: var(--radius-full);
    font-weight: var(--font-bold);
}

.score-circle--pass .score-circle__status {
    background: var(--success-light);
    color: var(--success-color);
}

.score-circle--fail .score-circle__status {
    background: var(--warning-light);
    color: var(--warning-color);
}

/* Score Stats */
.score-stats {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing);
}

@@media (max-width: 480px) {
    .score-stats {
        grid-template-columns: 1fr;
    }
}

.stat-item {
    display: flex;
    align-items: center;
    gap: var(--spacing);
    padding: var(--spacing);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
}

.stat-item__icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    color: #fff;
    flex-shrink: 0;
}

.stat-item--total { background: var(--primary-light); }
.stat-item--total .stat-item__icon { background: var(--primary-color); }

.stat-item--score { background: var(--warning-light); }
.stat-item--score .stat-item__icon { background: var(--warning-color); }

.stat-item--percent { background: var(--success-light); }
.stat-item--percent .stat-item__icon { background: var(--success-color); }

.stat-item--time { background: var(--secondary-light); }
.stat-item--time .stat-item__icon { background: var(--secondary-color); }

.stat-item__value {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--text-primary);
}

.stat-item__label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
}

/* Pending Review */
.pending-review {
    flex: 1;
    text-align: center;
    padding: var(--spacing-xl);
    background: var(--warning-light);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
}

.pending-review__icon {
    font-size: 4rem;
    color: var(--warning-color);
    margin-bottom: var(--spacing);
}

.pending-review__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--warning-color);
    margin: 0 0 var(--spacing-sm);
}

.pending-review__text {
    font-size: var(--text-base);
    color: var(--text-primary);
    max-width: 500px;
    margin: 0 auto var(--spacing);
    line-height: 1.6;
}

.pending-review__date {
    font-size: var(--text-sm);
    color: var(--warning-color);
    font-weight: var(--font-semibold);
}

/* Answers Review */
.answers-review {
    display: flex;
    flex-direction: column;
    gap: var(--spacing);
}

.answer-item {
    padding: var(--spacing);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-lg);
}

.answer-item--correct {
    background: var(--success-light);
    border-color: var(--success-color);
}

.answer-item--wrong {
    background: var(--danger-light);
    border-color: var(--danger-color);
}

.answer-item__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-sm);
    padding-bottom: var(--spacing-sm);
    border-bottom: 2px solid var(--border-color);
    flex-wrap: wrap;
    gap: var(--spacing-xs);
}

.answer-item__number {
    font-weight: var(--font-bold);
    color: var(--text-primary);
}

.answer-item__result {
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: var(--font-semibold);
    font-size: var(--text-sm);
}

.answer-item--correct .answer-item__result {
    color: var(--success-color);
}

.answer-item--wrong .answer-item__result {
    color: var(--danger-color);
}

.answer-item__points {
    background: var(--primary-light);
    color: var(--primary-color);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
}

.answer-item__question {
    font-size: var(--text-base);
    font-weight: var(--font-medium);
    color: var(--text-primary);
    margin-bottom: var(--spacing);
    line-height: 1.6;
}

.answer-item__options {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
}

.review-option {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-sm);
    background: var(--bg-primary);
    border: 2px solid var(--border-color);
    border-radius: var(--radius);
}

.review-option--correct {
    background: var(--success-light);
    border-color: var(--success-color);
}

.review-option--wrong {
    background: var(--danger-light);
    border-color: var(--danger-color);
}

.review-option__letter {
    width: 28px;
    height: 28px;
    background: var(--gray-200);
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: var(--font-bold);
    font-size: var(--text-sm);
    flex-shrink: 0;
}

.review-option--correct .review-option__letter {
    background: var(--success-color);
    color: #fff;
}

.review-option--wrong .review-option__letter {
    background: var(--danger-color);
    color: #fff;
}

.review-option__text {
    flex: 1;
    font-size: var(--text-sm);
}

.review-option__mark {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    font-weight: var(--font-bold);
    flex-shrink: 0;
}

.review-option--correct .review-option__mark {
    color: var(--success-color);
}

.review-option--wrong .review-option__mark {
    color: var(--danger-color);
}
</style>
}
