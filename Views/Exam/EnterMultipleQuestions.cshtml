@model AddMultipleQuestionsVM
@{
    var exam = ViewBag.Exam as Exam;
    ViewData["Title"] = "إدخال الأسئلة";
}

<div class="exam-page-shell exam-multiple-editor-page">
    <header class="exam-page-heading exam-page-heading--compact">
        <div class="exam-page-heading__content">
            <span class="exam-page-heading__eyebrow">الخطوة الثانية</span>
            <div class="exam-page-heading__title-row">
                <span class="exam-page-heading__icon"><i class="fas fa-pen-ruler"></i></span>
                <div>
                    <h1 class="exam-page-heading__title">إدخال @Model.Questions.Count سؤال</h1>
                    <p class="exam-page-heading__subtitle">@exam?.Title · أكمل محتوى كل بطاقة بالترتيب.</p>
                </div>
            </div>
        </div>
        <span class="exam-count-chip"><strong>@Model.Questions.Count</strong> سؤال</span>
    </header>

    <nav class="exam-stepper" aria-label="خطوات إضافة الأسئلة">
        <div class="exam-stepper__item exam-stepper__item--complete"><span><i class="fas fa-check"></i></span><div><strong>تحديد العدد</strong><small>تم الاختيار</small></div></div>
        <i class="fas fa-arrow-left"></i>
        <div class="exam-stepper__item exam-stepper__item--active"><span>2</span><div><strong>إدخال المحتوى</strong><small>النص والاختيارات</small></div></div>
        <i class="fas fa-arrow-left"></i>
        <div class="exam-stepper__item"><span>3</span><div><strong>الحفظ</strong><small>إضافة للاختبار</small></div></div>
    </nav>

    <form asp-action="SaveMultipleQuestions" method="post" enctype="multipart/form-data" id="mqForm" class="exam-multiple-form">
        <input type="hidden" asp-for="ExamId" />
        <input type="hidden" asp-for="QuestionCount" />

        <div class="exam-multiple-layout">
            <main class="exam-multiple-layout__main">
                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    <section class="card exam-multiple-question" id="multiple-question-@(i + 1)">
                        <header class="exam-multiple-question__header">
                            <span class="exam-multiple-question__number">@(i + 1)</span>
                            <div><h2>السؤال @(i + 1)</h2><p>الترتيب داخل الاختبار: @Model.Questions[i].Order</p></div>
                            <span class="badge badge-neutral">ترتيب @Model.Questions[i].Order</span>
                        </header>
                        <input type="hidden" asp-for="Questions[i].Order" />

                        <div class="exam-multiple-question__body">
                            <div class="exam-field">
                                <label class="exam-field__label">نص السؤال <span>*</span></label>
                                <textarea asp-for="Questions[i].Text" class="form-control exam-textarea" rows="4" placeholder="اكتب نص السؤال..."></textarea>
                                <span asp-validation-for="Questions[i].Text" class="exam-field__error"></span>
                            </div>

                            <div class="exam-option-editor-grid exam-option-editor-grid--multiple">
                                <div class="exam-option-editor">
                                    <span class="exam-option-editor__letter">A</span>
                                    <div><label class="exam-field__label">الخيار A <span>*</span></label><input asp-for="Questions[i].OptionA" class="form-control" placeholder="الخيار الأول" /><span asp-validation-for="Questions[i].OptionA" class="exam-field__error"></span></div>
                                </div>
                                <div class="exam-option-editor">
                                    <span class="exam-option-editor__letter">B</span>
                                    <div><label class="exam-field__label">الخيار B <span>*</span></label><input asp-for="Questions[i].OptionB" class="form-control" placeholder="الخيار الثاني" /><span asp-validation-for="Questions[i].OptionB" class="exam-field__error"></span></div>
                                </div>
                                <div class="exam-option-editor">
                                    <span class="exam-option-editor__letter">C</span>
                                    <div><label class="exam-field__label">الخيار C <span>*</span></label><input asp-for="Questions[i].OptionC" class="form-control" placeholder="الخيار الثالث" /><span asp-validation-for="Questions[i].OptionC" class="exam-field__error"></span></div>
                                </div>
                                <div class="exam-option-editor">
                                    <span class="exam-option-editor__letter">D</span>
                                    <div><label class="exam-field__label">الخيار D <span>*</span></label><input asp-for="Questions[i].OptionD" class="form-control" placeholder="الخيار الرابع" /><span asp-validation-for="Questions[i].OptionD" class="exam-field__error"></span></div>
                                </div>
                            </div>

                            <div class="exam-multiple-question__settings">
                                <div class="exam-field">
                                    <label class="exam-field__label">الإجابة الصحيحة <span>*</span></label>
                                    <select asp-for="Questions[i].CorrectAnswer" class="form-select">
                                        <option value="A">A</option>
                                        <option value="B">B</option>
                                        <option value="C">C</option>
                                        <option value="D">D</option>
                                    </select>
                                    <span asp-validation-for="Questions[i].CorrectAnswer" class="exam-field__error"></span>
                                </div>
                                <div class="exam-field">
                                    <label class="exam-field__label">الدرجة <span>*</span></label>
                                    <div class="exam-input-with-icon"><i class="fas fa-star"></i><input asp-for="Questions[i].Points" type="number" class="form-control" min="0.5" max="100" step="0.5" /></div>
                                    <span asp-validation-for="Questions[i].Points" class="exam-field__error"></span>
                                </div>
                                <div class="exam-field exam-field--file">
                                    <label class="exam-field__label">صورة <small>اختياري</small></label>
                                    <input type="file" asp-for="Questions[i].QuestionImage" class="form-control exam-file-control" accept="image/jpeg,image/png,image/gif,image/webp" />
                                </div>
                            </div>
                        </div>
                    </section>
                }
            </main>

            <aside class="exam-multiple-layout__aside">
                <section class="card exam-question-nav">
                    <header><span><i class="fas fa-list-ol"></i></span><div><strong>الأسئلة</strong><small>انتقال سريع</small></div></header>
                    <div class="exam-question-nav__grid">
                        @for (int i = 0; i < Model.Questions.Count; i++)
                        {
                            <a href="#multiple-question-@(i + 1)" aria-label="الانتقال إلى السؤال @(i + 1)">@(i + 1)</a>
                        }
                    </div>
                </section>
                <section class="card exam-tip-card">
                    <i class="fas fa-lightbulb"></i>
                    <div><strong>قبل الحفظ</strong><p>راجع الإجابة الصحيحة والدرجة لكل سؤال. كل الأسئلة ستُحفظ معاً.</p></div>
                </section>
            </aside>
        </div>

        <footer class="exam-multiple-savebar">
            <div class="exam-multiple-savebar__summary">
                <span><i class="fas fa-layer-group"></i></span>
                <div><strong>حفظ @Model.Questions.Count سؤال</strong><small>تأكد من ملء جميع الحقول المطلوبة.</small></div>
            </div>
            <div class="exam-multiple-savebar__actions">
                <a asp-action="Details" asp-route-id="@Model.ExamId" class="btn btn-neutral"><i class="fas fa-times"></i> إلغاء</a>
                <button type="submit" class="btn btn-primary btn-lg" id="saveBtn"><i class="fas fa-save"></i> حفظ الأسئلة</button>
            </div>
        </footer>
    </form>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
document.getElementById('mqForm').addEventListener('submit', function() {
    const btn = document.getElementById('saveBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحفظ...';
});
</script>
}
