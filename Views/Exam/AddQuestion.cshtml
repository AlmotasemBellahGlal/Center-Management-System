@model Center_Management.Models.ExamQuestion
@{
    ViewData["Title"] = "إضافة سؤال";
    var exam = ViewBag.Exam as Center_Management.Models.Exam;
    var nextOrder = ViewBag.NextOrder;
}

<div class="exam-page-shell exam-question-editor-page">
    <header class="exam-page-heading exam-page-heading--compact">
        <div class="exam-page-heading__content">
            <span class="exam-page-heading__eyebrow">سؤال رقم @nextOrder</span>
            <div class="exam-page-heading__title-row">
                <span class="exam-page-heading__icon"><i class="fas fa-circle-question"></i></span>
                <div>
                    <h1 class="exam-page-heading__title">إضافة سؤال جديد</h1>
                    <p class="exam-page-heading__subtitle">@exam?.Title</p>
                </div>
            </div>
        </div>
        <a href="@Url.Action("Details",new{id=exam?.Id})" class="btn btn-neutral"><i class="fas fa-arrow-right"></i> رجوع للتفاصيل</a>
    </header>

    <form method="post" asp-action="AddQuestion" enctype="multipart/form-data" class="exam-editor-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ExamId" />
        <input type="hidden" asp-for="Order" value="@nextOrder" />

        <div class="exam-question-editor-layout">
            <main class="exam-question-editor-layout__main">
                <section class="card exam-form-section">
                    <header class="card-header">
                        <span class="card-header-icon"><i class="fas fa-quote-right"></i></span>
                        <div><h2 class="card-title">محتوى السؤال</h2><p>اكتب السؤال بصياغة مباشرة وواضحة.</p></div>
                        <span class="badge badge-primary">ترتيب @nextOrder</span>
                    </header>
                    <div class="card-body exam-form-fields">
                        <div class="exam-field exam-field--wide">
                            <label asp-for="QuestionText" class="exam-field__label">نص السؤال <span>*</span></label>
                            <textarea class="form-control exam-textarea exam-question-textarea" asp-for="QuestionText" rows="5" placeholder="اكتب نص السؤال هنا..." required></textarea>
                            <span asp-validation-for="QuestionText" class="exam-field__error"></span>
                        </div>
                    </div>
                </section>

                @if (exam?.Type == Center_Management.Models.ExamType.MCQ)
                {
                    <section class="card exam-form-section">
                        <header class="card-header">
                            <span class="card-header-icon"><i class="fas fa-list-check"></i></span>
                            <div><h2 class="card-title">الاختيارات والإجابة الصحيحة</h2><p>أدخل أربعة اختيارات ثم حدد الإجابة المعتمدة.</p></div>
                        </header>
                        <div class="card-body">
                            <div class="exam-option-editor-grid">
                                @foreach (var (letter, field, placeholder) in new[]{("A","OptionA","الخيار الأول"),("B","OptionB","الخيار الثاني"),("C","OptionC","الخيار الثالث"),("D","OptionD","الخيار الرابع")})
                                {
                                    <div class="exam-option-editor">
                                        <span class="exam-option-editor__letter">@letter</span>
                                        <div>
                                            <label class="exam-field__label">الخيار @letter <span>*</span></label>
                                            @if (letter == "A")
                                            { <input type="text" name="OptionA" class="form-control" placeholder="@placeholder" required /> }
                                            else if (letter == "B")
                                            { <input type="text" name="OptionB" class="form-control" placeholder="@placeholder" required /> }
                                            else if (letter == "C")
                                            { <input type="text" name="OptionC" class="form-control" placeholder="@placeholder" required /> }
                                            else
                                            { <input type="text" name="OptionD" class="form-control" placeholder="@placeholder" required /> }
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="exam-correct-answer-field">
                                <div><i class="fas fa-circle-check"></i><span><strong>الإجابة الصحيحة</strong><small>ستُستخدم للتصحيح التلقائي.</small></span></div>
                                <div class="exam-field">
                                    <select class="form-select" asp-for="CorrectAnswer" required aria-label="الإجابة الصحيحة">
                                        <option value="">— اختر الإجابة الصحيحة —</option>
                                        <option value="A">A — الخيار الأول</option>
                                        <option value="B">B — الخيار الثاني</option>
                                        <option value="C">C — الخيار الثالث</option>
                                        <option value="D">D — الخيار الرابع</option>
                                    </select>
                                    <span asp-validation-for="CorrectAnswer" class="exam-field__error"></span>
                                </div>
                            </div>
                        </div>
                    </section>
                }
                else
                {
                    <div class="exam-alert exam-alert--info"><i class="fas fa-circle-info"></i><span><strong>سؤال مقالي</strong> — سيكتب الطالب إجابته ويتطلب تصحيحاً يدوياً من المعلم.</span></div>
                }
            </main>

            <aside class="exam-question-editor-layout__aside">
                <section class="card exam-form-section exam-side-settings-card">
                    <header class="card-header">
                        <span class="card-header-icon"><i class="fas fa-sliders"></i></span>
                        <div><h2 class="card-title">إعدادات السؤال</h2><p>الدرجة والوسائط</p></div>
                    </header>
                    <div class="card-body exam-side-settings">
                        <div class="exam-field">
                            <label asp-for="Points" class="exam-field__label">عدد النقاط <span>*</span></label>
                            <div class="exam-input-with-icon"><i class="fas fa-star"></i><input type="number" class="form-control" asp-for="Points" min="1" max="100" value="1" required /></div>
                            <span asp-validation-for="Points" class="exam-field__error"></span>
                        </div>

                        <div class="exam-field">
                            <label class="exam-field__label">صورة السؤال <small>اختياري</small></label>
                            <div class="exam-image-upload" id="imgZone" onclick="document.getElementById('QuestionImage').click()" role="button" tabindex="0">
                                <div id="imgPlaceholder" class="exam-image-upload__placeholder">
                                    <span><i class="far fa-image"></i></span>
                                    <strong>إرفاق صورة</strong>
                                    <small>اضغط لاختيار ملف</small>
                                </div>
                                <img id="imgPreview" class="exam-image-upload__preview" alt="معاينة صورة السؤال" />
                            </div>
                            <input type="file" id="QuestionImage" name="QuestionImage" accept="image/*" class="exam-visually-hidden-input" onchange="previewImg(this)" />
                        </div>
                    </div>
                </section>

                <section class="card exam-context-card">
                    <span class="exam-context-card__icon"><i class="fas fa-file-alt"></i></span>
                    <small>سيُضاف إلى</small>
                    <strong>@exam?.Title</strong>
                    <span>@exam?.Group?.Name · سؤال @nextOrder</span>
                </section>
            </aside>
        </div>

        <footer class="exam-form-actions">
            <span><i class="fas fa-circle-info"></i> راجع النص والدرجة قبل الإضافة.</span>
            <div>
                <a href="@Url.Action("Details",new{id=exam?.Id})" class="btn btn-neutral"><i class="fas fa-times"></i> إلغاء</a>
                <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-plus"></i> إضافة السؤال</button>
            </div>
        </footer>
    </form>
</div>

@section Scripts {
@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
<script>
function previewImg(input) {
    const prev = document.getElementById('imgPreview');
    const placeholder = document.getElementById('imgPlaceholder');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { prev.src = e.target.result; prev.classList.add('is-visible'); placeholder.hidden = true; };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
}
