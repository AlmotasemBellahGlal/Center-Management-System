@model Center_Management.Models.ExamQuestion
@{
    ViewData["Title"] = "إضافة سؤال";
    var exam = ViewBag.Exam as Center_Management.Models.Exam;
    var nextOrder = ViewBag.NextOrder;
}

<div class="vf-top">
    <div>
        <h1 class="vf-title">إضافة سؤال جديد</h1>
        <p class="vf-sub">@exam?.Title · سؤال رقم @nextOrder</p>
    </div>
    <a href="@Url.Action("Details",new{id=exam?.Id})" class="vf-back-btn"><i class="fas fa-arrow-right"></i> رجوع</a>
</div>

<form method="post" asp-action="AddQuestion" enctype="multipart/form-data" class="vf-form-standalone">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="ExamId" />
    <input type="hidden" asp-for="Order" value="@nextOrder" />

    <div class="vf-section">
        <div class="vf-section__head">
            <div class="vf-section__icon" style="background:var(--gold-50);color:var(--gold)"><i class="fas fa-question-circle"></i></div>
            <h2 class="vf-section__title">نص السؤال</h2>
        </div>
        <div class="vf-section__body">
            <div class="vf-field">
                <label class="vf-label" asp-for="QuestionText">السؤال <span class="vf-req">*</span></label>
                <textarea class="vf-textarea" asp-for="QuestionText" rows="4" placeholder="اكتب نص السؤال هنا..." required></textarea>
                <span class="vf-err" asp-validation-for="QuestionText"></span>
            </div>
        </div>
    </div>

    @if (exam?.Type == Center_Management.Models.ExamType.MCQ)
    {
        <div class="vf-section">
            <div class="vf-section__head">
                <div class="vf-section__icon" style="background:var(--primary-50);color:var(--primary)"><i class="fas fa-list-ul"></i></div>
                <h2 class="vf-section__title">الخيارات والإجابة الصحيحة</h2>
            </div>
            <div class="vf-section__body">
                <div class="vf-opts-grid">
                    @foreach (var (letter, field, placeholder) in new[]{("A","OptionA","الخيار الأول"),("B","OptionB","الخيار الثاني"),("C","OptionC","الخيار الثالث"),("D","OptionD","الخيار الرابع")})
                    {
                        <div class="vf-opt-field">
                            <div class="vf-opt-field__letter">@letter</div>
                            <div style="flex:1">
                                <label class="vf-label vf-label--sm">الخيار @letter <span class="vf-req">*</span></label>
                                @if (letter == "A")
                                { <input type="text" name="OptionA" class="vf-input" placeholder="@placeholder" required /> }
                                else if (letter == "B")
                                { <input type="text" name="OptionB" class="vf-input" placeholder="@placeholder" required /> }
                                else if (letter == "C")
                                { <input type="text" name="OptionC" class="vf-input" placeholder="@placeholder" required /> }
                                else
                                { <input type="text" name="OptionD" class="vf-input" placeholder="@placeholder" required /> }
                            </div>
                        </div>
                    }
                </div>
                <div class="vf-field" style="margin-top:1.25rem">
                    <label class="vf-label" asp-for="CorrectAnswer">الإجابة الصحيحة <span class="vf-req">*</span></label>
                    <select class="vf-select" asp-for="CorrectAnswer" required>
                        <option value="">— اختر الإجابة الصحيحة —</option>
                        <option value="A">A — الخيار الأول</option>
                        <option value="B">B — الخيار الثاني</option>
                        <option value="C">C — الخيار الثالث</option>
                        <option value="D">D — الخيار الرابع</option>
                    </select>
                    <span class="vf-err" asp-validation-for="CorrectAnswer"></span>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="vf-info-note"><i class="fas fa-info-circle"></i> سؤال مقالي — سيكتب الطالب إجابته ويتطلب تصحيحاً يدوياً من المعلم</div>
    }

    <div class="vf-section">
        <div class="vf-section__head">
            <div class="vf-section__icon" style="background:var(--success-50);color:var(--success)"><i class="fas fa-star"></i></div>
            <h2 class="vf-section__title">الدرجة والصورة</h2>
        </div>
        <div class="vf-section__body">
            <div class="vf-row">
                <div class="vf-field">
                    <label class="vf-label" asp-for="Points">عدد النقاط <span class="vf-req">*</span></label>
                    <input type="number" class="vf-input" asp-for="Points" min="1" max="100" value="1" required />
                    <span class="vf-err" asp-validation-for="Points"></span>
                </div>
                <div class="vf-field">
                    <label class="vf-label">صورة السؤال <span class="vf-opt">(اختياري)</span></label>
                    <div class="vf-img-zone" id="imgZone" onclick="document.getElementById('QuestionImage').click()">
                        <div id="imgPlaceholder"><i class="fas fa-image"></i> <span>اضغط لرفع صورة</span></div>
                        <img id="imgPreview" style="display:none;max-height:140px;max-width:100%;border-radius:.4rem" />
                    </div>
                    <input type="file" id="QuestionImage" name="QuestionImage" accept="image/*" style="display:none" onchange="previewImg(this)" />
                </div>
            </div>
        </div>
    </div>

    <div class="vf-footer">
        <a href="@Url.Action("Details",new{id=exam?.Id})" class="vf-cancel"><i class="fas fa-times"></i> إلغاء</a>
        <button type="submit" class="vf-submit vf-submit--gold"><i class="fas fa-check"></i> إضافة السؤال</button>
    </div>
</form>

@section Scripts {
@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
<style>
.vf-top { display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.75rem;flex-wrap:wrap; }
.vf-title { font-size:1.4rem;font-weight:700;color:var(--text-primary);margin:0; }
.vf-sub { font-size:.8rem;color:var(--text-muted);margin:.25rem 0 0; }
.vf-back-btn { display:inline-flex;align-items:center;gap:.4rem;padding:.4rem .85rem;background:var(--gray-100);color:var(--text-secondary);border:1px solid var(--border);border-radius:.55rem;font-size:.8125rem;font-weight:600;cursor:pointer;text-decoration:none; }
.vf-back-btn:hover { background:var(--gray-150); }
.vf-form-standalone { }
.vf-section { background:var(--bg-card);border:1px solid var(--border-light);border-radius:.85rem;margin-bottom:1.25rem;overflow:hidden; }
.vf-section__head { display:flex;align-items:center;gap:.75rem;padding:1rem 1.25rem;border-bottom:1px solid var(--border-light);background:var(--bg-subtle); }
.vf-section__icon { width:36px;height:36px;border-radius:.55rem;display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0; }
.vf-section__title { font-size:.9rem;font-weight:700;color:var(--text-primary);margin:0; }
.vf-section__body { padding:1.25rem; }
.vf-field { }
.vf-row { display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.25rem; }
.vf-label { display:block;font-size:.8rem;font-weight:600;color:var(--text-secondary);margin-bottom:.4rem; }
.vf-label--sm { font-size:.75rem; }
.vf-req { color:var(--danger); }
.vf-opt { font-size:.72rem;font-weight:600;background:var(--gold-50);color:var(--gold);padding:.1em .5em;border-radius:2rem;vertical-align:middle; }
.vf-input,.vf-select,.vf-textarea { display:block;width:100%;padding:.5rem .75rem;font-size:.875rem;font-family:inherit;color:var(--text-primary);background:var(--bg-card);border:1.5px solid var(--border);border-radius:.55rem;transition:border-color .14s,box-shadow .14s; }
.vf-input:focus,.vf-select:focus,.vf-textarea:focus { outline:none;border-color:var(--gold);box-shadow:0 0 0 3px var(--gold-50); }
.vf-select { appearance:none;background-image:url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'%3e%3cpath fill='%23887f74' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");background-repeat:no-repeat;background-position:left .6rem center;background-size:13px;padding-inline-start:1.9rem; }
.vf-textarea { resize:vertical; }
.vf-err { display:block;font-size:.75rem;color:var(--danger);margin-top:.3rem; }
.vf-opts-grid { display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:.875rem; }
.vf-opt-field { display:flex;align-items:flex-start;gap:.6rem; }
.vf-opt-field__letter { width:36px;height:36px;background:var(--primary);color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.875rem;font-weight:700;flex-shrink:0;margin-top:1.4rem; }
.vf-info-note { display:flex;align-items:center;gap:.6rem;padding:.875rem 1.25rem;background:var(--info-50);border:1px solid var(--info-100);border-radius:.85rem;margin-bottom:1.25rem;font-size:.875rem;color:var(--info); }
.vf-info-note i { flex-shrink:0; }
.vf-img-zone { border:2px dashed var(--border);border-radius:.65rem;padding:1rem;text-align:center;cursor:pointer;background:var(--bg-subtle);min-height:80px;display:flex;align-items:center;justify-content:center;transition:.14s; }
.vf-img-zone:hover { border-color:var(--gold);background:var(--gold-50); }
#imgPlaceholder { display:flex;align-items:center;gap:.5rem;color:var(--text-muted);font-size:.8125rem; }
#imgPlaceholder i { color:var(--gold);font-size:1.2rem; }
.vf-footer { display:flex;justify-content:flex-end;gap:.5rem;flex-wrap:wrap;padding:1.25rem;background:var(--bg-subtle);border:1px solid var(--border-light);border-radius:.85rem;margin-top:1.25rem; }
.vf-cancel { display:inline-flex;align-items:center;gap:.4rem;padding:.4rem .85rem;background:var(--gray-100);color:var(--text-secondary);border:1px solid var(--border);border-radius:.55rem;font-size:.8125rem;font-weight:600;cursor:pointer;text-decoration:none; }
.vf-cancel:hover { background:var(--gray-150); }
.vf-submit { display:inline-flex;align-items:center;gap:.4rem;padding:.5rem 1.25rem;background:var(--success);color:#fff;border:none;border-radius:.55rem;font-size:.875rem;font-weight:700;cursor:pointer;transition:.14s; }
.vf-submit:hover { background:var(--success-hover);transform:translateY(-1px); }
.vf-submit--gold { background:var(--gold); }
.vf-submit--gold:hover { background:var(--gold-hover);box-shadow:0 4px 12px rgba(176,128,64,.3); }
</style>
<script>
function previewImg(input) {
    const prev = document.getElementById('imgPreview');
    const placeholder = document.getElementById('imgPlaceholder');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { prev.src = e.target.result; prev.style.display = 'block'; placeholder.style.display = 'none'; };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
}
