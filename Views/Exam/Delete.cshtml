@model Center_Management.Models.Exam
@{
    ViewData["Title"] = "حذف الاختبار";
    int qCount = Model.Questions?.Count ?? 0;
}

<div class="exam-page-shell exam-delete-page">
    <section class="card exam-delete-card">
        <div class="exam-delete-card__warning-icon"><i class="fas fa-triangle-exclamation"></i></div>
        <span class="exam-delete-card__eyebrow">إجراء نهائي</span>
        <h1>تأكيد حذف الاختبار</h1>
        <p>هذه العملية لا يمكن التراجع عنها. سيتم حذف الاختبار وجميع أسئلته ومحاولات الطلاب نهائياً.</p>

        <div class="exam-delete-summary">
            <div><span>العنوان</span><strong>@Model.Title</strong></div>
            <div><span>المجموعة</span><strong>@Model.Group?.Name</strong></div>
            <div><span>النوع</span><strong>@(Model.Type == Center_Management.Models.ExamType.MCQ ? "اختيار من متعدد" : "مقالي")</strong></div>
            <div><span>عدد الأسئلة</span><strong>@qCount سؤال</strong></div>
        </div>

        <div class="exam-delete-card__actions">
            <a href="@Url.Action("Index",new{groupId=Model.GroupId})" class="btn btn-neutral"><i class="fas fa-arrow-right"></i> إلغاء والرجوع</a>
            <form method="post" asp-action="Delete" asp-route-id="@Model.Id">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger"><i class="far fa-trash-can"></i> نعم، احذف الاختبار</button>
            </form>
        </div>
    </section>
</div>
