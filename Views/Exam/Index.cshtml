@model IEnumerable<Center_Management.Models.Exam>
@{
    ViewData["Title"] = "الاختبارات — " + ViewBag.Group?.Name;
    var group = ViewBag.Group as Center_Management.Models.Group;
    var now = DateTime.Now;
    var activeCount = Model.Count(exam => exam.StartDate <= now && exam.EndDate >= now);
    var upcomingCount = Model.Count(exam => exam.StartDate > now);
    var completedCount = Model.Count(exam => exam.EndDate < now);
}

<div class="exam-page-shell">
    <header class="exam-page-heading">
        <div class="exam-page-heading__content">
            <span class="exam-page-heading__eyebrow">إدارة التقييمات</span>
            <div class="exam-page-heading__title-row">
                <span class="exam-page-heading__icon"><i class="fas fa-file-alt"></i></span>
                <div>
                    <h1 class="exam-page-heading__title">اختبارات @group?.Name</h1>
                    <p class="exam-page-heading__subtitle">@group?.AcademicYear?.Name · أنشئ الاختبارات وتابع جاهزيتها ومحاولات الطلاب من مكان واحد.</p>
                </div>
            </div>
        </div>
        <div class="exam-page-heading__actions">
            <a href="@Url.Action("GroupPicker")" class="btn btn-neutral"><i class="fas fa-arrow-right"></i> المجموعات</a>
            <a href="@Url.Action("Create",new{groupId=group?.Id})" class="btn btn-primary"><i class="fas fa-plus"></i> إنشاء اختبار</a>
        </div>
    </header>

    <section class="exam-summary-grid" aria-label="ملخص الاختبارات">
        <article class="exam-summary-card exam-summary-card--primary">
            <span class="exam-summary-card__icon"><i class="fas fa-file-alt"></i></span>
            <div><strong>@Model.Count()</strong><span>إجمالي الاختبارات</span></div>
        </article>
        <article class="exam-summary-card exam-summary-card--success">
            <span class="exam-summary-card__icon"><i class="fas fa-circle-play"></i></span>
            <div><strong>@activeCount</strong><span>متاح الآن</span></div>
        </article>
        <article class="exam-summary-card exam-summary-card--info">
            <span class="exam-summary-card__icon"><i class="fas fa-calendar-plus"></i></span>
            <div><strong>@upcomingCount</strong><span>قادم</span></div>
        </article>
        <article class="exam-summary-card exam-summary-card--neutral">
            <span class="exam-summary-card__icon"><i class="fas fa-check-double"></i></span>
            <div><strong>@completedCount</strong><span>منتهي</span></div>
        </article>
    </section>

    @if (!Model.Any())
    {
        <div class="card exam-empty-card">
            <div class="empty-state">
                <div class="empty-state__icon"><i class="fas fa-clipboard-list"></i></div>
                <h2 class="empty-state__title">لا توجد اختبارات بعد</h2>
                <p class="empty-state__text">ابدأ بإنشاء أول اختبار لهذه المجموعة، ثم أضف الأسئلة وراجع الإعدادات قبل موعد الإتاحة.</p>
                <a href="@Url.Action("Create",new{groupId=group?.Id})" class="btn btn-primary"><i class="fas fa-plus"></i> إنشاء أول اختبار</a>
            </div>
        </div>
    }
    else
    {
        <div class="exam-directory-grid">
            @foreach (var exam in Model)
            {
                int qCount = exam.Questions?.Count ?? 0;
                int aCount = exam.Attempts?.Count ?? 0;
                bool isActive = exam.StartDate <= DateTime.Now && exam.EndDate >= DateTime.Now;
                bool isPast = exam.EndDate < DateTime.Now;
                bool isFuture = exam.StartDate > DateTime.Now;

                <article class="card exam-directory-card">
                    <div class="exam-directory-card__topline"></div>
                    <div class="exam-directory-card__header">
                        <span class="badge @(exam.Type == Center_Management.Models.ExamType.MCQ ? "badge-primary" : "badge-info")">
                            <i class="fas @(exam.Type == Center_Management.Models.ExamType.MCQ ? "fa-list-check" : "fa-pen")"></i>
                            @(exam.Type == Center_Management.Models.ExamType.MCQ ? "اختيار من متعدد" : "أسئلة مقالية")
                        </span>
                        @if (isActive)
                        {
                            <span class="badge badge-success"><i class="fas fa-circle exam-live-dot"></i> نشط</span>
                        }
                        else if (isPast)
                        {
                            <span class="badge badge-neutral"><i class="fas fa-check"></i> منتهي</span>
                        }
                        else if (isFuture)
                        {
                            <span class="badge badge-info"><i class="fas fa-clock"></i> قادم</span>
                        }
                    </div>

                    <div class="exam-directory-card__body">
                        <h2 class="exam-directory-card__title">@exam.Title</h2>
                        @if (!string.IsNullOrEmpty(exam.Description))
                        {
                            <p class="exam-directory-card__description">@exam.Description</p>
                        }
                        else
                        {
                            <p class="exam-directory-card__description exam-directory-card__description--muted">لا يوجد وصف مضاف لهذا الاختبار.</p>
                        }

                        <div class="exam-date-window">
                            <div><span>يفتح</span><strong><i class="far fa-calendar"></i> @exam.StartDate.ToString("dd/MM/yyyy")</strong><small>@exam.StartDate.ToString("HH:mm")</small></div>
                            <i class="fas fa-arrow-left exam-date-window__arrow"></i>
                            <div><span>يغلق</span><strong><i class="far fa-calendar-check"></i> @exam.EndDate.ToString("dd/MM/yyyy")</strong><small>@exam.EndDate.ToString("HH:mm")</small></div>
                        </div>

                        <div class="exam-directory-card__metrics">
                            <span><i class="fas fa-circle-question"></i><strong>@qCount</strong> سؤال</span>
                            <span><i class="fas fa-users"></i><strong>@aCount</strong> محاولة</span>
                            @if (exam.DurationMinutes.HasValue)
                            {
                                <span><i class="fas fa-stopwatch"></i><strong>@exam.DurationMinutes</strong> دقيقة</span>
                            }
                            else
                            {
                                <span><i class="fas fa-infinity"></i> حتى الإغلاق</span>
                            }
                        </div>
                    </div>

                    <footer class="exam-directory-card__footer">
                        <a href="@Url.Action("Details",new{id=exam.Id})" class="btn btn-primary btn-sm"><i class="fas fa-eye"></i> إدارة الاختبار</a>
                        <a href="@Url.Action("Delete",new{id=exam.Id})" class="btn btn-ghost btn-sm exam-delete-link"><i class="far fa-trash-can"></i> حذف</a>
                    </footer>
                </article>
            }
        </div>
    }
</div>
