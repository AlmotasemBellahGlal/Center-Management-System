@model AddMultipleQuestionsVM
@{
    var exam = ViewBag.Exam as Exam;
    ViewData["Title"] = "إضافة أسئلة متعددة";
}

<div class="vf-top">
    <div>
        <h1 class="vf-title">إضافة أسئلة متعددة</h1>
        <p class="vf-sub">@exam?.Title</p>
    </div>
    <a asp-action="Details" asp-route-id="@Model.ExamId" class="vf-back-btn"><i class="fas fa-arrow-right"></i> رجوع</a>
</div>

<div class="vf-card">
    <div class="vf-card__head">
        <div class="vf-card__head-icon" style="background:var(--gold-50);color:var(--gold)"><i class="fas fa-layer-group"></i></div>
        <h2 class="vf-card__title">كم سؤالاً تريد إضافته؟</h2>
    </div>
    <form asp-action="GenerateQuestionsForm" method="post" class="vf-form">
        <input type="hidden" asp-for="ExamId" />
        <div asp-validation-summary="ModelOnly" class="vf-errors"></div>

        <div class="vf-field" style="max-width:320px">
            <label asp-for="QuestionCount" class="vf-label">عدد الأسئلة <span class="vf-req">*</span></label>
            <input asp-for="QuestionCount" class="vf-input" type="number" min="1" max="50" placeholder="مثال: 10" />
            <span asp-validation-for="QuestionCount" class="vf-err"></span>
            <span class="vf-hint">يمكنك إضافة من 1 إلى 50 سؤال في المرة الواحدة</span>
        </div>

        <div class="vf-exam-info">
            <div class="vf-exam-info__item"><span>الاختبار</span> <strong>@exam?.Title</strong></div>
            <div class="vf-exam-info__item"><span>المجموعة</span> <strong>@exam?.Group?.Name</strong></div>
            <div class="vf-exam-info__item"><span>الأسئلة الحالية</span> <strong>@exam?.Questions?.Count</strong></div>
        </div>

        <div class="vf-form__footer">
            <a asp-action="Details" asp-route-id="@Model.ExamId" class="vf-cancel"><i class="fas fa-times"></i> إلغاء</a>
            <button type="submit" class="vf-submit vf-submit--gold"><i class="fas fa-arrow-left"></i> التالي — إدخال الأسئلة</button>
        </div>
    </form>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<style>
.vf-top { display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1.75rem;flex-wrap:wrap; }
.vf-title { font-size:1.4rem;font-weight:700;color:var(--text-primary);margin:0; }
.vf-sub { font-size:.8rem;color:var(--text-muted);margin:.25rem 0 0; }
.vf-back-btn { display:inline-flex;align-items:center;gap:.4rem;padding:.4rem .85rem;background:var(--gray-100);color:var(--text-secondary);border:1px solid var(--border);border-radius:.55rem;font-size:.8125rem;font-weight:600;cursor:pointer;text-decoration:none; }
.vf-back-btn:hover { background:var(--gray-150); }
.vf-errors { background:var(--danger-50);border:1px solid var(--danger-100);border-radius:.6rem;padding:.75rem 1rem;margin-bottom:1.25rem;font-size:.8125rem;color:var(--danger); }
.vf-card { background:var(--bg-card);border:1px solid var(--border-light);border-radius:.85rem;overflow:hidden; }
.vf-card__head { display:flex;align-items:center;gap:.75rem;padding:1rem 1.25rem;border-bottom:1px solid var(--border-light);background:var(--bg-subtle); }
.vf-card__head-icon { width:36px;height:36px;border-radius:.55rem;display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0; }
.vf-card__title { font-size:.9rem;font-weight:700;color:var(--text-primary);margin:0; }
.vf-form { padding:1.5rem; }
.vf-field { }
.vf-label { display:block;font-size:.8rem;font-weight:600;color:var(--text-secondary);margin-bottom:.4rem; }
.vf-req { color:var(--danger); }
.vf-hint { display:block;font-size:.75rem;color:var(--text-muted);margin-top:.3rem; }
.vf-input { display:block;width:100%;padding:.5rem .75rem;font-size:.875rem;font-family:inherit;color:var(--text-primary);background:var(--bg-card);border:1.5px solid var(--border);border-radius:.55rem;transition:border-color .14s,box-shadow .14s; }
.vf-input:focus { outline:none;border-color:var(--gold);box-shadow:0 0 0 3px var(--gold-50); }
.vf-err { display:block;font-size:.75rem;color:var(--danger);margin-top:.3rem; }
.vf-exam-info { display:flex;gap:1.5rem;flex-wrap:wrap;padding:1rem 1.25rem;background:var(--bg-subtle);border:1px solid var(--border-light);border-radius:.65rem;margin-top:1.25rem; }
.vf-exam-info__item { display:flex;align-items:center;gap:.4rem;font-size:.8125rem;color:var(--text-secondary); }
.vf-exam-info__item strong { color:var(--text-primary); }
.vf-form__footer { display:flex;justify-content:flex-end;gap:.5rem;margin-top:1.5rem;padding-top:1.25rem;border-top:1px solid var(--border-light); }
.vf-cancel { display:inline-flex;align-items:center;gap:.4rem;padding:.4rem .85rem;background:var(--gray-100);color:var(--text-secondary);border:1px solid var(--border);border-radius:.55rem;font-size:.8125rem;font-weight:600;cursor:pointer;text-decoration:none; }
.vf-cancel:hover { background:var(--gray-150); }
.vf-submit { display:inline-flex;align-items:center;gap:.4rem;padding:.5rem 1.25rem;background:var(--success);color:#fff;border:none;border-radius:.55rem;font-size:.875rem;font-weight:700;cursor:pointer;transition:.14s; }
.vf-submit:hover { background:var(--success-hover);transform:translateY(-1px); }
.vf-submit--gold { background:var(--gold); }
.vf-submit--gold:hover { background:var(--gold-hover);box-shadow:0 4px 12px rgba(176,128,64,.3); }
</style>
}
