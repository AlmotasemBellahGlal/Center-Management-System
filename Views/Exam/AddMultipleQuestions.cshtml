@model AddMultipleQuestionsVM
@{
    var exam = ViewBag.Exam as Exam;
    ViewData["Title"] = "إضافة أسئلة متعددة";
}

<div class="exam-page-shell exam-form-page">
    <header class="exam-page-heading exam-page-heading--compact">
        <div class="exam-page-heading__content">
            <span class="exam-page-heading__eyebrow">بناء بنك الأسئلة</span>
            <div class="exam-page-heading__title-row">
                <span class="exam-page-heading__icon"><i class="fas fa-layer-group"></i></span>
                <div>
                    <h1 class="exam-page-heading__title">إضافة أسئلة متعددة</h1>
                    <p class="exam-page-heading__subtitle">@exam?.Title</p>
                </div>
            </div>
        </div>
        <a asp-action="Details" asp-route-id="@Model.ExamId" class="btn btn-neutral"><i class="fas fa-arrow-right"></i> رجوع للتفاصيل</a>
    </header>

    <nav class="exam-stepper" aria-label="خطوات إضافة الأسئلة">
        <div class="exam-stepper__item exam-stepper__item--active"><span>1</span><div><strong>تحديد العدد</strong><small>اختر عدد الأسئلة</small></div></div>
        <i class="fas fa-arrow-left"></i>
        <div class="exam-stepper__item"><span>2</span><div><strong>إدخال المحتوى</strong><small>النص والاختيارات</small></div></div>
        <i class="fas fa-arrow-left"></i>
        <div class="exam-stepper__item"><span>3</span><div><strong>الحفظ</strong><small>إضافة للاختبار</small></div></div>
    </nav>

    <div class="exam-form-layout exam-form-layout--narrow">
        <main class="exam-form-layout__main">
            <section class="card exam-form-section exam-count-form-card">
                <header class="card-header">
                    <span class="card-header-icon"><i class="fas fa-list-ol"></i></span>
                    <div><h2 class="card-title">كم سؤالاً تريد إضافته؟</h2><p>سيتم إنشاء نموذج مستقل وواضح لكل سؤال.</p></div>
                </header>
                <form asp-action="GenerateQuestionsForm" method="post" class="card-body exam-count-form">
                    <input type="hidden" asp-for="ExamId" />
                    <div asp-validation-summary="ModelOnly" class="exam-validation-summary" role="alert"></div>

                    <div class="exam-count-picker">
                        <label asp-for="QuestionCount" class="exam-field__label">عدد الأسئلة <span>*</span></label>
                        <div class="exam-count-picker__control">
                            <i class="fas fa-circle-question"></i>
                            <input asp-for="QuestionCount" class="form-control" type="number" min="1" max="50" placeholder="مثال: 10" />
                            <span>سؤال</span>
                        </div>
                        <span asp-validation-for="QuestionCount" class="exam-field__error"></span>
                        <small class="exam-field__hint">يمكنك إضافة من 1 إلى 50 سؤالاً في المرة الواحدة.</small>
                    </div>

                    <footer class="exam-count-form__actions">
                        <a asp-action="Details" asp-route-id="@Model.ExamId" class="btn btn-neutral"><i class="fas fa-times"></i> إلغاء</a>
                        <button type="submit" class="btn btn-primary btn-lg"><span>التالي: إدخال الأسئلة</span><i class="fas fa-arrow-left"></i></button>
                    </footer>
                </form>
            </section>
        </main>

        <aside class="exam-form-layout__aside">
            <section class="card exam-context-card exam-context-card--details">
                <span class="exam-context-card__icon"><i class="fas fa-file-alt"></i></span>
                <small>الاختبار</small>
                <strong>@exam?.Title</strong>
                <span>@exam?.Group?.Name</span>
                <div class="exam-context-card__stat"><span>الأسئلة الحالية</span><strong>@exam?.Questions?.Count</strong></div>
            </section>
            <section class="card exam-tip-card">
                <i class="fas fa-circle-info"></i>
                <div><strong>نصيحة تنظيمية</strong><p>ابدأ بعدد مناسب لتسهيل المراجعة، ويمكنك إضافة دفعات أخرى لاحقاً.</p></div>
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
