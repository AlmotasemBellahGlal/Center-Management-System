@model Group

<div asp-validation-summary="ModelOnly" class="group-form-errors" role="alert"></div>

<div class="group-partial-form-section">
    <div class="form-group">
        <label asp-for="AcademicYearId" class="form-label">السنة الدراسية</label>
        <select asp-for="AcademicYearId" class="form-control form-select" asp-items="ViewBag.AcadimicYears"></select>
        <p class="form-hint">اختر السنة التي ستنتمي إليها المجموعة.</p>
    </div>
    <div class="group-partial-form-actions">
        <input type="submit" value="Create" class="btn btn-primary" />
    </div>
</div>
