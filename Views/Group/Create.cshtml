@model CreateGroupVM
@{
    ViewData["Title"] = "إضافة مجموعة جديدة";
}

<div class="group-page-heading group-page-heading--form">
    <div>
        <span class="group-page-heading__eyebrow">مجموعة دراسية جديدة</span>
        <h1 class="group-page-heading__title">إضافة مجموعة جديدة</h1>
        <p class="group-page-heading__subtitle">اختر اسمًا واضحًا للمجموعة، ثم نظّم مواعيد حصصها الأسبوعية.</p>
    </div>
    <a asp-action="Index" class="btn btn-neutral">
        <i class="fas fa-arrow-right" aria-hidden="true"></i> العودة إلى المجموعات
    </a>
</div>

<form asp-action="Create" class="group-form">
    <input asp-for="AcademicYearId" type="hidden" />
    <div asp-validation-summary="All" class="group-form-errors" role="alert"></div>

    <section class="card group-form-section" aria-labelledby="groupIdentityTitle">
        <div class="card-header group-form-section__header">
            <span class="card-header-icon"><i class="fas fa-tag" aria-hidden="true"></i></span>
            <div>
                <h2 class="card-title" id="groupIdentityTitle">بيانات المجموعة</h2>
                <p class="group-card-subtitle">الاسم الذي سيظهر في قوائم الطلاب والحضور والمدفوعات.</p>
            </div>
            <span class="group-form-step">01</span>
        </div>
        <div class="card-body group-form-section__body">
            <div class="form-group group-name-field">
                <label asp-for="Name" class="form-label">اسم المجموعة <span class="form-required" aria-hidden="true">*</span></label>
                <div class="group-input-shell">
                    <i class="fas fa-user-group" aria-hidden="true"></i>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="مثال: مجموعة الثانوية أ"
                           autocomplete="off"
                           aria-describedby="GroupNameHint GroupNameError" />
                </div>
                <p class="form-hint" id="GroupNameHint">استخدم اسمًا قصيرًا يميّز المجموعة بسهولة.</p>
                <span asp-validation-for="Name" class="field-error" id="GroupNameError"></span>
            </div>
        </div>
    </section>

    <section class="card group-form-section" aria-labelledby="groupScheduleEditorTitle">
        <div class="card-header group-form-section__header group-form-section__header--schedule">
            <span class="card-header-icon"><i class="fas fa-calendar-week" aria-hidden="true"></i></span>
            <div>
                <h2 class="card-title" id="groupScheduleEditorTitle">الجدول الأسبوعي</h2>
                <p class="group-card-subtitle">حدّد اليوم ووقت بدء كل حصة. لا يمكن تكرار اليوم نفسه.</p>
            </div>
            <span class="group-form-step">02</span>
            <button type="button" id="addSchedule" class="btn btn-outline-primary">
                <i class="fas fa-plus" aria-hidden="true"></i> إضافة موعد
            </button>
        </div>
        <div class="card-body group-form-section__body">
            <div id="scheduleContainer" class="group-schedule-editor" aria-live="polite">
                @for (int i = 0; i < Model.Schedules.Count; i++)
                {
                    <div class="group-schedule-editor-row">
                        <div class="group-schedule-editor-row__number" aria-label="الموعد رقم @(i + 1)">@(i + 1)</div>
                        <div class="form-group group-schedule-editor-row__day">
                            <label for="Schedules_@(i)__Day" class="form-label">اليوم</label>
                            <select asp-for="Schedules[i].Day"
                                    asp-items="Html.GetEnumSelectList<DaysOfWeek>()"
                                    class="form-control form-select"></select>
                        </div>
                        <div class="form-group group-schedule-editor-row__time">
                            <label for="Schedules_@(i)__StartTime" class="form-label">وقت البدء</label>
                            <input asp-for="Schedules[i].StartTime" type="time" class="form-control group-time-input" />
                        </div>
                        <button type="button" class="btn btn-outline-danger btn-icon remove-btn" aria-label="حذف هذا الموعد" title="حذف هذا الموعد">
                            <i class="fas fa-trash-can" aria-hidden="true"></i>
                        </button>
                    </div>
                }
            </div>

            <div id="scheduleEmptyState" class="group-schedule-editor-empty d-none">
                <i class="fas fa-calendar-plus" aria-hidden="true"></i>
                <div>
                    <strong>لا توجد مواعيد في الجدول</strong>
                    <span>اضغط «إضافة موعد» لبدء تكوين الجدول الأسبوعي.</span>
                </div>
            </div>
        </div>
    </section>

    <div class="card group-form-actions">
        <div class="group-form-actions__hint">
            <i class="fas fa-circle-info" aria-hidden="true"></i>
            راجع الاسم وتأكد من عدم تكرار يوم في الجدول.
        </div>
        <div>
            <a asp-action="Index" class="btn btn-neutral"><i class="fas fa-xmark" aria-hidden="true"></i> إلغاء</a>
            <button type="submit" class="btn btn-primary btn-lg"><i class="fas fa-floppy-disk" aria-hidden="true"></i> حفظ المجموعة</button>
        </div>
    </div>
</form>

@section Scripts {
@{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
<script>
let idx = @Model.Schedules.Count;
const days = ['السبت','الأحد','الإثنين','الثلاثاء','الأربعاء','الخميس','الجمعة'];

document.getElementById('addSchedule').addEventListener('click', function () {
    const n = document.querySelectorAll('.group-schedule-editor-row').length + 1;
    const opts = days.map((d,i) => `<option value="${i}">${d}</option>`).join('');
    const html = `
        <div class="group-schedule-editor-row">
            <div class="group-schedule-editor-row__number" aria-label="الموعد رقم ${n}">${n}</div>
            <div class="form-group group-schedule-editor-row__day">
                <label for="Schedules_${idx}__Day" class="form-label">اليوم</label>
                <select id="Schedules_${idx}__Day" name="Schedules[${idx}].Day" class="form-control form-select">${opts}</select>
            </div>
            <div class="form-group group-schedule-editor-row__time">
                <label for="Schedules_${idx}__StartTime" class="form-label">وقت البدء</label>
                <input id="Schedules_${idx}__StartTime" type="time" name="Schedules[${idx}].StartTime" class="form-control group-time-input" />
            </div>
            <button type="button" class="btn btn-outline-danger btn-icon remove-btn" aria-label="حذف هذا الموعد" title="حذف هذا الموعد">
                <i class="fas fa-trash-can" aria-hidden="true"></i>
            </button>
        </div>`;
    document.getElementById('scheduleContainer').insertAdjacentHTML('beforeend', html);
    idx++;
    renumberRows();
});

document.addEventListener('click', function(e) {
    const btn = e.target.closest('.remove-btn');
    if (btn) {
        btn.closest('.group-schedule-editor-row').remove();
        renumberRows();
    }
});

function renumberRows() {
    document.querySelectorAll('.group-schedule-editor-row__number').forEach((el,i) => {
        el.textContent = i + 1;
        el.setAttribute('aria-label', 'الموعد رقم ' + (i + 1));
    });
    const hasSchedules = document.querySelectorAll('.group-schedule-editor-row').length > 0;
    document.getElementById('scheduleEmptyState').classList.toggle('d-none', hasSchedules);
}

renumberRows();
</script>
}
