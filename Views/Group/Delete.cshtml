@model Center_Management.Models.Group
@{
    ViewData["Title"] = "حذف المجموعة";
}

<section class="card group-delete-page" aria-labelledby="groupDeleteTitle">
    <div class="group-delete-page__header">
        <span class="group-delete-page__icon"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i></span>
        <span class="badge badge-danger">إجراء نهائي</span>
        <h1 id="groupDeleteTitle">تأكيد حذف المجموعة</h1>
        <p>راجع بيانات المجموعة جيدًا. لا يمكن التراجع عن الحذف بعد تأكيده.</p>
    </div>

    <div class="group-delete-page__summary">
        <div class="group-delete-page__summary-row">
            <span><i class="fas fa-user-group" aria-hidden="true"></i> اسم المجموعة</span>
            <strong>@Model.Name</strong>
        </div>
        <div class="group-delete-page__summary-row">
            <span><i class="fas fa-graduation-cap" aria-hidden="true"></i> السنة الدراسية</span>
            <strong>@(Model.AcademicYear?.Name ?? "—")</strong>
        </div>
        @if (Model.Schedules != null && Model.Schedules.Any())
        {
            <div class="group-delete-page__summary-row group-delete-page__summary-row--schedule">
                <span><i class="fas fa-calendar-week" aria-hidden="true"></i> الجدول</span>
                <div class="group-schedule-chip-list">
                    @foreach (var s in Model.Schedules)
                    {
                        <span class="group-schedule-chip">
                            <strong>@s.Day</strong>
                            <span><i class="fas fa-clock" aria-hidden="true"></i> <time dir="ltr">@s.StartTime.ToString(@"hh\:mm")</time></span>
                        </span>
                    }
                </div>
            </div>
        }
    </div>

    <div class="group-delete-page__notice">
        <i class="fas fa-circle-info" aria-hidden="true"></i>
        <span>سيتم حذف المجموعة وجميع البيانات المرتبطة بها وفق قواعد النظام الحالية.</span>
    </div>

    <div class="group-delete-page__actions">
        <a asp-controller="AcadimicYear" asp-action="Details" asp-route-id="@Model.AcademicYearId" class="btn btn-neutral">
            <i class="fas fa-arrow-right" aria-hidden="true"></i> إلغاء والعودة
        </a>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger btn-lg">
                <i class="fas fa-trash-can" aria-hidden="true"></i> نعم، احذف المجموعة
            </button>
        </form>
    </div>
</section>
