@model Center_Management.Models.Group
@{
    ViewData["Title"] = "تفاصيل المجموعة";
    var academicYearName = Model.AcademicYear?.Name ?? "—";
    var scheduleCount = Model.Schedules?.Count ?? 0;
}

<section class="card group-profile-hero" aria-labelledby="groupProfileTitle">
    <div class="group-profile-hero__identity">
        <span class="group-profile-hero__icon"><i class="fas fa-user-group" aria-hidden="true"></i></span>
        <div>
            <div class="group-profile-hero__meta">
                <span class="badge badge-primary"><i class="fas fa-graduation-cap" aria-hidden="true"></i> @academicYearName</span>
                <span>مجموعة رقم @Model.Id</span>
            </div>
            <h1 id="groupProfileTitle">@Model.Name</h1>
            <p>مساحة إدارة المجموعة والجدول والحضور والمدفوعات.</p>
        </div>
    </div>
    <div class="group-profile-hero__primary-actions">
        <a href="@Url.Action("Index","Session",new{groupId=Model.Id})" class="btn btn-primary btn-lg">
            <i class="fas fa-clipboard-list" aria-hidden="true"></i> فتح الجلسة
        </a>
        <a href="@Url.Action("Create","Attendance",new{groupId=Model.Id})" class="btn btn-success">
            <i class="fas fa-clipboard-check" aria-hidden="true"></i> تسجيل حضور
        </a>
        <a href="@Url.Action("Index","Payment",new{groupId=Model.Id})" class="btn btn-outline-primary">
            <i class="fas fa-wallet" aria-hidden="true"></i> المدفوعات
        </a>
    </div>
</section>

<div class="group-profile-toolbar" aria-label="إجراءات المجموعة">
    <a href="@Url.Action("Report","Attendance",new{groupId=Model.Id})" class="btn btn-neutral">
        <i class="fas fa-chart-line" aria-hidden="true"></i> تقرير الحضور
    </a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-neutral">
        <i class="fas fa-pen" aria-hidden="true"></i> تعديل المجموعة
    </a>
    <button type="button"
            class="btn btn-outline-danger"
            onclick="openDeleteModal('@Model.Id','@Html.Raw(Html.Encode(Model.Name))')">
        <i class="fas fa-trash-can" aria-hidden="true"></i> حذف
    </button>
    <a asp-controller="AcadimicYear" asp-action="Details" asp-route-id="@Model.AcademicYearId" class="btn btn-ghost group-profile-toolbar__back">
        <i class="fas fa-arrow-right" aria-hidden="true"></i> العودة إلى السنة الدراسية
    </a>
</div>

<section class="group-overview-grid" aria-label="معلومات المجموعة">
    <article class="card group-overview-card">
        <span class="group-overview-card__icon"><i class="fas fa-tag" aria-hidden="true"></i></span>
        <div>
            <span>اسم المجموعة</span>
            <strong>@Model.Name</strong>
        </div>
    </article>
    <article class="card group-overview-card">
        <span class="group-overview-card__icon"><i class="fas fa-graduation-cap" aria-hidden="true"></i></span>
        <div>
            <span>السنة الدراسية</span>
            <strong>@(Model.AcademicYear?.Name ?? "—")</strong>
        </div>
    </article>
    <article class="card group-overview-card">
        <span class="group-overview-card__icon"><i class="fas fa-calendar-days" aria-hidden="true"></i></span>
        <div>
            <span>المواعيد الأسبوعية</span>
            <strong>@scheduleCount موعد</strong>
        </div>
    </article>
</section>

<div class="group-details-layout">
    <section class="card group-detail-section" aria-labelledby="groupScheduleTitle">
        <div class="card-header">
            <span class="card-header-icon"><i class="fas fa-calendar-week" aria-hidden="true"></i></span>
            <div>
                <h2 class="card-title" id="groupScheduleTitle">الجدول الدراسي</h2>
                <p class="group-card-subtitle">المواعيد الأسبوعية المحددة للمجموعة.</p>
            </div>
            <span class="badge badge-neutral group-card-count">@scheduleCount موعد</span>
        </div>

        @if (Model.Schedules != null && Model.Schedules.Any())
        {
            <div class="group-profile-schedule-grid">
                @foreach (var s in Model.Schedules)
                {
                    <article class="group-profile-schedule-item">
                        <span class="group-profile-schedule-item__day-icon"><i class="fas fa-calendar-day" aria-hidden="true"></i></span>
                        <div>
                            <span>يوم الحصة</span>
                            <strong>@s.Day</strong>
                        </div>
                        <time dir="ltr"><i class="fas fa-clock" aria-hidden="true"></i> @s.StartTime.ToString(@"hh\:mm")</time>
                    </article>
                }
            </div>
        }
        else
        {
            <div class="group-section-empty">
                <i class="fas fa-calendar-xmark" aria-hidden="true"></i>
                <strong>لم يُحدَّد جدول بعد</strong>
                <span>أضف موعدًا أسبوعيًا من صفحة تعديل المجموعة.</span>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">إضافة جدول</a>
            </div>
        }
    </section>

    <aside class="card group-detail-section group-student-access" aria-labelledby="groupStudentsTitle">
        <div class="card-header">
            <span class="card-header-icon"><i class="fas fa-users" aria-hidden="true"></i></span>
            <div>
                <h2 class="card-title" id="groupStudentsTitle">طلاب المجموعة</h2>
                <p class="group-card-subtitle">الوصول إلى قائمة الطلاب والمتابعة اليومية.</p>
            </div>
        </div>
        <div class="group-student-access__body">
            <span class="group-student-access__illustration"><i class="fas fa-user-graduate" aria-hidden="true"></i></span>
            <h3>إدارة الطلاب من الجلسة</h3>
            <p>افتح جلسة المجموعة لمراجعة الطلاب المسجلين وتسجيل المتابعة، أو انتقل مباشرة إلى الحضور.</p>
            <div class="group-student-access__actions">
                <a href="@Url.Action("Index","Session",new{groupId=Model.Id})" class="btn btn-primary">
                    <i class="fas fa-users-viewfinder" aria-hidden="true"></i> عرض الطلاب
                </a>
                <a href="@Url.Action("Report","Attendance",new{groupId=Model.Id})" class="btn btn-neutral">
                    <i class="fas fa-chart-column" aria-hidden="true"></i> سجل الحضور
                </a>
            </div>
        </div>
    </aside>
</div>

<div class="modal" id="deleteGroupModal" role="dialog" aria-modal="true" aria-labelledby="deleteGroupTitle">
    <div class="modal__backdrop" onclick="closeModal('deleteGroupModal')"></div>
    <div class="modal__content">
        <div class="modal__header">
            <span class="group-delete-modal__icon"><i class="fas fa-users-slash" aria-hidden="true"></i></span>
            <h2 class="modal__title" id="deleteGroupTitle">تأكيد حذف المجموعة</h2>
            <button type="button" class="modal__close" onclick="closeModal('deleteGroupModal')" aria-label="إغلاق نافذة الحذف">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
        <div class="modal__body group-delete-modal__body">
            <p>أنت على وشك حذف المجموعة:</p>
            <strong id="deleteGroupName"></strong>
            <p class="group-delete-modal__warning"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> ستنتقل إلى صفحة التأكيد قبل تنفيذ الحذف.</p>
        </div>
        <div class="modal__footer">
            <button type="button" class="btn btn-neutral" onclick="closeModal('deleteGroupModal')">إلغاء</button>
            <a id="deleteGroupConfirmLink" href="#" class="btn btn-danger"><i class="fas fa-arrow-left" aria-hidden="true"></i> متابعة الحذف</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openDeleteModal(id, name) {
    document.getElementById('deleteGroupName').textContent = name;
    document.getElementById('deleteGroupConfirmLink').href = '/Group/Delete/' + id;
    openModal('deleteGroupModal');
}
</script>
}
