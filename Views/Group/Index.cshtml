@model IEnumerable<Center_Management.Models.Group>
@{
    ViewData["Title"] = "المجموعات";
}

<div class="vp-top">
    <div>
        <h1 class="vp-title"><i class="fas fa-layer-group" style="color:var(--primary)"></i> المجموعات</h1>
        <p class="vp-sub">جميع مجموعات الدراسة مرتبة حسب السنة الدراسية</p>
    </div>
    <a asp-action="Create" class="vp-btn vp-btn--primary"><i class="fas fa-plus"></i> إضافة مجموعة</a>
</div>

@if (Model != null && Model.Any())
{
    <div class="vp-table-card">
        <div class="vp-table-card__head">
            <span class="vp-table-card__title">قائمة المجموعات</span>
            <span class="vp-pill">@Model.Count() مجموعة</span>
        </div>
        <div style="overflow-x:auto">
            <table class="vp-table">
                <thead>
                    <tr>
                        <th>اسم المجموعة</th>
                        <th>السنة الدراسية</th>
                        <th>الجدول</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in Model)
                    {
                        <tr>
                            <td>
                                <div class="vp-group-cell">
                                    <div class="vp-group-cell__dot"><i class="fas fa-users"></i></div>
                                    <span class="vp-group-cell__name">@group.Name</span>
                                </div>
                            </td>
                            <td>
                                <span class="vp-tag">@(group.AcademicYear?.Name ?? "—")</span>
                            </td>
                            <td>
                                @if (group.Schedules != null && group.Schedules.Any())
                                {
                                    <div class="vp-sched-row">
                                        @foreach (var s in group.Schedules)
                                        {
                                            <span class="vp-sched-chip"><i class="fas fa-clock"></i> @s.Day @s.StartTime.ToString(@"hh\:mm")</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span style="color:var(--text-muted);font-size:.8rem">—</span>
                                }
                            </td>
                            <td class="vp-actions">
                                <a asp-action="Details" asp-route-id="@group.Id" class="vp-btn-sm vp-btn-sm--slate"><i class="fas fa-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@group.Id" class="vp-btn-sm vp-btn-sm--amber"><i class="fas fa-edit"></i></a>
                                <button type="button" class="vp-btn-sm vp-btn-sm--red"
                                        onclick="openDeleteModal('@group.Id','@Html.Raw(Html.Encode(group.Name))')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="vp-empty">
        <div class="vp-empty__icon"><i class="fas fa-layer-group"></i></div>
        <h3>لا توجد مجموعات بعد</h3>
        <p>اذهب إلى السنوات الدراسية لإضافة مجموعة جديدة</p>
        <a asp-controller="AcadimicYear" asp-action="Index" class="vp-btn vp-btn--primary"><i class="fas fa-graduation-cap"></i> السنوات الدراسية</a>
    </div>
}

<div class="modal" id="deleteGroupModal">
    <div class="modal__backdrop" onclick="closeModal('deleteGroupModal')"></div>
    <div class="modal__content">
        <div class="modal__header">
            <h2 class="modal__title">تأكيد الحذف</h2>
            <button class="modal__close" onclick="closeModal('deleteGroupModal')"><i class="fas fa-times"></i></button>
        </div>
        <div class="modal__body">
            <p>هل أنت متأكد من حذف المجموعة <strong id="deleteGroupName"></strong>؟ لا يمكن التراجع عن هذا الإجراء.</p>
        </div>
        <div class="modal__footer">
            <button class="vp-btn vp-btn--ghost" onclick="closeModal('deleteGroupModal')">إلغاء</button>
            <a id="deleteGroupConfirmLink" href="#" class="vp-btn vp-btn--danger"><i class="fas fa-trash"></i> حذف</a>
        </div>
    </div>
</div>

@section Scripts {
<style>
.vp-top { display:flex; align-items:flex-start; justify-content:space-between; gap:1rem; flex-wrap:wrap; margin-bottom:1.5rem; }
.vp-title { font-size:1.4rem; font-weight:700; color:var(--text-primary); margin:0; display:flex; align-items:center; gap:.6rem; }
.vp-sub { font-size:.8rem; color:var(--text-muted); margin:.25rem 0 0; }
.vp-btn { display:inline-flex; align-items:center; gap:.45rem; padding:.45rem 1rem; border-radius:.55rem; font-size:.8125rem; font-weight:600; cursor:pointer; border:none; text-decoration:none; transition:.14s; }
.vp-btn--primary { background:var(--primary); color:#fff; } .vp-btn--primary:hover { background:var(--primary-hover); }
.vp-btn--ghost   { background:var(--gray-100); color:var(--text-secondary); border:1px solid var(--border); } .vp-btn--ghost:hover { background:var(--gray-150); }
.vp-btn--danger  { background:var(--danger); color:#fff; } .vp-btn--danger:hover { background:var(--danger-hover); }
.vp-table-card { background:var(--bg-card); border:1px solid var(--border-light); border-radius:.85rem; overflow:hidden; }
.vp-table-card__head { display:flex; align-items:center; gap:.75rem; padding:.875rem 1.25rem; border-bottom:1px solid var(--border-light); background:var(--bg-subtle); }
.vp-table-card__title { font-size:.875rem; font-weight:700; color:var(--text-primary); }
.vp-pill { display:inline-flex; align-items:center; padding:.15em .6em; border-radius:2rem; font-size:.7rem; font-weight:700; background:var(--primary-100); color:var(--primary); }
.vp-table { width:100%; border-collapse:collapse; font-size:.8125rem; }
.vp-table thead th { padding:.6rem 1rem; text-align:start; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:var(--text-muted); background:var(--bg-subtle); border-bottom:1px solid var(--border-light); white-space:nowrap; }
.vp-table tbody tr { border-bottom:1px solid var(--border-light); transition:background .1s; }
.vp-table tbody tr:last-child { border-bottom:none; }
.vp-table tbody tr:hover { background:var(--primary-50); }
.vp-table td { padding:.7rem 1rem; color:var(--text-primary); vertical-align:middle; }
.vp-group-cell { display:flex; align-items:center; gap:.6rem; }
.vp-group-cell__dot { width:32px; height:32px; background:var(--primary-50); color:var(--primary); border-radius:.45rem; display:flex; align-items:center; justify-content:center; font-size:.8rem; flex-shrink:0; }
.vp-group-cell__name { font-weight:700; color:var(--text-primary); }
.vp-tag { display:inline-flex; align-items:center; padding:.2em .65em; background:var(--bg-subtle); border:1px solid var(--border-light); border-radius:2rem; font-size:.75rem; font-weight:600; color:var(--text-muted); }
.vp-sched-row { display:flex; flex-wrap:wrap; gap:.3rem; }
.vp-sched-chip { display:inline-flex; align-items:center; gap:.3rem; padding:.2em .55em; background:var(--info-50); color:var(--info); border-radius:2rem; font-size:.72rem; font-weight:600; }
.vp-actions { display:flex; justify-content:flex-end; gap:.35rem; white-space:nowrap; }
.vp-btn-sm { width:30px; height:30px; display:inline-flex; align-items:center; justify-content:center; border:none; border-radius:.4rem; cursor:pointer; font-size:.8rem; transition:.12s; text-decoration:none; }
.vp-btn-sm--slate { background:var(--info-50); color:var(--info); }     .vp-btn-sm--slate:hover { background:var(--info); color:#fff; }
.vp-btn-sm--amber { background:var(--warning-50); color:var(--warning); } .vp-btn-sm--amber:hover { background:var(--warning); color:#fff; }
.vp-btn-sm--red   { background:var(--danger-50); color:var(--danger); }   .vp-btn-sm--red:hover   { background:var(--danger); color:#fff; }
.vp-empty { text-align:center; padding:4rem 2rem; background:var(--bg-card); border:1px solid var(--border-light); border-radius:.85rem; }
.vp-empty__icon { font-size:3rem; color:var(--text-disabled); margin-bottom:1rem; }
.vp-empty h3 { font-size:1.1rem; font-weight:700; margin:0 0 .5rem; }
.vp-empty p { font-size:.875rem; color:var(--text-muted); margin:0 0 1.5rem; }
</style>
<script>
function openDeleteModal(id, name) {
    document.getElementById('deleteGroupName').textContent = name;
    document.getElementById('deleteGroupConfirmLink').href = '/Group/Delete/' + id;
    openModal('deleteGroupModal');
}
</script>
}
