@model IEnumerable<Center_Management.Models.Group>
@{
    ViewData["Title"] = "المجموعات";
    var groupList = Model?.ToList() ?? new List<Center_Management.Models.Group>();
    var academicYearCount = groupList.Select(group => group.AcademicYearId).Distinct().Count();
    var scheduledGroupCount = groupList.Count(group => group.Schedules != null && group.Schedules.Any());
    var totalScheduleCount = groupList.Sum(group => group.Schedules?.Count ?? 0);
}

<div class="group-page-heading">
    <div>
        <span class="group-page-heading__eyebrow">دليل المجموعات</span>
        <h1 class="group-page-heading__title">المجموعات الدراسية</h1>
        <p class="group-page-heading__subtitle">نظرة واضحة على كل مجموعة وسنتها الدراسية ومواعيدها الأسبوعية.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-lg">
        <i class="fas fa-plus" aria-hidden="true"></i> إضافة مجموعة
    </a>
</div>

@if (Model != null && Model.Any())
{
    <div class="stat-grid group-stat-grid" aria-label="ملخص المجموعات">
        <div class="stat-card stat-card--primary">
            <div class="stat-card__icon"><i class="fas fa-layer-group" aria-hidden="true"></i></div>
            <div class="stat-card__body">
                <div class="stat-card__value">@Model.Count()</div>
                <div class="stat-card__label">إجمالي المجموعات</div>
                <div class="stat-card__trend">كل المجموعات المسجلة</div>
            </div>
        </div>
        <div class="stat-card stat-card--accent">
            <div class="stat-card__icon"><i class="fas fa-graduation-cap" aria-hidden="true"></i></div>
            <div class="stat-card__body">
                <div class="stat-card__value">@academicYearCount</div>
                <div class="stat-card__label">سنوات دراسية</div>
                <div class="stat-card__trend">مرتبطة بالمجموعات الحالية</div>
            </div>
        </div>
        <div class="stat-card stat-card--success">
            <div class="stat-card__icon"><i class="fas fa-calendar-check" aria-hidden="true"></i></div>
            <div class="stat-card__body">
                <div class="stat-card__value">@scheduledGroupCount</div>
                <div class="stat-card__label">مجموعات بجدول</div>
                <div class="stat-card__trend">لديها موعد أسبوعي واحد على الأقل</div>
            </div>
        </div>
        <div class="stat-card stat-card--gold">
            <div class="stat-card__icon"><i class="fas fa-clock" aria-hidden="true"></i></div>
            <div class="stat-card__body">
                <div class="stat-card__value">@totalScheduleCount</div>
                <div class="stat-card__label">مواعيد أسبوعية</div>
                <div class="stat-card__trend">عبر كل المجموعات</div>
            </div>
        </div>
    </div>

    <section class="card group-directory-toolbar" aria-label="البحث في المجموعات">
        <div class="group-search-box">
            <label for="groupSearch">البحث السريع</label>
            <div class="group-search-box__control">
                <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
                <input id="groupSearch"
                       type="search"
                       autocomplete="off"
                       placeholder="ابحث باسم المجموعة أو السنة الدراسية..."
                       oninput="filterGroups(this.value)"
                       aria-describedby="groupSearchMeta" />
                <button type="button" onclick="clearGroupSearch()" aria-label="مسح البحث" title="مسح البحث">
                    <i class="fas fa-xmark" aria-hidden="true"></i>
                </button>
            </div>
        </div>
        <span id="groupSearchMeta" class="group-search-meta" role="status" aria-live="polite">@groupList.Count مجموعة متاحة</span>
    </section>

    <section aria-labelledby="groupDirectoryTitle">
        <div class="group-section-heading">
            <div>
                <span class="group-section-heading__icon"><i class="fas fa-border-all" aria-hidden="true"></i></span>
                <div>
                    <h2 id="groupDirectoryTitle">كل المجموعات</h2>
                    <p>المعلومات الأساسية والجدول والإجراءات في مكان واحد.</p>
                </div>
            </div>
            <span class="badge badge-primary">@groupList.Count مجموعة</span>
        </div>

        <div class="group-directory-grid" id="groupDirectory">
            @foreach (var group in Model)
            {
                var academicYearName = group.AcademicYear?.Name ?? "—";
                <article class="card group-directory-card"
                         data-group-card
                         data-name="@((group.Name ?? string.Empty).ToLowerInvariant())"
                         data-year="@academicYearName.ToLowerInvariant()">
                    <div class="group-directory-card__header">
                        <div class="group-directory-card__identity">
                            <span class="group-directory-card__icon"><i class="fas fa-user-group" aria-hidden="true"></i></span>
                            <div>
                                <h3>@group.Name</h3>
                                <span class="badge badge-neutral"><i class="fas fa-graduation-cap" aria-hidden="true"></i> @academicYearName</span>
                            </div>
                        </div>
                        <span class="group-directory-card__id">#@group.Id</span>
                    </div>

                    <div class="group-directory-card__schedule">
                        <div class="group-directory-card__schedule-title">
                            <span><i class="fas fa-calendar-week" aria-hidden="true"></i> الجدول الأسبوعي</span>
                            <span>@(group.Schedules?.Count ?? 0) موعد</span>
                        </div>
                        @if (group.Schedules != null && group.Schedules.Any())
                        {
                            <div class="group-schedule-chip-list">
                                @foreach (var s in group.Schedules)
                                {
                                    <span class="group-schedule-chip">
                                        <strong>@s.Day</strong>
                                        <span><i class="fas fa-clock" aria-hidden="true"></i> <time dir="ltr">@s.StartTime.ToString(@"hh\:mm")</time></span>
                                    </span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="group-directory-card__no-schedule">
                                <i class="fas fa-calendar-xmark" aria-hidden="true"></i>
                                لم يُحدَّد جدول بعد
                            </div>
                        }
                    </div>

                    <div class="group-directory-card__actions">
                        <a asp-action="Details" asp-route-id="@group.Id" class="btn btn-primary btn-sm">
                            <i class="fas fa-arrow-up-right-from-square" aria-hidden="true"></i> فتح المجموعة
                        </a>
                        <a asp-action="Edit" asp-route-id="@group.Id" class="btn btn-neutral btn-sm">
                            <i class="fas fa-pen" aria-hidden="true"></i> تعديل
                        </a>
                        <button type="button"
                                class="btn btn-outline-danger btn-sm btn-icon"
                                onclick="openDeleteModal('@group.Id','@Html.Raw(Html.Encode(group.Name))')"
                                aria-label="حذف المجموعة @group.Name"
                                title="حذف المجموعة">
                            <i class="fas fa-trash-can" aria-hidden="true"></i>
                        </button>
                    </div>
                </article>
            }
        </div>
    </section>

    <div id="noGroupSearchResult" class="card empty-state group-empty-state d-none" role="status">
        <div class="empty-state__icon"><i class="fas fa-magnifying-glass" aria-hidden="true"></i></div>
        <h2 class="empty-state__title">لا توجد مجموعة مطابقة</h2>
        <p class="empty-state__message">جرّب جزءًا من اسم المجموعة أو اسم السنة الدراسية.</p>
        <button type="button" class="btn btn-neutral" onclick="clearGroupSearch()">مسح البحث</button>
    </div>
}
else
{
    <div class="card empty-state group-empty-state">
        <div class="empty-state__icon"><i class="fas fa-layer-group" aria-hidden="true"></i></div>
        <h2 class="empty-state__title">لا توجد مجموعات بعد</h2>
        <p class="empty-state__message">ابدأ من السنة الدراسية المطلوبة ثم أضف أول مجموعة وجدولها.</p>
        <a asp-controller="AcadimicYear" asp-action="Index" class="btn btn-primary btn-lg empty-state__action">
            <i class="fas fa-graduation-cap" aria-hidden="true"></i> السنوات الدراسية
        </a>
    </div>
}

<div class="modal" id="deleteGroupModal" role="dialog" aria-modal="true" aria-labelledby="deleteGroupTitle">
    <div class="modal__backdrop" onclick="closeModal('deleteGroupModal')"></div>
    <div class="modal__content">
        <div class="modal__header">
            <span class="group-delete-modal__icon"><i class="fas fa-users-slash" aria-hidden="true"></i></span>
            <h2 class="modal__title" id="deleteGroupTitle">تأكيد حذف المجموعة</h2>
            <button type="button" class="modal__close" onclick="closeModal('deleteGroupModal')" aria-label="إغلاق نافذة الحذف">
                <i class="fas fa-xmark" aria-hidden="true"></i>
            </button>
        </div>
        <div class="modal__body group-delete-modal__body">
            <p>أنت على وشك حذف المجموعة:</p>
            <strong id="deleteGroupName"></strong>
            <p class="group-delete-modal__warning"><i class="fas fa-triangle-exclamation" aria-hidden="true"></i> لا يمكن التراجع عن هذا الإجراء.</p>
        </div>
        <div class="modal__footer">
            <button type="button" class="btn btn-neutral" onclick="closeModal('deleteGroupModal')">إلغاء</button>
            <a id="deleteGroupConfirmLink" href="#" class="btn btn-danger"><i class="fas fa-trash-can" aria-hidden="true"></i> متابعة الحذف</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
function openDeleteModal(id, name) {
    document.getElementById('deleteGroupName').textContent = name;
    document.getElementById('deleteGroupConfirmLink').href = '/Group/Delete/' + id;
    openModal('deleteGroupModal');
}

function filterGroups(query) {
    const normalized = (query || '').trim().toLowerCase();
    const cards = document.querySelectorAll('[data-group-card]');
    const meta = document.getElementById('groupSearchMeta');
    const empty = document.getElementById('noGroupSearchResult');
    let visibleCount = 0;

    cards.forEach(function (card) {
        const searchable = (card.dataset.name || '') + ' ' + (card.dataset.year || '');
        const matches = !normalized || searchable.includes(normalized);
        card.classList.toggle('group-search-hidden', !matches);
        if (matches) visibleCount++;
    });

    meta.textContent = normalized ? 'تم العثور على ' + visibleCount + ' مجموعة' : cards.length + ' مجموعة متاحة';
    empty.classList.toggle('d-none', visibleCount > 0 || !normalized);
}

function clearGroupSearch() {
    const input = document.getElementById('groupSearch');
    if (!input) return;
    input.value = '';
    filterGroups('');
    input.focus();
}

document.getElementById('groupSearch')?.addEventListener('keydown', function (event) {
    if (event.key === 'Escape' && this.value) clearGroupSearch();
});
</script>
}
