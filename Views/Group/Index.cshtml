@model IEnumerable<Center_Management.Models.Group>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">إضافة مجموعة</a>
</p>
<table class="table table-hover table-bordered">
    <thead>
        <tr>
           
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AcademicYear.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Schedules)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>

                <td>@item.AcademicYear?.Name</td>

                <td>

                    @foreach (var schedule in item.Schedules)
                    {
                        <div>
                            @schedule.Day - @schedule.StartTime
                        </div>
                    }

                </td>
                <partial name="ButtonsPartialView" model="item.Id" />

            </tr>
        }
    </tbody>
</table>
