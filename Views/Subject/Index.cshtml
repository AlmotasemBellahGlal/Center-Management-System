@model IEnumerable<Center_Management.Models.Subject>

@{
    ViewData["Title"] = "Index";
}

<h1>قائمة المواد</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">إضافة مادة جديدة</a>
</p>
<table class="table table-hover table-bordered">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
                <partial name="ButtonsPartialView" model="item.Id" />
        </tr>
}
    </tbody>
</table>
