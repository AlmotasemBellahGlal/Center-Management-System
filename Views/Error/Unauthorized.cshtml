@{
    ViewData["Title"] = "غير مصرح بالدخول";
}
<div class="ve-wrap">
    <div class="ve-icon ve-icon--red"><i class="fas fa-ban"></i></div>
    <h1 class="ve-title">غير مصرح بالدخول</h1>
    <p class="ve-text">ليس لديك صلاحية للوصول إلى هذه الصفحة. تواصل مع المسؤول إذا كنت تعتقد أن هذا خطأ.</p>
    <div class="ve-actions">
        <a href="@Url.Action("Index","Dashboard")" class="ve-btn ve-btn--primary"><i class="fas fa-home"></i> الرئيسية</a>
        <a href="javascript:history.back()" class="ve-btn ve-btn--ghost"><i class="fas fa-arrow-right"></i> رجوع</a>
    </div>
</div>
@section Scripts {
<style>
.ve-wrap { max-width:480px;margin:4rem auto;text-align:center;padding:0 1rem; }
.ve-icon { font-size:4rem;margin-bottom:1.25rem; }
.ve-icon--red { color:var(--danger); }
.ve-title { font-size:1.4rem;font-weight:700;color:var(--text-primary);margin:0 0 .75rem; }
.ve-text { font-size:.875rem;color:var(--text-muted);margin:0 0 2rem;line-height:1.7; }
.ve-actions { display:flex;justify-content:center;gap:.75rem;flex-wrap:wrap; }
.ve-btn { display:inline-flex;align-items:center;gap:.4rem;padding:.5rem 1.25rem;border-radius:.6rem;font-size:.875rem;font-weight:600;cursor:pointer;border:none;text-decoration:none;transition:.14s; }
.ve-btn--primary { background:var(--primary);color:#fff; } .ve-btn--primary:hover { background:var(--primary-hover); }
.ve-btn--ghost   { background:var(--gray-100);color:var(--text-secondary);border:1px solid var(--border); } .ve-btn--ghost:hover { background:var(--gray-150); }
</style>
}
