@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div style="max-width: 600px; margin: var(--spacing-xl) auto; padding: var(--spacing);">
    <div class="card">
        <div class="card__header card__header--danger">
            <h4 class="card__title">
                <i class="fas fa-exclamation-triangle"></i>
                Error Occurred
            </h4>
        </div>
        <div class="card__body" style="text-align: center;">
            <div style="margin: var(--spacing-md) 0;">
                <i class="fas fa-bug" style="font-size: 5rem; color: var(--danger-color); opacity: 0.3;"></i>
            </div>
            
            <h5 style="color: var(--danger-color); margin: 0 0 var(--spacing); font-size: var(--text-xl); font-weight: var(--font-semibold);">
                An error occurred while processing your request
            </h5>
            
            @if (Model.ShowRequestId)
            {
                <div style="background: var(--gray-100); padding: var(--spacing); border-radius: var(--radius); margin: var(--spacing) 0;">
                    <p style="margin: 0; font-size: var(--text-sm); color: var(--text-secondary);">
                        <strong>Request ID:</strong> <code style="color: var(--text-primary); background: var(--white); padding: var(--spacing-xs); border-radius: var(--radius-sm);">@Model.RequestId</code>
                    </p>
                </div>
            }

            <div style="background: var(--warning-light); border: 1px solid var(--warning-color); border-radius: var(--radius); padding: var(--spacing); margin: var(--spacing-md) 0; text-align: left;">
                <h6 style="margin: 0 0 var(--spacing-sm); color: var(--warning-hover); display: flex; align-items: center; gap: var(--spacing-xs);">
                    <i class="fas fa-info-circle"></i>
                    <span>Development Mode</span>
                </h6>
                <p style="margin: 0 0 var(--spacing-sm); font-size: var(--text-sm); color: var(--text-primary); line-height: 1.6;">
                    Swapping to <strong>Development</strong> environment will display more detailed information about the error that occurred.
                </p>
                <p style="margin: 0; font-size: var(--text-sm); color: var(--text-secondary); line-height: 1.6;">
                    <strong>The Development environment shouldn't be enabled for deployed applications.</strong>
                    It can result in displaying sensitive information from exceptions to end users.
                </p>
            </div>

            <div style="display: flex; gap: var(--spacing-sm); justify-content: center; margin-top: var(--spacing-md);">
                <a href="@Url.Action("Index", "Dashboard")" class="btn btn--primary">
                    <i class="fas fa-home"></i>
                    <span>Go to Dashboard</span>
                </a>
                
                <a href="javascript:history.back()" class="btn btn--secondary">
                    <i class="fas fa-arrow-left"></i>
                    <span>Go Back</span>
                </a>
            </div>
        </div>
    </div>
</div>
