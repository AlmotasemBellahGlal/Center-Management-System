@{
    ViewData["Title"] = "مرحباً بك";
    Layout = null;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>إدارة المركز التعليمي</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body { margin: 0; background: var(--bg-app); font-family: var(--font); color: var(--text-primary); }

        /* ── Hero ── */
        .h-hero {
            background: var(--primary);
            padding: 5rem 2rem 4rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .h-hero::before, .h-hero::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            background: rgba(255,255,255,.04);
        }
        .h-hero::before { width:500px;height:500px;top:-200px;right:-150px; }
        .h-hero::after  { width:300px;height:300px;bottom:-100px;left:-80px; }
        .h-hero__badge {
            display: inline-flex;align-items:center;gap:.4rem;
            background:rgba(255,255,255,.15);color:rgba(255,255,255,.9);
            border-radius:2rem;padding:.3rem .9rem;font-size:.8rem;font-weight:600;
            margin-bottom:1.25rem;border:1px solid rgba(255,255,255,.2);
        }
        .h-hero__title { font-size:clamp(1.75rem,5vw,3rem);font-weight:800;color:#fff;margin:0 0 1rem;line-height:1.2;position:relative;z-index:1; }
        .h-hero__title span { color:rgba(255,255,255,.75); }
        .h-hero__sub { font-size:1.0625rem;color:rgba(255,255,255,.75);max-width:560px;margin:0 auto 2.5rem;line-height:1.7;position:relative;z-index:1; }
        .h-hero__btns { display:flex;gap:1rem;justify-content:center;flex-wrap:wrap;position:relative;z-index:1; }
        .h-btn {
            display:inline-flex;align-items:center;gap:.5rem;
            padding:.65rem 1.5rem;border-radius:.65rem;font-size:.9375rem;font-weight:700;
            cursor:pointer;text-decoration:none;transition:.16s;border:none;
        }
        .h-btn--solid  { background:#fff;color:var(--primary); }
        .h-btn--solid:hover  { background:rgba(255,255,255,.9);transform:translateY(-2px);box-shadow:0 6px 16px rgba(0,0,0,.15); }
        .h-btn--outline { background:rgba(255,255,255,.1);color:#fff;border:1.5px solid rgba(255,255,255,.35); }
        .h-btn--outline:hover { background:rgba(255,255,255,.2); }

        /* ── Features ── */
        .h-features { max-width:1100px;margin:0 auto;padding:4rem 1.5rem; }
        .h-features__title { text-align:center;font-size:1.6rem;font-weight:700;margin:0 0 .75rem; }
        .h-features__sub { text-align:center;font-size:.9375rem;color:var(--text-muted);margin:0 0 3rem; }
        .h-grid { display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:1.5rem; }
        .h-feat {
            background:var(--bg-card);border:1px solid var(--border-light);border-radius:1rem;
            padding:1.75rem;transition:box-shadow .18s,transform .18s;
        }
        .h-feat:hover { box-shadow:0 6px 20px rgba(30,26,20,.08);transform:translateY(-4px); }
        .h-feat__icon {
            width:52px;height:52px;border-radius:.75rem;
            display:flex;align-items:center;justify-content:center;
            font-size:1.2rem;margin-bottom:1.1rem;
        }
        .h-feat__title { font-size:1rem;font-weight:700;margin:0 0 .5rem; }
        .h-feat__desc  { font-size:.875rem;color:var(--text-muted);margin:0;line-height:1.65; }

        /* ── CTA strip ── */
        .h-cta {
            background:var(--primary);text-align:center;padding:3.5rem 1.5rem;margin-top:1rem;
        }
        .h-cta__title { font-size:1.5rem;font-weight:700;color:#fff;margin:0 0 1rem; }
        .h-cta__btns { display:flex;gap:1rem;justify-content:center;flex-wrap:wrap; }

        @@media (max-width:640px) {
            .h-hero { padding:3.5rem 1.25rem 3rem; }
            .h-hero__sub { font-size:.9375rem; }
        }
    </style>
</head>
<body>
    <div class="h-hero">
        <div class="h-hero__badge"><i class="fas fa-graduation-cap"></i> نظام إدارة المركز التعليمي</div>
        <h1 class="h-hero__title">منصة تعليمية <span>متكاملة</span><br>لإدارة مركزك</h1>
        <p class="h-hero__sub">إدارة الطلاب، المجموعات، الحضور، المدفوعات، والاختبارات الإلكترونية — كل شيء في مكان واحد.</p>
        <div class="h-hero__btns">
            <a href="@Url.Action("Login","Account")" class="h-btn h-btn--solid">
                <i class="fas fa-sign-in-alt"></i> تسجيل الدخول
            </a>
            <a href="@Url.Action("StudentRegister","Account")" class="h-btn h-btn--outline">
                <i class="fas fa-user-graduate"></i> تسجيل كطالب
            </a>
        </div>
    </div>

    <div class="h-features">
        <h2 class="h-features__title">كل ما يحتاجه مركزك التعليمي</h2>
        <p class="h-features__sub">أدوات احترافية لإدارة جميع جوانب المركز بكفاءة وسهولة</p>
        <div class="h-grid">
            <div class="h-feat">
                <div class="h-feat__icon" style="background:var(--primary-50);color:var(--primary)"><i class="fas fa-users"></i></div>
                <h3 class="h-feat__title">إدارة الطلاب</h3>
                <p class="h-feat__desc">تسجيل وإدارة بيانات الطلاب وتوزيعهم على المجموعات الدراسية بسهولة.</p>
            </div>
            <div class="h-feat">
                <div class="h-feat__icon" style="background:var(--success-50);color:var(--success)"><i class="fas fa-clipboard-check"></i></div>
                <h3 class="h-feat__title">تسجيل الحضور</h3>
                <p class="h-feat__desc">تسجيل حضور الطلاب لكل جلسة وعرض تقارير الحضور التفصيلية.</p>
            </div>
            <div class="h-feat">
                <div class="h-feat__icon" style="background:var(--warning-50);color:var(--warning)"><i class="fas fa-money-bill-wave"></i></div>
                <h3 class="h-feat__title">متابعة المدفوعات</h3>
                <p class="h-feat__desc">تتبع دفعات الطلاب الشهرية وعرض حالة كل طالب مالياً بوضوح.</p>
            </div>
            <div class="h-feat">
                <div class="h-feat__icon" style="background:var(--gold-50);color:var(--gold)"><i class="fas fa-file-alt"></i></div>
                <h3 class="h-feat__title">الاختبارات الإلكترونية</h3>
                <p class="h-feat__desc">إنشاء وإدارة اختبارات MCQ ومقالية مع عد تنازلي وتصحيح تلقائي.</p>
            </div>
            <div class="h-feat">
                <div class="h-feat__icon" style="background:var(--info-50);color:var(--info)"><i class="fas fa-folder-open"></i></div>
                <h3 class="h-feat__title">المواد التعليمية</h3>
                <p class="h-feat__desc">رفع ومشاركة ملفات PDF والفيديوهات مع الطلاب مباشرة من المنصة.</p>
            </div>
            <div class="h-feat">
                <div class="h-feat__icon" style="background:var(--danger-50);color:var(--danger)"><i class="fas fa-chart-bar"></i></div>
                <h3 class="h-feat__title">تقارير وإحصائيات</h3>
                <p class="h-feat__desc">لوحة تحكم شاملة مع إحصائيات النمو والإيرادات ونسب الحضور.</p>
            </div>
        </div>
    </div>

    <div class="h-cta">
        <h2 class="h-cta__title">جاهز للبدء؟</h2>
        <div class="h-cta__btns">
            <a href="@Url.Action("Login","Account")" class="h-btn h-btn--solid">
                <i class="fas fa-sign-in-alt"></i> تسجيل الدخول
            </a>
            <a href="@Url.Action("Register","Account")" class="h-btn h-btn--outline">
                <i class="fas fa-user-plus"></i> إنشاء حساب معلم
            </a>
        </div>
    </div>
</body>
</html>
