@model Center_Management.View_Models.GroupSessionVM
@{
    ViewData["Title"] = "جلسة " + Model.GroupName;

    string[] arabicMonths = {
        "يناير","فبراير","مارس","إبريل","مايو","يونيو",
        "يوليو","أغسطس","سبتمبر","أكتوبر","نوفمبر","ديسمبر"
    };
    string monthName = arabicMonths[Model.Month - 1];

    int presentCount = Model.Students.Count(s => s.IsPresent == true);
    int absentCount  = Model.Students.Count(s => s.IsPresent == false);
    int paidCount    = Model.Students.Count(s => s.IsPaid);
    int unpaidCount  = Model.Students.Count(s => !s.IsPaid);
    int total        = Model.Students.Count;
}

@* ── Back + Page Header ── *@
<div class="sess-header">
    <div class="sess-header__top">
        <a href="javascript:history.back()" class="btn btn--outline-primary btn--sm">
            <i class="fas fa-arrow-right"></i>
            رجوع
        </a>
        <div class="sess-header__breadcrumb">
            <span>@Model.SubjectName</span>
            <i class="fas fa-chevron-left sess-bc-sep"></i>
            <span>@Model.AcademicYearName</span>
            <i class="fas fa-chevron-left sess-bc-sep"></i>
            <span class="sess-bc-current">@Model.GroupName</span>
        </div>
    </div>

    <div class="sess-header__main">
        <div class="sess-header__icon">
            <i class="fas fa-clipboard-list"></i>
        </div>
        <div class="sess-header__info">
            <h1 class="sess-header__title">@Model.GroupName</h1>
            <div class="sess-header__meta">
                <span><i class="fas fa-calendar-day"></i> @Model.SessionDate.ToString("dd/MM/yyyy")</span>
                <span class="sess-meta-sep">·</span>
                <span><i class="fas fa-credit-card"></i> @monthName @Model.Year</span>
                @if (Model.MonthlyPrice > 0)
                {
                    <span class="sess-meta-sep">·</span>
                    <span><i class="fas fa-tag"></i> @Model.MonthlyPrice.ToString("N0") ج.م</span>
                }
            </div>
        </div>

        @* Date / Month pickers *@
        <form method="get" class="sess-header__filters" id="filterForm">
            <input type="hidden" name="groupId" value="@Model.GroupId" />
            <div class="sess-filter">
                <label class="sess-filter__label"><i class="fas fa-calendar-alt"></i> تاريخ الحضور</label>
                <input type="date" name="date" class="form-input sess-filter__input"
                       value="@Model.SessionDate.ToString("yyyy-MM-dd")"
                       onchange="document.getElementById('filterForm').submit()" />
            </div>
            <div class="sess-filter">
                <label class="sess-filter__label"><i class="fas fa-money-bill-wave"></i> شهر الدفع</label>
                <div class="sess-filter__row">
                    <select name="month" class="form-select sess-filter__select"
                            onchange="document.getElementById('filterForm').submit()">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m" selected="@(m == Model.Month ? "selected" : null)">@arabicMonths[m - 1]</option>
                        }
                    </select>
                    <select name="year" class="form-select sess-filter__select"
                            onchange="document.getElementById('filterForm').submit()">
                        @for (int y = DateTime.Now.Year - 1; y <= DateTime.Now.Year + 1; y++)
                        {
                            <option value="@y" selected="@(y == Model.Year ? "selected" : null)">@y</option>
                        }
                    </select>
                </div>
            </div>
        </form>
    </div>
</div>

@* ── Summary Stats ── *@
<div class="sess-stats">
    <div class="sess-stat sess-stat--present">
        <div class="sess-stat__val" id="statPresent">@presentCount</div>
        <div class="sess-stat__lbl"><i class="fas fa-user-check"></i> حضر</div>
    </div>
    <div class="sess-stat sess-stat--absent">
        <div class="sess-stat__val" id="statAbsent">@absentCount</div>
        <div class="sess-stat__lbl"><i class="fas fa-user-times"></i> غاب</div>
    </div>
    <div class="sess-stat sess-stat--unmark">
        <div class="sess-stat__val" id="statUnmark">@Model.Students.Count(s => s.IsPresent == null)</div>
        <div class="sess-stat__lbl"><i class="fas fa-user-clock"></i> لم يُسجَّل</div>
    </div>
    <div class="sess-stat sess-stat--paid">
        <div class="sess-stat__val" id="statPaid">@paidCount</div>
        <div class="sess-stat__lbl"><i class="fas fa-check-circle"></i> دفع</div>
    </div>
    <div class="sess-stat sess-stat--unpaid">
        <div class="sess-stat__val" id="statUnpaid">@unpaidCount</div>
        <div class="sess-stat__lbl"><i class="fas fa-times-circle"></i> لم يدفع</div>
    </div>
    <div class="sess-stat sess-stat--total">
        <div class="sess-stat__val">@total</div>
        <div class="sess-stat__lbl"><i class="fas fa-users"></i> إجمالي</div>
    </div>
</div>

@* ── Quick-action toolbar ── *@
<div class="sess-toolbar">
    <div class="sess-toolbar__left">
        <button class="btn btn--sm btn--success" onclick="markAllAttendance(true)">
            <i class="fas fa-check-double"></i> حضر الكل
        </button>
        <button class="btn btn--sm btn--danger" onclick="markAllAttendance(false)">
            <i class="fas fa-times"></i> غياب الكل
        </button>
        <button class="btn btn--sm btn--outline-success" onclick="markAllPayment(true)">
            <i class="fas fa-dollar-sign"></i> دفع الكل
        </button>
        <button class="btn btn--sm btn--outline-danger" onclick="markAllPayment(false)">
            <i class="fas fa-ban"></i> إلغاء دفع الكل
        </button>
    </div>
    <div class="sess-toolbar__right">
        <div id="saveStatus" class="sess-save-status" style="display:none">
            <i class="fas fa-spinner fa-spin"></i> جارٍ الحفظ...
        </div>
    </div>
</div>

@* ── Empty state ── *@
@if (!Model.Students.Any())
{
    <div class="card"><div class="card__body">
        <div class="empty-state">
            <div class="empty-state__icon"><i class="fas fa-users-slash fa-3x"></i></div>
            <h3 class="empty-state__title">لا يوجد طلاب نشطون</h3>
            <p class="empty-state__message">لا يوجد طلاب مسجلون بشكل نشط في هذه المجموعة</p>
        </div>
    </div></div>
}
else
{
    @* ── Student Grid ── *@
    <div class="sess-grid" id="studentGrid">
        @{ int cardNum = 1; }
        @foreach (var student in Model.Students)
        {
            string attState = student.IsPresent == true ? "present"
                            : student.IsPresent == false ? "absent"
                            : "none";
            string payState = student.IsPaid ? "paid" : "unpaid";

            <div class="sess-card @(attState == "none" ? "sess-card--unset" : (attState == "present" ? "sess-card--present" : "sess-card--absent"))"
                 id="card-@student.StudentId"
                 data-student-id="@student.StudentId"
                 data-name="@student.FullName.ToLower()">

                @* Card top: avatar + name + number ── *@
                <div class="sess-card__top">
                    <div class="sess-card__num">@cardNum</div>
                    <div class="sess-card__avatar sess-avatar--@(attState == "present" ? "green" : attState == "absent" ? "red" : "gray")"
                         id="avatar-@student.StudentId">
                        @student.FullName[0]
                    </div>
                    <div class="sess-card__info">
                        <div class="sess-card__name">@student.FullName</div>
                        <div class="sess-card__att-label" id="attLabel-@student.StudentId">
                            @if (attState == "present")
                            {
                                <span class="sess-badge sess-badge--present"><i class="fas fa-check"></i> حضر</span>
                            }
                            else if (attState == "absent")
                            {
                                <span class="sess-badge sess-badge--absent"><i class="fas fa-times"></i> غاب</span>
                            }
                            else
                            {
                                <span class="sess-badge sess-badge--none"><i class="fas fa-minus"></i> لم يُسجَّل</span>
                            }
                        </div>
                    </div>
                </div>

                @* ── Attendance Buttons ── *@
                <div class="sess-card__section">
                    <div class="sess-card__section-label">
                        <i class="fas fa-calendar-check"></i>
                        الحضور — @Model.SessionDate.ToString("dd/MM/yyyy")
                    </div>
                    <div class="sess-card__att-btns">
                        <button class="sess-att-btn sess-att-btn--present @(attState == "present" ? "active" : "")"
                                id="btnPresent-@student.StudentId"
                                onclick="setAttendance(@student.StudentId, true)"
                                title="حضر">
                            <i class="fas fa-user-check"></i>
                            <span>حضر</span>
                        </button>
                        <button class="sess-att-btn sess-att-btn--absent @(attState == "absent" ? "active" : "")"
                                id="btnAbsent-@student.StudentId"
                                onclick="setAttendance(@student.StudentId, false)"
                                title="غاب">
                            <i class="fas fa-user-times"></i>
                            <span>غاب</span>
                        </button>
                    </div>
                </div>

                @* ── Payment Toggle ── *@
                <div class="sess-card__section">
                    <div class="sess-card__section-label">
                        <i class="fas fa-money-bill-wave"></i>
                        دفعة @monthName @Model.Year
                        @if (student.MonthlyPrice > 0)
                        {
                            <span class="sess-price">@student.MonthlyPrice.ToString("N0") ج.م</span>
                        }
                    </div>
                    <button class="sess-pay-btn @(payState == "paid" ? "sess-pay-btn--paid" : "sess-pay-btn--unpaid")"
                            id="btnPay-@student.StudentId"
                            onclick="togglePayment(@student.StudentId)"
                            title="@(student.IsPaid ? "إلغاء الدفع" : "تسجيل الدفع")">
                        <i class="fas @(student.IsPaid ? "fa-check-circle" : "fa-times-circle")" id="payIcon-@student.StudentId"></i>
                        <span id="payLabel-@student.StudentId">@(student.IsPaid ? "تم الدفع" : "لم يدفع")</span>
                    </button>
                </div>

                @* Spinner overlay ── *@
                <div class="sess-card__overlay" id="overlay-@student.StudentId" style="display:none">
                    <i class="fas fa-spinner fa-spin"></i>
                </div>
            </div>

            cardNum++;
        }
    </div>

    @* ── Search filter for cards ── *@
    <div class="sess-search-wrap">
        <i class="fas fa-search"></i>
        <input type="text" class="sess-search-input" placeholder="ابحث عن طالب..."
               oninput="filterCards(this.value)" />
    </div>
}

@* ── Toast container ── *@
<div id="sessToastContainer" class="sess-toast-container"></div>

@section Scripts {
<style>
/* ═══════════════════════════════════════════════════════
   Session Page — Scoped Styles
   ═══════════════════════════════════════════════════════ */

/* ── Header ── */
.sess-header {
    margin-bottom: var(--spacing-lg);
}
.sess-header__top {
    display: flex; align-items: center; gap: var(--spacing-sm);
    margin-bottom: var(--spacing);
    flex-wrap: wrap;
}
.sess-header__breadcrumb {
    display: flex; align-items: center; gap: 6px;
    font-size: var(--text-sm); color: var(--text-secondary);
}
.sess-bc-sep { font-size: .6rem; color: var(--text-muted); }
.sess-bc-current { color: var(--primary-color); font-weight: var(--font-semibold); }

.sess-header__main {
    display: flex; align-items: flex-start; gap: var(--spacing);
    padding: var(--spacing-md);
    background: var(--primary-color);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    color: #fff;
    flex-wrap: wrap;
}
.sess-header__icon {
    width: 56px; height: 56px; flex-shrink: 0;
    border-radius: var(--radius-md);
    background: rgba(255,255,255,.18);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.8rem;
}
.sess-header__info { flex: 1; min-width: 160px; }
.sess-header__title { font-size: var(--text-2xl); font-weight: var(--font-bold); margin: 0 0 4px; }
.sess-header__meta { display: flex; align-items: center; gap: 6px; font-size: var(--text-sm); opacity: .9; flex-wrap: wrap; }
.sess-meta-sep { opacity: .5; }

/* Filters */
.sess-header__filters {
    display: flex; gap: var(--spacing); align-items: flex-end; flex-wrap: wrap; margin-inline-start: auto;
}
.sess-filter { display: flex; flex-direction: column; gap: 4px; }
.sess-filter__label { font-size: var(--text-xs); opacity: .85; white-space: nowrap; }
.sess-filter__input, .sess-filter__select {
    background: rgba(255,255,255,.15); color: #fff; border: 1px solid rgba(255,255,255,.3);
    border-radius: var(--radius); padding: 6px 10px; font-size: var(--text-sm);
    min-width: 130px;
}
.sess-filter__input::placeholder { color: rgba(255,255,255,.6); }
.sess-filter__row { display: flex; gap: var(--spacing-xs); }
.sess-filter__select option { background: var(--gray-800); color: #fff; }

/* ── Stats ── */
.sess-stats {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--spacing-sm);
    margin-bottom: var(--spacing);
}
@@media (max-width: 767px) { .sess-stats { grid-template-columns: repeat(3, 1fr); } }
@@media (max-width: 480px) { .sess-stats { grid-template-columns: repeat(2, 1fr); } }

.sess-stat {
    border-radius: var(--radius-md); padding: var(--spacing-sm) var(--spacing);
    text-align: center; box-shadow: var(--shadow-sm); transition: var(--transition);
    border: 2px solid transparent;
}
.sess-stat:hover { transform: translateY(-2px); box-shadow: var(--shadow-md); }
.sess-stat__val { font-size: var(--text-3xl); font-weight: var(--font-bold); line-height: 1; }
.sess-stat__lbl { font-size: var(--text-xs); margin-top: 4px; opacity: .85; }

.sess-stat--present { background: var(--success-light); color: var(--success-color); border-color: var(--success-color); }
.sess-stat--absent  { background: var(--danger-light); color: var(--danger-color); border-color: var(--danger-color); }
.sess-stat--unmark  { background: var(--gray-100); color: var(--text-secondary); border-color: var(--gray-300); }
.sess-stat--paid    { background: var(--primary-light); color: var(--primary-color); border-color: var(--primary-color); }
.sess-stat--unpaid  { background: var(--warning-light); color: var(--warning-color); border-color: var(--warning-color); }
.sess-stat--total   { background: var(--secondary-light); color: var(--secondary-color); border-color: var(--secondary-color); }

/* ── Toolbar ── */
.sess-toolbar {
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing);
    background: var(--bg-primary); border: 1px solid var(--border-color);
    border-radius: var(--radius-md); margin-bottom: var(--spacing);
    box-shadow: var(--shadow-sm);
}
.sess-toolbar__left  { display: flex; gap: var(--spacing-xs); flex-wrap: wrap; }
.sess-save-status    { font-size: var(--text-sm); color: var(--primary-color); display: flex; align-items: center; gap: 6px; }

/* ── Search ── */
.sess-search-wrap {
    display: flex; align-items: center; gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing);
    background: var(--bg-primary); border: 1px solid var(--border-color);
    border-radius: var(--radius-md); margin-top: var(--spacing);
    box-shadow: var(--shadow-sm); color: var(--text-muted);
}
.sess-search-input {
    flex: 1; border: none; outline: none; font-size: var(--text-base);
    background: transparent; color: var(--text-primary);
}

/* ── Student Grid ── */
.sess-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: var(--spacing);
}
@@media (max-width: 480px) { .sess-grid { grid-template-columns: 1fr; } }

/* ── Student Card ── */
.sess-card {
    position: relative;
    background: var(--bg-primary);
    border: 2px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--spacing);
    box-shadow: var(--shadow-md);
    transition: all .2s ease;
    overflow: hidden;
}
.sess-card:hover { box-shadow: var(--shadow-lg); transform: translateY(-2px); }
.sess-card--present { border-color: var(--success-color); background: var(--success-light); }
.sess-card--absent  { border-color: var(--danger-color); background: var(--danger-light); }
.sess-card--unset   { border-color: var(--border-color); }

/* Card accent bar */
.sess-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}
.sess-card--present::before { background: var(--success-color); }
.sess-card--absent::before  { background: var(--danger-color); }
.sess-card--unset::before   { background: var(--gray-300); }

/* Card top */
.sess-card__top { display: flex; align-items: center; gap: var(--spacing-sm); margin-bottom: var(--spacing-sm); }
.sess-card__num {
    width: 24px; height: 24px; border-radius: var(--radius-full);
    background: var(--gray-100); color: var(--text-muted);
    font-size: var(--text-xs); font-weight: var(--font-bold);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.sess-card__avatar {
    width: 42px; height: 42px; border-radius: var(--radius-full);
    display: flex; align-items: center; justify-content: center;
    font-size: var(--text-lg); font-weight: var(--font-bold); color: #fff; flex-shrink: 0;
    text-transform: uppercase; transition: var(--transition-fast);
    box-shadow: var(--shadow-sm);
}
.sess-avatar--green { background: var(--success-color); }
.sess-avatar--red   { background: var(--danger-color); }
.sess-avatar--gray  { background: var(--gray-400); }

.sess-card__info { flex: 1; min-width: 0; }
.sess-card__name { font-weight: var(--font-semibold); font-size: var(--text-base); color: var(--text-primary); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* Badges */
.sess-badge {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 2px 8px; border-radius: var(--radius-full);
    font-size: var(--text-xs); font-weight: var(--font-bold);
}
.sess-badge--present { background: var(--success-light); color: var(--success-color); }
.sess-badge--absent  { background: var(--danger-light); color: var(--danger-color); }
.sess-badge--none    { background: var(--gray-100); color: var(--text-secondary); }

/* Card section */
.sess-card__section {
    padding: var(--spacing-sm) 0;
    border-top: 1px solid var(--border-color);
    margin-top: var(--spacing-xs);
}
.sess-card__section-label {
    font-size: var(--text-xs); color: var(--text-secondary); margin-bottom: var(--spacing-xs);
    display: flex; align-items: center; gap: 4px;
}
.sess-price {
    margin-inline-start: auto; background: var(--primary-light);
    color: var(--primary-dark); padding: 2px 8px; border-radius: var(--radius-full);
    font-weight: var(--font-bold); font-size: var(--text-xs);
}

/* Attendance buttons */
.sess-card__att-btns { display: flex; gap: var(--spacing-xs); }
.sess-att-btn {
    flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px;
    padding: var(--spacing-sm); border-radius: var(--radius);
    border: 2px solid; cursor: pointer; font-size: var(--text-sm);
    font-weight: var(--font-semibold); transition: all .15s ease;
    background: transparent;
}
.sess-att-btn--present {
    color: var(--success-color); border-color: var(--success-color);
}
.sess-att-btn--present:hover, .sess-att-btn--present.active {
    background: var(--success-color); color: #fff; border-color: var(--success-color);
    box-shadow: var(--shadow-sm);
}
.sess-att-btn--absent {
    color: var(--danger-color); border-color: var(--danger-color);
}
.sess-att-btn--absent:hover, .sess-att-btn--absent.active {
    background: var(--danger-color); color: #fff; border-color: var(--danger-color);
    box-shadow: var(--shadow-sm);
}

/* Payment button */
.sess-pay-btn {
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;
    padding: var(--spacing-sm) var(--spacing); border-radius: var(--radius);
    border: 2px solid; cursor: pointer; font-size: var(--text-sm);
    font-weight: var(--font-semibold); transition: all .15s ease;
}
.sess-pay-btn--unpaid {
    background: var(--warning-light); color: var(--warning-color); border-color: var(--warning-color);
}
.sess-pay-btn--unpaid:hover {
    background: var(--warning-color); color: #fff; border-color: var(--warning-color);
    box-shadow: var(--shadow-sm);
}
.sess-pay-btn--paid {
    background: var(--success-light); color: var(--success-color); border-color: var(--success-color);
}
.sess-pay-btn--paid:hover {
    background: var(--danger-color); color: #fff; border-color: var(--danger-color);
    box-shadow: var(--shadow-sm);
}

/* Loading overlay on card */
.sess-card__overlay {
    position: absolute; inset: 0; background: rgba(255,255,255,.7);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.5rem; color: var(--primary-color);
    border-radius: var(--radius-lg); backdrop-filter: blur(2px);
}

/* ── Toast ── */
.sess-toast-container {
    position: fixed; bottom: var(--spacing); inset-inline-end: var(--spacing);
    z-index: var(--z-tooltip); display: flex; flex-direction: column; gap: var(--spacing-xs);
    pointer-events: none;
}
.sess-toast {
    display: flex; align-items: center; gap: var(--spacing-sm);
    padding: var(--spacing-sm) var(--spacing); border-radius: var(--radius);
    font-size: var(--text-sm); font-weight: var(--font-medium);
    box-shadow: var(--shadow-lg); pointer-events: auto;
    animation: sessSlideUp .25s ease;
    min-width: 220px; color: #fff;
}
@@keyframes sessSlideUp {
    from { opacity:0; transform: translateY(16px); }
    to   { opacity:1; transform: translateY(0); }
}
.sess-toast--success { background: var(--success-color); }
.sess-toast--error   { background: var(--danger-color); }
.sess-toast--info    { background: var(--info-color); }
</style>

<script>
const GROUP_ID    = @Model.GroupId;
const SESSION_DATE = '@Model.SessionDate.ToString("yyyy-MM-dd")';
const PAY_MONTH   = @Model.Month;
const PAY_YEAR    = @Model.Year;

// ── State tracking ───────────────────────────────────────────────
// Maps studentId → { isPresent: bool|null, isPaid: bool }
const state = {};
@foreach (var s in Model.Students)
{
    string present = s.IsPresent == null ? "null" : s.IsPresent.Value.ToString().ToLower();
    @:state[@s.StudentId] = { isPresent: @present, isPaid: @s.IsPaid.ToString().ToLower() };
}

// ── AJAX helper ──────────────────────────────────────────────────
async function apiPost(url, data) {
    const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    });
    return res.json();
}

// ── Show loading overlay on a card ───────────────────────────────
function showOverlay(studentId, show) {
    const el = document.getElementById('overlay-' + studentId);
    if (el) el.style.display = show ? 'flex' : 'none';
}

// ── Update a single card's visual state ──────────────────────────
function updateCardUI(studentId) {
    const s      = state[studentId];
    const card   = document.getElementById('card-' + studentId);
    const avatar = document.getElementById('avatar-' + studentId);
    const attLbl = document.getElementById('attLabel-' + studentId);
    const btnP   = document.getElementById('btnPresent-' + studentId);
    const btnA   = document.getElementById('btnAbsent-'  + studentId);
    const btnPay = document.getElementById('btnPay-'     + studentId);
    const payIco = document.getElementById('payIcon-'    + studentId);
    const payLbl = document.getElementById('payLabel-'   + studentId);

    // Card class
    card.classList.remove('sess-card--present','sess-card--absent','sess-card--unset');
    if (s.isPresent === true)       card.classList.add('sess-card--present');
    else if (s.isPresent === false) card.classList.add('sess-card--absent');
    else                            card.classList.add('sess-card--unset');

    // Avatar colour
    avatar.classList.remove('sess-avatar--green','sess-avatar--red','sess-avatar--gray');
    if (s.isPresent === true)       avatar.classList.add('sess-avatar--green');
    else if (s.isPresent === false) avatar.classList.add('sess-avatar--red');
    else                            avatar.classList.add('sess-avatar--gray');

    // Attendance label
    if (s.isPresent === true)
        attLbl.innerHTML = '<span class="sess-badge sess-badge--present"><i class="fas fa-check"></i> حضر</span>';
    else if (s.isPresent === false)
        attLbl.innerHTML = '<span class="sess-badge sess-badge--absent"><i class="fas fa-times"></i> غاب</span>';
    else
        attLbl.innerHTML = '<span class="sess-badge sess-badge--none"><i class="fas fa-minus"></i> لم يُسجَّل</span>';

    // Attendance button active states
    btnP.classList.toggle('active', s.isPresent === true);
    btnA.classList.toggle('active', s.isPresent === false);

    // Payment button
    btnPay.classList.toggle('sess-pay-btn--paid',   s.isPaid);
    btnPay.classList.toggle('sess-pay-btn--unpaid', !s.isPaid);
    payIco.className = 'fas ' + (s.isPaid ? 'fa-check-circle' : 'fa-times-circle');
    payLbl.textContent = s.isPaid ? 'تم الدفع' : 'لم يدفع';
    btnPay.title = s.isPaid ? 'اضغط لإلغاء الدفع' : 'اضغط لتسجيل الدفع';

    // Update stats
    updateStats();
}

// ── Update summary counters ───────────────────────────────────────
function updateStats() {
    const vals = Object.values(state);
    document.getElementById('statPresent').textContent = vals.filter(v => v.isPresent === true).length;
    document.getElementById('statAbsent' ).textContent = vals.filter(v => v.isPresent === false).length;
    document.getElementById('statUnmark' ).textContent = vals.filter(v => v.isPresent === null).length;
    document.getElementById('statPaid'   ).textContent = vals.filter(v => v.isPaid).length;
    document.getElementById('statUnpaid' ).textContent = vals.filter(v => !v.isPaid).length;
}

// ── Set attendance for one student ───────────────────────────────
async function setAttendance(studentId, isPresent) {
    // Optimistic UI
    state[studentId].isPresent = isPresent;
    updateCardUI(studentId);
    showOverlay(studentId, true);

    try {
        const res = await apiPost('/Session/ToggleAttendance', {
            studentId,
            groupId  : GROUP_ID,
            date     : SESSION_DATE,
            isPresent
        });

        if (!res.success) {
            // Revert
            state[studentId].isPresent = !isPresent;
            updateCardUI(studentId);
            showToast(res.message || 'حدث خطأ', 'error');
        } else {
            showToast(isPresent ? '✓ تم تسجيل الحضور' : '✗ تم تسجيل الغياب',
                      isPresent ? 'success' : 'error', 2000);
        }
    } catch {
        state[studentId].isPresent = !isPresent;
        updateCardUI(studentId);
        showToast('خطأ في الاتصال', 'error');
    } finally {
        showOverlay(studentId, false);
    }
}

// ── Toggle payment for one student ───────────────────────────────
async function togglePayment(studentId) {
    const markPaid = !state[studentId].isPaid;

    // Optimistic UI
    state[studentId].isPaid = markPaid;
    updateCardUI(studentId);
    showOverlay(studentId, true);

    try {
        const res = await apiPost('/Session/TogglePayment', {
            studentId,
            groupId : GROUP_ID,
            month   : PAY_MONTH,
            year    : PAY_YEAR,
            markPaid
        });

        if (!res.success) {
            state[studentId].isPaid = !markPaid;
            updateCardUI(studentId);
            showToast(res.message || 'حدث خطأ', 'error');
        } else {
            showToast(markPaid ? '💰 تم تسجيل الدفع' : 'تم إلغاء الدفع',
                      markPaid ? 'success' : 'info', 2000);
        }
    } catch {
        state[studentId].isPaid = !markPaid;
        updateCardUI(studentId);
        showToast('خطأ في الاتصال', 'error');
    } finally {
        showOverlay(studentId, false);
    }
}

// ── Bulk: mark all attendance ─────────────────────────────────────
async function markAllAttendance(isPresent) {
    const ids = Object.keys(state).map(Number);

    // Optimistic
    ids.forEach(id => { state[id].isPresent = isPresent; updateCardUI(id); });

    try {
        const res = await apiPost('/Session/SaveAllAttendance', {
            groupId : GROUP_ID,
            date    : SESSION_DATE,
            records : ids.map(id => ({ studentId: id, isPresent }))
        });
        if (res.success) {
            showToast(isPresent ? '✓ تم تسجيل حضور جميع الطلاب' : '✗ تم تسجيل غياب جميع الطلاب',
                      isPresent ? 'success' : 'error', 3000);
        }
    } catch {
        showToast('خطأ في الاتصال', 'error');
    }
}

// ── Bulk: mark all payment ────────────────────────────────────────
async function markAllPayment(markPaid) {
    const ids = Object.keys(state).map(Number);
    for (const id of ids) {
        if (state[id].isPaid === markPaid) continue; // skip if already in desired state
        state[id].isPaid = markPaid;
        updateCardUI(id);
        await apiPost('/Session/TogglePayment', {
            studentId: id, groupId: GROUP_ID,
            month: PAY_MONTH, year: PAY_YEAR, markPaid
        });
    }
    showToast(markPaid ? '💰 تم تسجيل دفع جميع الطلاب' : 'تم إلغاء دفع جميع الطلاب',
              markPaid ? 'success' : 'info', 3000);
}

// ── Card search filter ────────────────────────────────────────────
function filterCards(q) {
    q = q.toLowerCase().trim();
    document.querySelectorAll('.sess-card').forEach(card => {
        const name = card.dataset.name || '';
        card.style.display = (!q || name.includes(q)) ? '' : 'none';
    });
}

// ── Toast helper ─────────────────────────────────────────────────
function showToast(msg, type = 'info', duration = 3000) {
    const container = document.getElementById('sessToastContainer');
    const toast = document.createElement('div');
    toast.className = `sess-toast sess-toast--${type}`;
    toast.innerHTML = `<i class="fas ${type === 'success' ? 'fa-check-circle' : type === 'error' ? 'fa-times-circle' : 'fa-info-circle'}"></i> ${msg}`;
    container.appendChild(toast);
    setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transition = 'opacity .3s';
        setTimeout(() => toast.remove(), 300);
    }, duration);
}
</script>
}
